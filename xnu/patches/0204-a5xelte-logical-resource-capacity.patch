+/* Bounded logical handles, independent of the four GPU mapping windows. */
+#ifndef A5XELTE_GPU_RESOURCE_SLOTS_H
+#define A5XELTE_GPU_RESOURCE_SLOTS_H
+#include <stdint.h>
+enum { kA5GPULogicalSurfaceCapacity=128, kA5GPUPhysicalSurfaceSlots=4 };
+struct A5GPUProtectedResources {
+    uint32_t indices[kA5GPUPhysicalSurfaceSlots];
+    uint32_t count;
+};
+static inline bool a5gpu_protect_resource(A5GPUProtectedResources *set,uint32_t index)
+{
+    if (!set || set->count>kA5GPUPhysicalSurfaceSlots || index>=kA5GPULogicalSurfaceCapacity) return false;
+    for (uint32_t i=0;i<set->count;i++) if (set->indices[i]==index) return true;
+    if (set->count>=kA5GPUPhysicalSurfaceSlots) return false;
+    set->indices[set->count++]=index;return true;
+}
+static inline bool a5gpu_resource_is_protected(const A5GPUProtectedResources &set,uint32_t index)
+{
+    if (set.count>kA5GPUPhysicalSurfaceSlots) return true;
+    for (uint32_t i=0;i<set.count;i++) if (set.indices[i]==index) return true;
+    return false;
+}
+/* The same bounded first-free allocator is exercised by the host quota test.
+ * Imported surfaces retain their real pages; this allocates no GPU window. */
+template <typename Slot, unsigned N>
+static inline uint32_t a5gpu_resource_free_index(const Slot (&slots)[N])
+{
+    static_assert(N==kA5GPULogicalSurfaceCapacity,"logical resource table bound");
+    for (uint32_t i=0;i<N;i++) if (!slots[i].surface.surface) return i;
+    return N;
+}
+#endif
