--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -41,6 +41,7 @@
 #include <sys/ubc_internal.h>
 #include <sys/vnode.h>
 #include <security/mac_policy.h>
+#include <pexpert/pexpert.h>

 /* iokit/Kernel/arm/SweetEntitlements.cpp */
 void *sweet_entitlements_create(const CS_GenericBlob *blob, size_t blob_len);
@@ -288,6 +289,26 @@
 	if (cs_blob != cs_blob->csb_ro_addr && cs_blob->csb_entitlements == NULL) {
 		sweet_amfi_attach_entitlements(cs_blob);
 	}
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+	/* The local helper can execute from a non-rootfs service mount after
+	 * launchd's mount phase. Authorize only this opt-in, signed helper path
+	 * with its fixed identity and both explicit entitlements. */
+	int metal = 0;
+	const char *identity = csblob_get_identity(cs_blob);
+	if (identity && !strcmp(identity, "com.orhunnx.a5mali-metal-probe") &&
+	    PE_parse_boot_argn("a5metal", &metal, sizeof(metal)) && metal == 1 &&
+	    sweet_entitlements_bool(cs_blob->csb_entitlements, "platform-application") &&
+	    sweet_entitlements_bool(cs_blob->csb_entitlements,
+	    "com.orhunnx.a5xelte.gpu-resource-client")) {
+		char path[128];
+		int length = sizeof(path);
+		if (!vn_getpath(vp, path, &length) &&
+		    !strcmp(path, "/usr/libexec/a5mali-metal-probe")) {
+			*cs_flags |= CS_SIGNED | CS_PLATFORM_BINARY | CS_PLATFORM_PATH;
+			printf("A5XELTE Metal: signed local probe platform authorization\n");
+		}
+	}
+#endif
 	return 0;
 }

