+IOReturn
+AppleCLCD::drawCompilerSuccessLine()
+{
+	const uint32_t lines = 8;
+	const uint64_t offset = static_cast<uint64_t>(fHeight - lines) * fRowBytes;
+	const uint64_t length = static_cast<uint64_t>(lines) * fRowBytes;
+	if (fPhys != 0x67000000ULL || fWidth != 1080 || fHeight != 1920 ||
+	    fRowBytes != 4320 || !fPixels || !fSurface || !fSurface->memory ||
+	    fPowerOff || fGPUUncertain || offset > fSurface->memory->getLength() ||
+	    length > fSurface->memory->getLength() - offset)
+		return kIOReturnNotReady;
+	/* Drain/validate the exact physical descriptor range before changing it.
+	 * No user-selected surface, address, geometry, or color enters this path. */
+	IOReturn result = fSurface->memory->performOperation(kIOMemoryIncoherentIOStore,
+	    offset, length);
+	if (result != kIOReturnSuccess)
+		return result;
+	for (uint32_t y = fHeight - lines; y < fHeight; ++y) {
+		volatile uint32_t *row = reinterpret_cast<volatile uint32_t *>(
+		    fPixels + static_cast<uint64_t>(y) * fRowBytes);
+		for (uint32_t x = 0; x < fWidth; ++x)
+			row[x] = 0xff00ff00u;
+	}
+	__sync_synchronize();
+	return fSurface->memory->performOperation(kIOMemoryIncoherentIOStore,
+	    offset, length);
+}
+
+IOReturn
+AppleCLCD::compilerSuccessAction(OSObject *owner, void *, void *, void *, void *)
+{
+	AppleCLCD *fb = OSDynamicCast(AppleCLCD, owner);
+	if (!fb || !fb->fLock)
+		return kIOReturnNotReady;
+	IOLockLock(fb->fLock);
+	const IOReturn result = fb->drawCompilerSuccessLine();
+	if (result == kIOReturnSuccess) {
+		if (!fb->fCompilerComplete)
+			IOLog("A5XELTE shader compiler: verified native caches complete; green status line shown\n");
+		fb->fCompilerComplete = true;
+		fb->setProperty("A5NativeCompilerComplete", true);
+	}
+	IOLockUnlock(fb->fLock);
+	return result;
+}
+
+IOReturn
+AppleCLCD::compilerSuccess()
+{
+	/* Serializes with complete vsync/present actions, including the GPU fence.
+	 * A possibly live DMA or powered-off panel is never touched. */
+	return fWorkLoop ? fWorkLoop->runAction(&AppleCLCD::compilerSuccessAction, this) :
+	    kIOReturnNotReady;
+}
