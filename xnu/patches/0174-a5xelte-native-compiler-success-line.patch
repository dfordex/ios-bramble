+A5XELTEGPUUserClient::compilerAuthorized(task_t task)
+{
+    int enabled = 0;
+    if (task == TASK_NULL ||
+        !PE_parse_boot_argn("a5compiler", &enabled, sizeof(enabled)) || enabled != 1)
+        return false;
+    proc_t process = static_cast<proc_t>(get_bsdtask_info(task));
+    if (!process || proc_suser(process) != 0)
+        return false;
+    const char *identity = cs_identity_get(process);
+    if (!identity || strcmp(identity, "com.orhunnx.a5shader.a5shader-compile"))
+        return false;
+    vnode_t executable = proc_getexecutablevnode(process);
+    if (!executable)
+        return false;
+    char path[128] = {};
+    int length = sizeof(path);
+    const bool pathOK = vn_getpath(executable, path, &length) == 0 &&
+        !strcmp(path, "/usr/libexec/a5shader-compile");
+    vnode_put(executable);
+    if (!pathOK)
+        return false;
+    const char *required[] = {
+        "platform-application", "com.orhunnx.a5xelte.shader-compiler"
+    };
+    for (unsigned i = 0; i < sizeof(required) / sizeof(required[0]); ++i) {
+        OSObject *value = copyClientEntitlement(task, required[i]);
+        const bool allowed = value == kOSBooleanTrue;
+        if (value) value->release();
+        if (!allowed) return false;
+    }
+    return true;
+}
