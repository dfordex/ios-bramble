+        (r.profileID>=200 && r.profileID<=208) || (r.profileID>=300 && r.profileID<=302);
+    if (!ctx || !input || !out || !a5g3d_as1_native_available() || !profile ||
+        r.jobBytes!=A5NativeJobBytes || (reads|writes|buffers)&~15u || !writes ||
+        r.fragmentOffset>=r.jobBytes-256 || (r.fragmentOffset&15u) ||
+        !a5native_header(input,r.fragmentOffset,9,0)) return kAS1SubmitInvalid;
+    if (clear) {
