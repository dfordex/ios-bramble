+    if (a5g3d_as1_read(gpu,0x100)!=3 || a5g3d_as1_read(gpu,0x104)!=0 ||
+        (a5g3d_as1_read(gpu,0x140)&~3u) || a5g3d_as1_read(gpu,0x144)) {
+        a5g3d_queue_release(owner,token);owner->release();IOLockUnlock(lock);
