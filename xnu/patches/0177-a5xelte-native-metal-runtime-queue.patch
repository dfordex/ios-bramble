+bool A5XELTEGPUUserClient::ensureSurfaceMappingLocked(uint32_t index,uint32_t protectedSlots)
+{
+    if (fClosed || index>=kA5GPUClientMaxResources || !fSlots[index].surface.surface)
+        return false;
+    if (fSlots[index].mapped) return true;
+    if (!fAS1) fAS1=a5g3d_as1_create();
+    if (!fAS1) return false;
+    uint32_t occupied=0;
+    for (uint32_t i=0;i<kA5GPUClientMaxResources;i++)
+        if (fSlots[i].mapped) occupied|=1u<<fSlots[i].mappingSlot;
+    uint32_t physical=4;
+    for (uint32_t i=0;i<4;i++) if (!(occupied&(1u<<i))) { physical=i;break; }
+    if (physical==4) {
+        for (uint32_t i=0;i<kA5GPUClientMaxResources;i++) {
+            ResourceSlot &victim=fSlots[i];
+            if (victim.mapped && !(protectedSlots&(1u<<i))) {
+                if (!a5g3d_as1_unmap(fAS1,victim.mappingSlot)) return false;
+                physical=victim.mappingSlot;victim.mapped=false;
+                if (++fMappingEpoch==0) fMappingEpoch=1;
+                break;
+            }
+        }
+    }
+    if (physical==4) return false;
+    uint32_t bytes=0;
+    if (!a5g3d_as1_map(fAS1,physical,fSlots[index].surface.surface,&bytes)) return false;
+    fSlots[index].mapped=true;fSlots[index].mappingSlot=physical;
+    if (++fMappingEpoch==0) fMappingEpoch=1;
+    return true;
