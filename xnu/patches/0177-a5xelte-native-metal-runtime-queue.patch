+/* SPDX-License-Identifier: MIT
+ * Privileged experimental T720 native queue. Addresses are selected by the
+ * kernel and name only this client's AS1 mappings, never physical memory.
+ */
+#ifndef A5_MALI_NATIVE_ABI_H
+#define A5_MALI_NATIVE_ABI_H
+#include <stdint.h>
+enum { A5NativeQuerySelector=17, A5NativeSubmitSelector=18,
+       A5NativeCapability=32, A5NativeSlots=4, A5NativeJobBytes=0x40000,
+       A5NativeJobVA=0x12000000, A5NativeBulkWriteSelector=19,
+       A5NativeBulkWriteMax=0x100000, A5NativeBufferMax=0x800000 };
+typedef struct { uint32_t version,size,reserved0,reserved1; } A5NativeHeader;
+typedef struct {
+    A5NativeHeader header;
+    uint64_t surfaces[A5NativeSlots], buffers[A5NativeSlots];
+} A5NativeQueryRequest;
+typedef struct {
+    uint64_t token, gpuVA;
+    uint32_t bytes,width,height,rowBytes,pixelFormat,usage;
+} A5NativeSpan;
+typedef struct {
+    A5NativeHeader header;
+    uint64_t jobVA;
+    uint32_t jobBytes, flags; /* flags is the nonzero AS1 mapping epoch */
+    A5NativeSpan surfaces[A5NativeSlots], buffers[A5NativeSlots];
+} A5NativeQueryResult;
+typedef struct {
+    A5NativeHeader header;
+    uint32_t jobBytes,vertexOffset,tilerOffset,fragmentOffset;
+    uint32_t readSurfaces,writeSurfaces,readBuffers,reserved;
+    uint32_t profileID,mappingEpoch;
+    uint64_t surfaces[A5NativeSlots], buffers[A5NativeSlots];
+    /* Exactly jobBytes encoded bytes follow this fixed structure. */
+} A5NativeSubmitRequest;
+typedef struct {
+    A5NativeHeader header; /* size is fixed header + actual chunk length */
+    uint64_t handle;
+    uint32_t offset,length;
+} A5NativeBulkWriteRequest;
+typedef struct {
+    A5NativeHeader header;
+    uint32_t status,reserved;
+    uint64_t tilerFence,fragmentFence;
+} A5NativeSubmitResult;
+#endif
--- /dev/null
+++ b/iokit/Kernel/arm/A5XELTENativeClient.inc
@@ -0,0 +1,162 @@
+/* All methods run on the opening task's entitlement-gated GPU connection. */
+IOReturn A5XELTEGPUUserClient::nativeTokensLocked(const uint64_t *surfaces,
+    const uint64_t *buffers,A5NativeQueryResult *result,
+    uint32_t readMask,uint32_t writeMask,uint32_t bufferMask,
+    uint32_t *physicalReads,uint32_t *physicalWrites,uint32_t *physicalBuffers)
+{
+    if (fClosed || !fAS1) return kIOReturnNotOpen;
+    if (physicalReads) *physicalReads=0;
+    if (physicalWrites) *physicalWrites=0;
+    if (physicalBuffers) *physicalBuffers=0;
+    uint32_t protectedSlots=0;
+    for (uint32_t i=0;i<4;i++) if (surfaces[i]) {
+        uint32_t slot=static_cast<uint32_t>(surfaces[i]);
+        if (!slot || slot>kA5GPUClientMaxResources ||
+            fSlots[slot-1].generation!=static_cast<uint32_t>(surfaces[i]>>32))
+            return kIOReturnNotFound;
+        protectedSlots|=1u<<(slot-1);
+    }
+    if (result) for (uint32_t i=0;i<4;i++) if (surfaces[i] &&
+        !ensureSurfaceMappingLocked(static_cast<uint32_t>(surfaces[i])-1,protectedSlots))
+        return kIOReturnNoResources;
+    for (uint32_t i=0;i<4;i++) {
+        uint32_t bit=1u<<i;
+        if (!surfaces[i]) {
+            if ((readMask|writeMask)&bit) return kIOReturnBadArgument;
+        } else {
+            uint32_t slot=static_cast<uint32_t>(surfaces[i]);
+            if (!slot || slot>kA5GPUClientMaxResources) return kIOReturnBadArgument;
+            ResourceSlot &entry=fSlots[slot-1];
+            if (!entry.surface.surface || !entry.mapped ||
+                entry.generation!=static_cast<uint32_t>(surfaces[i]>>32) ||
+                ((readMask&bit) && !(entry.usage&kA5GPUClientRead)) ||
+                ((writeMask&bit) && !(entry.usage&kA5GPUClientWrite)))
+                return kIOReturnNotFound;
+            A5NativeSpan span={};span.token=surfaces[i];span.usage=entry.usage;
+            if (!a5g3d_as1_native_span(fAS1,entry.mappingSlot,false,&span))
+                return kIOReturnNotReady;
+            if (result) result->surfaces[i]=span;
+            if (physicalReads && (readMask&bit)) *physicalReads|=1u<<entry.mappingSlot;
+            if (physicalWrites && (writeMask&bit)) *physicalWrites|=1u<<entry.mappingSlot;
+        }
+        if (!buffers[i]) {
+            if (bufferMask&bit) return kIOReturnBadArgument;
+        } else {
+            uint32_t slot=0;
+            if (!a5gpu_buffer_token_slot(buffers[i],&slot))
+                return kIOReturnBadArgument;
+            BufferSlot &entry=fBuffers[slot];
+            if (!entry.buffer || entry.generation!=static_cast<uint32_t>(buffers[i]>>32) ||
+                ((bufferMask&bit) && !(entry.usage&kA5GPUClientRead)))
+                return kIOReturnNotFound;
+            if (result && !entry.mapped) {
+                if (!a5g3d_as1_map_buffer(fAS1,slot,entry.buffer,entry.bytes))
+                    return kIOReturnNoResources;
+                entry.mapped=true;if (++fMappingEpoch==0) fMappingEpoch=1;
+            }
+            if (!entry.mapped) return kIOReturnNotFound;
+            A5NativeSpan span={};span.token=buffers[i];span.usage=entry.usage;
+            if (!a5g3d_as1_native_span(fAS1,slot,true,&span))
+                return kIOReturnNotReady;
+            if (result) result->buffers[i]=span;
+            if (physicalBuffers && (bufferMask&bit)) *physicalBuffers|=1u<<slot;
+        }
+    }
+    return kIOReturnSuccess;
+}
+
+IOReturn A5XELTEGPUUserClient::nativeQuery(IOExternalMethodArguments *args)
+{
+    if (!a5g3d_as1_native_available()) return kIOReturnUnsupported;
+    if (!a5gpu_valid_input(args,sizeof(A5NativeQueryRequest)) ||
+        !args->structureOutput || args->structureOutputSize<sizeof(A5NativeQueryResult))
+        return kIOReturnBadArgument;
+    A5NativeQueryRequest r={};memcpy(&r,args->structureInput,sizeof(r));
+    if (!a5gpu_valid_header(reinterpret_cast<A5GPUClientHeader *>(&r.header),sizeof(r)))
+        return kIOReturnBadArgument;
+    A5NativeQueryResult out={};out.header={1,sizeof(out),0,0};
+    out.jobVA=A5NativeJobVA;out.jobBytes=A5NativeJobBytes;
+    IOLockLock(fLock);
+    IOReturn kr=nativeTokensLocked(r.surfaces,r.buffers,&out,0,0,0,
+        nullptr,nullptr,nullptr);
+    out.flags=fMappingEpoch;
+    IOLockUnlock(fLock);
+    if (kr!=kIOReturnSuccess) return kr;
+    memcpy(args->structureOutput,&out,sizeof(out));args->structureOutputSize=sizeof(out);
+    return kIOReturnSuccess;
+}
+
+IOReturn A5XELTEGPUUserClient::nativeSubmit(IOExternalMethodArguments *args)
+{
+    if (!a5g3d_as1_native_available()) return kIOReturnUnsupported;
+    const uint32_t bytes=sizeof(A5NativeSubmitRequest)+A5NativeJobBytes;
+    if (!args || args->scalarInputCount || args->scalarOutputCount ||
+        !args->structureOutput || args->structureOutputSize<sizeof(A5NativeSubmitResult))
+        return kIOReturnBadArgument;
+    IOMemoryDescriptor *descriptor=args->structureInputDescriptor;
+    if (descriptor ? descriptor->getLength()!=bytes :
+        (!args->structureInput || args->structureInputSize!=bytes))
+        return kIOReturnBadArgument;
+    uint8_t *copy=static_cast<uint8_t *>(IOMallocData(bytes));
+    if (!copy) return kIOReturnNoMemory;
+    if (descriptor) {
+        if (descriptor->readBytes(0,copy,bytes)!=bytes) {
+            IOFreeData(copy,bytes);return kIOReturnBadArgument;
+        }
+    } else memcpy(copy,args->structureInput,bytes);
+    A5NativeSubmitRequest r={};memcpy(&r,copy,sizeof(r));
+    if (!a5gpu_valid_header(reinterpret_cast<A5GPUClientHeader *>(&r.header),sizeof(r)) ||
+        r.jobBytes!=A5NativeJobBytes || r.reserved || !r.mappingEpoch ||
+        (r.readSurfaces|r.writeSurfaces|r.readBuffers)&~15u || !r.writeSurfaces) {
+        IOFreeData(copy,bytes);return kIOReturnBadArgument;
+    }
+    A5NativeSubmitResult out={};out.header={1,sizeof(out),0,0};
+    uint32_t reads=0,writes=0,buffers=0;
+    IOLockLock(fLock);
+    IOReturn kr=r.mappingEpoch!=fMappingEpoch ? kIOReturnNotReady :
+        nativeTokensLocked(r.surfaces,r.buffers,nullptr,
+        r.readSurfaces,r.writeSurfaces,r.readBuffers,&reads,&writes,&buffers);
+    if (kr==kIOReturnSuccess) {
+        A5G3DAS1Completion completion={};
+        out.status=a5g3d_as1_submit_native(fAS1,r,copy+sizeof(r),reads,writes,buffers,&completion);
+        out.tilerFence=completion.tilerFence;out.fragmentFence=completion.fragmentFence;
+    }
+    IOLockUnlock(fLock);IOFreeData(copy,bytes);
+    if (kr!=kIOReturnSuccess) return kr;
+    memcpy(args->structureOutput,&out,sizeof(out));args->structureOutputSize=sizeof(out);
+    return kIOReturnSuccess;
+}
+
+IOReturn A5XELTEGPUUserClient::nativeBulkWrite(IOExternalMethodArguments *args)
+{
+    if (!a5g3d_as1_native_available()) return kIOReturnUnsupported;
+    if (!args || args->scalarInputCount || args->scalarOutputCount ||
+        args->structureOutputSize || args->structureOutputDescriptor)
+        return kIOReturnBadArgument;
+    IOMemoryDescriptor *desc=args->structureInputDescriptor;
+    uint64_t bytes=desc ? desc->getLength() : args->structureInputSize;
+    if (bytes<=sizeof(A5NativeBulkWriteRequest) ||
+        bytes>sizeof(A5NativeBulkWriteRequest)+A5NativeBulkWriteMax ||
+        (!desc && !args->structureInput)) return kIOReturnBadArgument;
+    uint8_t *copy=static_cast<uint8_t *>(IOMallocData(bytes));
+    if (!copy) return kIOReturnNoMemory;
+    if (desc ? desc->readBytes(0,copy,bytes)!=bytes : false) {
+        IOFreeData(copy,bytes);return kIOReturnBadArgument;
+    }
+    if (!desc) memcpy(copy,args->structureInput,bytes);
+    A5NativeBulkWriteRequest r={};memcpy(&r,copy,sizeof(r));
+    uint32_t slot=0;
