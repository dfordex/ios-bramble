+            &out->fragmentFence,&started,0);
+    if (status==kAS1SubmitCompleted)
+        for (uint32_t i=0;i<4;i++)
+            if ((writes&(1u<<i)) && ctx->surface[i]->memory->performOperation(
+                kIOMemoryIncoherentIOFlush,0,ctx->mappedBytes[i])!=kIOReturnSuccess)
+                status=kAS1SubmitIOError;
+    if (status==kAS1SubmitCompleted) ctx->completedFence=out->fragmentFence;
+    if (started || status==kAS1SubmitFault || status==kAS1SubmitTimeout) {
+        ctx->poisoned=true;a5g3d_queue_poison(owner,token);
+        IOLog("A5XELTE G3D native: uncertain job; AS1 resources pinned until reboot\n");
+    } else if (!a5g3d_queue_release(owner,token)) {
+        ctx->poisoned=true; status=kAS1SubmitFault;
+    }
+    static unsigned reports=0;
+    if (reports++<32 || status!=kAS1SubmitCompleted)
+        IOLog("A5XELTE G3D native: profile=%u status=%u vertex=%llu fragment=%llu header=%08x mmu=%08x\n",
+            r.profileID,status,out->tilerFence,out->fragmentFence,
+            out->headerStatus,out->mmuIRQ);
+    owner->release();IOLockUnlock(lock);return status;
+}
