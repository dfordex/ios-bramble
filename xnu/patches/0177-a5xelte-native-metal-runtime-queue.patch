+            return kAS1SubmitInvalid;
+    } else if ((r.vertexOffset|r.tilerOffset)&15u ||
+        r.vertexOffset>=r.jobBytes-256 || r.tilerOffset>=r.jobBytes-256 ||
+        r.vertexOffset==r.tilerOffset || r.vertexOffset==r.fragmentOffset ||
+        r.tilerOffset==r.fragmentOffset ||
+        !a5native_header(input,r.vertexOffset,5,kAS1JobVA+r.tilerOffset) ||
+        !a5native_header(input,r.tilerOffset,7,0)) return kAS1SubmitInvalid;
+    IOLock *lock=a5g3d_as1_lock();IOLockLock(lock);
+    if (gAS1Owner!=ctx || ctx->poisoned || !ctx->installed) {
+        IOLockUnlock(lock);return kAS1SubmitInvalid;
+    }
+    for (uint32_t i=0;i<4;i++) {
+        if ((((reads|writes)&(1u<<i)) && !ctx->surface[i]) ||
+            ((buffers&(1u<<i)) && !ctx->buffer[i])) {
+            IOLockUnlock(lock);return kAS1SubmitInvalid;
+        }
+    }
