+    } else if (!a5g3d_queue_release(owner,token)) {
+        ctx->poisoned=true; status=kAS1SubmitFault;
+    }
+    static unsigned reports=0;
+    if (reports++<32 || status!=kAS1SubmitCompleted)
+        IOLog("A5XELTE G3D native: profile=%u status=%u vertex=%llu fragment=%llu header=%08x mmu=%08x\n",
+            r.profileID,status,out->tilerFence,out->fragmentFence,
+            out->headerStatus,out->mmuIRQ);
+    owner->release();IOLockUnlock(lock);return status;
+}
