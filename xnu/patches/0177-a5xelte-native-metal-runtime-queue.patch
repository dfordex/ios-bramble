+/* Privileged opt-in native graphics jobs. The signed provider constructs v4
+ * descriptors from its authenticated shader registry and actual Metal binds.
+ * GPU virtual addresses refer only to this client's pinned AS1 windows.
+ * This path is not safe for untrusted shader clients; a5native=1 is lab-only.
+ */
+bool a5g3d_as1_native_available()
+{
+    int enabled=0;
+    return PE_parse_boot_argn("a5native",&enabled,sizeof(enabled)) && enabled==1;
+}
+
+bool a5g3d_as1_native_span(A5G3DAS1Context *ctx,uint32_t slot,bool buffer,
+    A5NativeSpan *out)
+{
+    if (!ctx || !out || slot>=4 || !a5g3d_as1_native_available()) return false;
+    IOLock *lock=a5g3d_as1_lock(); IOLockLock(lock);
+    bool ok=gAS1Owner==ctx && !ctx->poisoned && ctx->installed;
+    if (buffer) {
+        ok=ok && ctx->buffer[slot] && ctx->bufferBytes[slot];
+        if (ok) { out->gpuVA=kAS1BufferBase+slot*kAS1BufferWindow;
+            out->bytes=ctx->bufferBytes[slot]; }
+    } else {
+        ok=ok && ctx->surface[slot] && ctx->mappedBytes[slot];
+        if (ok) { SweetSurface *s=ctx->surface[slot];
+            out->gpuVA=kAS1Base+slot*kAS1Window;
+            out->bytes=ctx->mappedBytes[slot];out->width=s->width;
+            out->height=s->height;out->rowBytes=s->bytesPerRow;
+            out->pixelFormat=s->pixelFormat; }
+    }
+    IOLockUnlock(lock); return ok;
+}
+
+static uint32_t a5native_word(const uint8_t *p,uint32_t offset)
+{ uint32_t v=0;memcpy(&v,p+offset,4);return v; }
+static uint64_t a5native_pointer(const uint8_t *p,uint32_t offset)
+{ uint64_t v=0;memcpy(&v,p+offset,8);return v; }
+static bool a5native_header(const uint8_t *p,uint32_t offset,unsigned type,
+    uint64_t next)
+{
+    return !a5native_word(p,offset) && !a5native_word(p,offset+4) &&
+        !a5native_pointer(p,offset+8) &&
+        ((a5native_word(p,offset+16)>>1)&127)==type &&
+        a5native_pointer(p,offset+24)==next;
+}
+
+A5G3DAS1SubmitStatus a5g3d_as1_submit_native(A5G3DAS1Context *ctx,
+    const A5NativeSubmitRequest &r,const uint8_t *input,
+    uint32_t reads,uint32_t writes,uint32_t buffers,
+    A5G3DAS1Completion *out)
+{
+    if (out) bzero(out,sizeof(*out));
+    bool clear=r.profileID==0;
