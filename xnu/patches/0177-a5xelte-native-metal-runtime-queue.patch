+IOReturn A5XELTEGPUUserClient::nativeQuery(IOExternalMethodArguments *args)
+{
+    if (!a5g3d_as1_native_available()) return kIOReturnUnsupported;
+    if (!a5gpu_valid_input(args,sizeof(A5NativeQueryRequest)) ||
+        !args->structureOutput || args->structureOutputSize<sizeof(A5NativeQueryResult))
+        return kIOReturnBadArgument;
+    A5NativeQueryRequest r={};memcpy(&r,args->structureInput,sizeof(r));
+    if (!a5gpu_valid_header(reinterpret_cast<A5GPUClientHeader *>(&r.header),sizeof(r)))
+        return kIOReturnBadArgument;
+    A5NativeQueryResult out={};out.header={1,sizeof(out),0,0};
+    out.jobVA=A5NativeJobVA;out.jobBytes=A5NativeJobBytes;
+    IOLockLock(fLock);
+    IOReturn kr=nativeTokensLocked(r.surfaces,r.buffers,&out,0,0,0,
+        nullptr,nullptr,nullptr);
+    out.flags=fMappingEpoch;
+    IOLockUnlock(fLock);
+    if (kr!=kIOReturnSuccess) return kr;
+    memcpy(args->structureOutput,&out,sizeof(out));args->structureOutputSize=sizeof(out);
+    return kIOReturnSuccess;
+}
+
+IOReturn A5XELTEGPUUserClient::nativeSubmit(IOExternalMethodArguments *args)
+{
+    if (!a5g3d_as1_native_available()) return kIOReturnUnsupported;
+    const uint32_t bytes=sizeof(A5NativeSubmitRequest)+A5NativeJobBytes;
+    if (!args || args->scalarInputCount || args->scalarOutputCount ||
+        !args->structureOutput || args->structureOutputSize<sizeof(A5NativeSubmitResult))
+        return kIOReturnBadArgument;
+    IOMemoryDescriptor *descriptor=args->structureInputDescriptor;
+    if (descriptor ? descriptor->getLength()!=bytes :
+        (!args->structureInput || args->structureInputSize!=bytes))
+        return kIOReturnBadArgument;
+    uint8_t *copy=static_cast<uint8_t *>(IOMallocData(bytes));
+    if (!copy) return kIOReturnNoMemory;
+    if (descriptor) {
+        if (descriptor->readBytes(0,copy,bytes)!=bytes) {
+            IOFreeData(copy,bytes);return kIOReturnBadArgument;
+        }
+    } else memcpy(copy,args->structureInput,bytes);
+    A5NativeSubmitRequest r={};memcpy(&r,copy,sizeof(r));
+    if (!a5gpu_valid_header(reinterpret_cast<A5GPUClientHeader *>(&r.header),sizeof(r)) ||
+        r.jobBytes!=A5NativeJobBytes || r.reserved || !r.mappingEpoch ||
+        (r.readSurfaces|r.writeSurfaces|r.readBuffers)&~15u || !r.writeSurfaces) {
+        IOFreeData(copy,bytes);return kIOReturnBadArgument;
+    }
+    A5NativeSubmitResult out={};out.header={1,sizeof(out),0,0};
+    uint32_t reads=0,writes=0,buffers=0;
+    IOLockLock(fLock);
+    IOReturn kr=r.mappingEpoch!=fMappingEpoch ? kIOReturnNotReady :
+        nativeTokensLocked(r.surfaces,r.buffers,nullptr,
+        r.readSurfaces,r.writeSurfaces,r.readBuffers,&reads,&writes,&buffers);
+    if (kr==kIOReturnSuccess) {
+        A5G3DAS1Completion completion={};
+        out.status=a5g3d_as1_submit_native(fAS1,r,copy+sizeof(r),reads,writes,buffers,&completion);
+        out.tilerFence=completion.tilerFence;out.fragmentFence=completion.fragmentFence;
+    }
+    IOLockUnlock(fLock);IOFreeData(copy,bytes);
+    if (kr!=kIOReturnSuccess) return kr;
+    memcpy(args->structureOutput,&out,sizeof(out));args->structureOutputSize=sizeof(out);
+    return kIOReturnSuccess;
+}
+
+IOReturn A5XELTEGPUUserClient::nativeBulkWrite(IOExternalMethodArguments *args)
+{
+    if (!a5g3d_as1_native_available()) return kIOReturnUnsupported;
+    if (!args || args->scalarInputCount || args->scalarOutputCount ||
+        args->structureOutputSize || args->structureOutputDescriptor)
+        return kIOReturnBadArgument;
+    IOMemoryDescriptor *desc=args->structureInputDescriptor;
+    uint64_t bytes=desc ? desc->getLength() : args->structureInputSize;
+    if (bytes<=sizeof(A5NativeBulkWriteRequest) ||
+        bytes>sizeof(A5NativeBulkWriteRequest)+A5NativeBulkWriteMax ||
+        (!desc && !args->structureInput)) return kIOReturnBadArgument;
+    uint8_t *copy=static_cast<uint8_t *>(IOMallocData(bytes));
+    if (!copy) return kIOReturnNoMemory;
+    if (desc ? desc->readBytes(0,copy,bytes)!=bytes : false) {
+        IOFreeData(copy,bytes);return kIOReturnBadArgument;
+    }
+    if (!desc) memcpy(copy,args->structureInput,bytes);
+    A5NativeBulkWriteRequest r={};memcpy(&r,copy,sizeof(r));
+    uint32_t slot=0;
+    if (!a5gpu_valid_header(reinterpret_cast<A5GPUClientHeader *>(&r.header),bytes) ||
+        !r.length || r.length>A5NativeBulkWriteMax || r.length!=bytes-sizeof(r) ||
+        !a5gpu_buffer_token_slot(r.handle,&slot)) {
+        IOFreeData(copy,bytes);return kIOReturnBadArgument;
+    }
+    IOReturn kr=kIOReturnNotFound;IOLockLock(fLock);
+    BufferSlot &entry=fBuffers[slot];
+    if (!fClosed && entry.buffer && entry.generation==static_cast<uint32_t>(r.handle>>32) &&
+        (entry.usage&kA5GPUClientWrite) && r.offset<=entry.bytes && r.length<=entry.bytes-r.offset) {
+        kr=entry.buffer->writeBytes(r.offset,copy+sizeof(r),r.length)==r.length ?
+            entry.buffer->performOperation(kIOMemoryIncoherentIOStore,r.offset,r.length) : kIOReturnIOError;
+    }
+    IOLockUnlock(fLock);IOFreeData(copy,bytes);return kr;
+}
