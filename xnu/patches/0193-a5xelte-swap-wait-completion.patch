+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+/* A5_SWAP_WAIT_STATE_BEGIN: kept independent of XNU for the host race test.
+ * All calls are made under AppleCLCD::fLock. Zero is never a swap ID. */
+enum A5SwapStatus : uint8_t {
+	kA5SwapUnknown = 0, kA5SwapPending = 1, kA5SwapShown = 2,
+	kA5SwapDropped = 3, kA5SwapFailed = 4,
+};
+struct A5SwapWaitState {
+	struct Entry { uint32_t id; A5SwapStatus status; } entries[64];
+	void issue(uint32_t id) {
+		Entry &e = entries[id % 64];
+		e.id = id;
+		e.status = kA5SwapPending;
+	}
+	A5SwapStatus status(uint32_t id) const {
+		if (id == 0)
+			return kA5SwapShown;
+		const Entry &e = entries[id % 64];
+		return e.id == id ? e.status : kA5SwapUnknown;
+	}
+	void finish(uint32_t id, A5SwapStatus result) {
+		Entry &e = entries[id % 64];
+		if (id != 0 && e.id == id && e.status == kA5SwapPending)
+			e.status = result;
+	}
+};
+static A5SwapStatus
+a5_swap_completion(bool allLayersPresented, bool gpuUncertain)
+{
+	return allLayersPresented && !gpuUncertain ?
+	    kA5SwapShown : kA5SwapFailed;
+}
+/* A5_SWAP_WAIT_STATE_END */
+#endif
