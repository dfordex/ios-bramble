+/* Snapshot before IRQ acknowledgement, reset, or descriptor access. Faulted
+ * jobs can remain active, so read only MMIO and retain their pinned memory. */
+static void
+a5g3d_queue_capture_fault(vm_offset_t gpu, uint32_t slot, uint64_t fence,
+    const char *reason, uint32_t jobIRQ, uint32_t mmuIRQ, uint32_t gpuIRQ,
+    A5G3DQueueCompletion *completion)
+{
+    const uint32_t slotBase = 0x1800 + slot * 0x80;
+    const uint32_t faultStatus = a5g3d_read32(gpu, 0x241c);
+    const uint64_t faultAddress = static_cast<uint64_t>(
+        a5g3d_read32(gpu, 0x2424)) << 32 | a5g3d_read32(gpu, 0x2420);
+    const uint64_t head = static_cast<uint64_t>(
+        a5g3d_read32(gpu, slotBase + 4)) << 32 |
+        a5g3d_read32(gpu, slotBase);
+    const uint32_t jsState = a5g3d_read32(gpu, 0x1010);
+    if (completion) {
+        completion->jobIRQ = jobIRQ;
+        completion->mmuIRQ = mmuIRQ;
+        completion->gpuIRQ = gpuIRQ;
+        completion->jsState = jsState;
+        completion->headerStatus = 0xffffffffu; /* DMA target not read */
+    }
+    IOLog("A5XELTE G3D: fault snapshot reason=%s fence=%llu slot=%u irq=%08x mmu=%08x gpu=%08x as0_status=%08x fault_status=%08x fault_va=%016llx js_head=%016llx js=%08x\n",
+        reason, fence, slot, jobIRQ, mmuIRQ, gpuIRQ,
+        a5g3d_read32(gpu, 0x2428), faultStatus, faultAddress, head, jsState);
+}
