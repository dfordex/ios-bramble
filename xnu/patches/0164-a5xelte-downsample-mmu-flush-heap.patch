+static bool
+a5g3d_downsample_mmu_ready(vm_offset_t gpu)
+{
+    for (unsigned i = 0; i < 10000; ++i) {
+        if (!(a5g3d_read32(gpu, 0x2428) & 1u))
+            return true;
+        IODelay(10);
+    }
+    return false;
+}
+
+static bool
+a5g3d_downsample_flush_tables(vm_offset_t gpu)
+{
+    if (!a5g3d_downsample_mmu_ready(gpu) ||
+        a5g3d_read32(gpu, 0x2000) || a5g3d_read32(gpu, 0x241c))
+        return false;
+    /* Panfrost lock_region: aligned 64 KiB at TestVA covers all twelve
+     * private pages. Width is log2(65536)-1, encoded with the base VA. */
+    static_assert((kA5G3DTestVA & 0xffffu) == 0,
+        "downsample lock range must be naturally aligned");
+    a5g3d_write32(gpu, 0x2410,
+        static_cast<uint32_t>(kA5G3DTestVA) | 15u);
+    a5g3d_write32(gpu, 0x2414, 0u);
+    __sync_synchronize();
+    a5g3d_write32(gpu, 0x2418, 2u); /* AS_COMMAND_LOCK */
+    if (!a5g3d_downsample_mmu_ready(gpu) ||
+        a5g3d_read32(gpu, 0x2000) || a5g3d_read32(gpu, 0x241c))
+        return false;
+    a5g3d_write32(gpu, 0x2418, 4u); /* AS_COMMAND_FLUSH_PT */
+    return a5g3d_downsample_mmu_ready(gpu) &&
+        !a5g3d_read32(gpu, 0x2000) && !a5g3d_read32(gpu, 0x241c);
+}
