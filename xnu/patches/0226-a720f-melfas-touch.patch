+#else /* A720F */
+/*
+ * SM-A720F Melfas MMS449, following Samsung's melfas_mms400.c for the
+ * universal7880 kernel. i2c@13890000 is the S3C2440 I2C_NFC bus (PCLK gate:
+ * CMU_PERI CLK_ENABLE_CLK_PERI_BUS0 bit 19). SDA/SCL are GPC2-0/1, bank 0 of
+ * the NFC pin controller, function 2 with pull-ups. INT is GPA0-5, active
+ * low. The chip runs from PMIC LDO34, which this driver does not switch; a
+ * missing ACK at 0x48 is reported instead.
+ */
+#define A7_TOUCH_I2C            0x13890000
+#define A7_TOUCH_PINS           0x139c0000
+#define A7_ALIVE_PINS           0x139f0000
+#define A7_ALIVE_GPA0           0x40
+#define A7_TOUCH_INT            (1u << 5)
+#define A7_CMU_PERI             0x101f0000
+#define A7_PERI_BUS0_GATE       0x810
+#define A7_I2C_NFC_PCLK         (1u << 19)
+#define A7_TOUCH_EVENT_SIZE     8u
+#define A7_TOUCH_MAX_PACKET     (1u + A5_TOUCH_SLOTS * A7_TOUCH_EVENT_SIZE)
+
+static bool
+a7touch_read(uint8_t r0, uint8_t r1, uint8_t *data, unsigned length)
+{
+	uint8_t reg[2] = {r0, r1};
+	return a5touch_message(a5_touch_bus, false, reg, sizeof(reg)) &&
+	       a5touch_message(a5_touch_bus, true, data, length);
+}
+
+/* mms_interrupt(): info byte (bit 7 alert, bits 6:0 size), 8-byte events;
+ * the rest of a long packet follows as a plain receive. */
+static bool
+a7touch_poll(unsigned *lines)
+{
+	uint8_t packet[A7_TOUCH_MAX_PACKET] = {0};
+	unsigned size;
+	if (!a7touch_read(0x02, 0x10, packet, 1 + A7_TOUCH_EVENT_SIZE)) {
+		return false;
+	}
+	size = packet[0] & 0x7fu;
+	if (packet[0] & 0x80u) {
+		if (*lines < 256) {
+			printf("A720F TOUCH: alert type=%u\n", packet[1]);
+			(*lines)++;
+		}
+		return true;
+	}
+	if (size == 0) {
+		return true;
+	}
+	if (size > A7_TOUCH_MAX_PACKET - 1 || size % A7_TOUCH_EVENT_SIZE) {
+		printf("A720F TOUCH: corrupt packet info=%#x\n", packet[0]);
+		return false;
+	}
+	if (size > A7_TOUCH_EVENT_SIZE &&
+	    !a5touch_message(a5_touch_bus, true, packet + 1 + A7_TOUCH_EVENT_SIZE,
+	    size - A7_TOUCH_EVENT_SIZE)) {
+		return false;
+	}
+	for (unsigned at = 1; at < 1 + size; at += A7_TOUCH_EVENT_SIZE) {
+		const uint8_t *e = packet + at;
+		int slot = (int)(e[0] & 0x0fu) - 1;
+		uint16_t x = (uint16_t)(e[2] | ((e[1] & 0x0fu) << 8));
+		uint16_t y = (uint16_t)(e[3] | ((e[1] >> 4) << 8));
+		if (slot < 0 || slot >= (int)A5_TOUCH_SLOTS) {
+			continue;
+		}
+		if (e[0] & 0x80u) {
+			if (*lines < 256 && !a5_touch_active[slot]) {
+				printf("A720F TOUCH: down slot=%d x=%u y=%u flags=%#x\n",
+				    slot, x, y, e[0]);
+				(*lines)++;
+			}
+			a5_touch_x[slot] = x;
+			a5_touch_y[slot] = y;
+			a5_touch_active[slot] = true;
+			sweet_hid_touch(slot, 1, x, y);
+		} else if (a5_touch_active[slot]) {
+			sweet_hid_touch(slot, 0, a5_touch_x[slot], a5_touch_y[slot]);
+			a5_touch_active[slot] = false;
+		}
+	}
+	return true;
+}
+
+static void
+a7touch_thread(void *arg, wait_result_t result)
+{
+	unsigned lines = 0, errors = 0, ticks = 0;
+	(void)arg;
+	(void)result;
+	printf("A720F TOUCH: worker started\n");
+	for (;;) {
+		/* INT low means an event is queued; also poll every 100 ms in
+		 * case the pin is not routed to the alive DAT register. */
+		bool pending = !(a5touch_read(a5_touch_alive, A7_ALIVE_GPA0 + 4) & A7_TOUCH_INT);
+		if (pending || ++ticks >= 20) {
+			ticks = 0;
+			if (a7touch_poll(&lines)) {
+				errors = 0;
+			} else if (++errors <= 8) {
+				printf("A720F TOUCH: packet read failed errors=%u\n", errors);
+			} else if (errors >= 200) {
+				printf("A720F TOUCH: worker stopped after %u failed reads\n", errors);
+				break;
+			}
+		}
+		a5touch_sleep_5ms();
+	}
+	a5touch_release_contacts();
+	thread_terminate_self();
+}
+
+void
+a5xelte_touch_probe(void)
+{
+	int enabled = A5_TOUCH_DEFAULT;
+	vm_offset_t pins, cmu;
+	uint32_t gate, con, pud;
+	uint8_t res[4] = {0};
+	thread_t thread;
+	(void)PE_parse_boot_argn("a5touchprobe", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	pins = ml_io_map(A7_TOUCH_PINS, 0x1000);
+	cmu = ml_io_map(A7_CMU_PERI, 0x1000);
+	a5_touch_alive = ml_io_map(A7_ALIVE_PINS, 0x1000);
+	a5_touch_bus = ml_io_map(A7_TOUCH_I2C, 0x1000);
+	if (!pins || !cmu || !a5_touch_alive || !a5_touch_bus) {
+		printf("A720F TOUCH: probe MMIO mapping failed\n");
+		return;
+	}
+	a5_touch_slave = 0x48u << 1;
+	gate = a5touch_read(cmu, A7_PERI_BUS0_GATE);
+	con = a5touch_read(pins, 0);
+	pud = a5touch_read(pins, 8);
+	printf("A720F TOUCH: PERI_BUS0 gate=%#x GPC2 con=%#x dat=%#x pud=%#x GPA0 con=%#x dat=%#x\n",
+	    gate, con, a5touch_read(pins, 4), pud,
+	    a5touch_read(a5_touch_alive, A7_ALIVE_GPA0),
+	    a5touch_read(a5_touch_alive, A7_ALIVE_GPA0 + 4));
+	if (!(gate & A7_I2C_NFC_PCLK)) {
+		a5touch_write(cmu, A7_PERI_BUS0_GATE, gate | A7_I2C_NFC_PCLK);
+		printf("A720F TOUCH: I2C_NFC clock enabled\n");
+	}
+	a5touch_write(pins, 8, (pud & ~0xfu) | 0xfu);
+	a5touch_write(pins, 0, (con & ~0xffu) | 0x22u);
+	delay(100);
+	/* MIP_R0_INFO resolution X/Y: the panel's 1080x1920 when alive. */
+	if (!a7touch_read(0x01, 0x10, res, sizeof(res))) {
+		printf("A720F TOUCH: no answer at 0x48 (LDO34 off?), touch disabled\n");
+		a5touch_write(pins, 0, con);
+		a5touch_write(pins, 8, pud);
+		return;
+	}
+	printf("A720F TOUCH: MMS449 resolution %ux%u\n",
+	    (unsigned)res[0] | ((unsigned)res[1] << 8),
+	    (unsigned)res[2] | ((unsigned)res[3] << 8));
+	if (kernel_thread_start(a7touch_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("A720F TOUCH: worker thread start failed\n");
+	}
+}
+#endif /* A720F */
 #endif
