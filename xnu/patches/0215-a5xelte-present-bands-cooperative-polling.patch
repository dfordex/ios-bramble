+/* Exact row comparison: no probabilistic hashes or guessed damage metadata. */
+#ifndef A5XELTE_PRESENT_BAND_H
+#define A5XELTE_PRESENT_BAND_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include <stdbool.h>
+typedef struct { uint32_t first, end; } A5PresentBand;
+static inline bool a5present_span(size_t bytes,uint32_t width,uint32_t height,uint32_t stride)
+{
+    return width && height && width<=2048 && height<=2048 &&
+        stride>=width*4 && (uint64_t)(height-1)*stride+width*4<=bytes;
+}
+static inline bool a5present_band(const void *source,size_t sourceBytes,uint32_t stride,
+    const void *shadow,size_t shadowBytes,uint32_t width,uint32_t height,bool valid,A5PresentBand *band)
+{
+    if(!source || !shadow || !band || !a5present_span(sourceBytes,width,height,stride) ||
+        !a5present_span(shadowBytes,width,height,width*4))return false;
+    band->first=0;band->end=height;
+    if(!valid)return true;
+    uint32_t first=height,end=0;
+    for(uint32_t y=0;y<height;y++)
+        if(memcmp((const uint8_t*)source+(size_t)y*stride,
+            (const uint8_t*)shadow+(size_t)y*width*4,width*4)){
+            if(first==height)first=y;end=y+1;
+        }
+    if(!end){band->first=band->end=0;return true;}
+    band->first=first&~15u;band->end=(end+15u)&~15u;
+    if(band->end>height)band->end=height;
+    return true;
+}
+static inline void a5present_remember(const void *source,uint32_t stride,void *shadow,
+    uint32_t width,A5PresentBand band)
+{
+    for(uint32_t y=band.first;y<band.end;y++)
+        memcpy((uint8_t*)shadow+(size_t)y*width*4,
+            (const uint8_t*)source+(size_t)y*stride,width*4);
+}
+static inline bool a5present_scissor(uint32_t *viewport,uint32_t *fragment,
+    uint32_t width,uint32_t height,A5PresentBand band)
+{
+    if(!viewport||!fragment||!width||width>2048||!height||height>2048||
+        band.first>=band.end||band.end>height||(band.first&15u)||
+        ((band.end&15u)&&band.end!=height))return false;
+    viewport[6]=band.first<<16;
+    viewport[7]=(width-1)|((band.end-1)<<16);
+    fragment[8]=(band.first>>4)<<16;
+    fragment[9]=((width-1)>>4)|(((band.end-1)>>4)<<16);
+    return true;
+}
+#endif
