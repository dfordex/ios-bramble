@@ -0,0 +1,11 @@
+/* Preserve the existing nominal delay budget; yield after a short spin. */
+#ifndef A5XELTE_GPU_POLL_H
+#define A5XELTE_GPU_POLL_H
+static inline void a5g3d_poll_pause(unsigned *elapsedUS,unsigned budgetUS)
+{
+    if(*elapsedUS>=budgetUS)return;
+    unsigned remaining=budgetUS-*elapsedUS;
+    if(*elapsedUS>=200 && remaining>=1000){IOSleep(1);*elapsedUS+=1000;}
+    else {unsigned step=remaining<10?remaining:10;IODelay(step);*elapsedUS+=step;}
+}
+#endif
