+/* IOUserClient's out-of-line input descriptor is not automatically wired.
+ * Snapshot it while prepared, then release the wire before resource locks or
+ * GPU dispatch. The GPU only consumes our owned kernel copy, never this MD.
+ */
+static IOReturn a5gpu_copy_native_input(IOMemoryDescriptor *descriptor,
+    const void *input,void *copy,IOByteCount bytes)
+{
+    if (!descriptor) {
+        memcpy(copy,input,bytes);
+        return kIOReturnSuccess;
+    }
+    IOReturn kr=descriptor->prepare(kIODirectionOut);
+    if (kr!=kIOReturnSuccess) return kr;
+    IOByteCount copied=descriptor->readBytes(0,copy,bytes);
+    IOReturn completed=descriptor->complete(kIODirectionOut);
+    if (copied!=bytes) return kIOReturnUnderrun;
+    return completed;
+}
