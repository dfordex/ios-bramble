+/* Only a complete, independently validated Metal implementation may turn
+ * this on. The ordinary a5gpu=8 private queue does not meet stock Metal's
+ * resource, pipeline, command and completion contracts.
+ */
+#ifndef A5_MALI_FULL_METAL_PROVIDER_READY
+#define A5_MALI_FULL_METAL_PROVIDER_READY 0
+#endif
+
 /* The IOKit exported machine header omits these kernel-private mappings. */
@@ -813,1 +821,48 @@
+#if A5_MALI_FULL_METAL_PROVIDER_READY
+/* The stock Metal discovery query checks the actual IOKit metaclass. Keep
+ * this proxy separate from A5XELTEGPU so ordinary private GPU service
+ * registration remains invisible to Metal even in a provider-ready build.
+ * No Apple IOGPU or AGX behavior is inherited or implied here.
+ */
+class IOAcceleratorES : public IOService {
+    OSDeclareDefaultStructors(IOAcceleratorES);
+};
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+class A5XELTEGPUAccelerator : public IOAcceleratorES {
+    OSDeclareDefaultStructors(A5XELTEGPUAccelerator);
+};
+OSDefineMetaClassAndStructors(A5XELTEGPUAccelerator, IOAcceleratorES);
+
+static bool
+a5g3d_register_stock_metal_proxy(IOService *privateGPU)
+{
+    A5XELTEGPUAccelerator *proxy = OSTypeAlloc(A5XELTEGPUAccelerator);
+    if (!proxy)
+        return false;
+    if (!proxy->init()) {
+        proxy->release();
+        return false;
+    }
+    if (!proxy->attach(privateGPU)) {
+        proxy->release();
+        return false;
+    }
+    if (!proxy->start(privateGPU)) {
+        proxy->detach(privateGPU);
+        proxy->release();
+        return false;
+    }
+    /* The plugin opens the parent A5XELTEGPU service through its own
+     * entitlement-gated private client. The proxy is discovery only.
+     */
+    proxy->setProperty("MetalPluginName", "A5MaliMetal");
+    proxy->setProperty("MetalPluginClassName", "A5MaliMetalDevice");
+    proxy->registerService();
+    proxy->release();
+    IOLog("A5XELTE G3D: opt-in stock Metal discovery proxy registered\n");
+    return true;
+}
+#endif
+
 class A5XELTEGPU : public IOService {
