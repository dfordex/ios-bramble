+bool
+a5g3d_reset_private_texture(IOBufferMemoryDescriptor *backing)
+{
+    /* The tiler and fragment jobs write back to their headers and scratch.
+     * The boot fixture starts from zeroed data, so repeat that exact setup
+     * before a later live IOSurface job instead of replaying stale results.
+     * Only a CPU staging reservation may rewrite the runtime backing.
+     */
+    if (!backing || backing->getLength() <
+            kA5G3DDataOffset + 0x4000 || !backing->getBytesNoCopy() ||
+        (gA5G3DRuntimeReady &&
+            (backing != gA5G3DQueueBacking || gA5G3DQueueState != 3)))
+        return false;
+    uint8_t *data = static_cast<uint8_t *>(backing->getBytesNoCopy()) +
+        kA5G3DDataOffset;
+    bzero(data, 0x4000);
+    uint32_t *header = reinterpret_cast<uint32_t *>(data);
+    header[4] = 0x00020013; /* fragment job index 2 */
+    reinterpret_cast<uint64_t *>(header)[5] =
+        kA5G3DTestVA + kA5G3DFragmentFBOffset;
+    uint32_t *fb = reinterpret_cast<uint32_t *>(data + kA5G3DFragmentFBOffset);
+    fb[1] = 31;
+    fb[8] = 0xb84da201;
+    fb[9] = 0x00141000;
+    fb[11] = 0x000f000f;
+    reinterpret_cast<uint64_t *>(fb)[10] =
+        kA5G3DTestVA + kA5G3DFragmentOutputOffset;
+    fb[22] = 64;
+    for (unsigned i = 0; i < 4; ++i)
+        fb[32 + i] = 0xff000000;
+    fb[48] = 4096;
+    fb[49] = 0;
+    const uint64_t polygonVA = kA5G3DTestVA + kA5G3DPolygonListOffset;
+    reinterpret_cast<uint64_t *>(fb)[25] = polygonVA;
+    reinterpret_cast<uint64_t *>(fb)[26] = polygonVA + 512;
+    reinterpret_cast<uint64_t *>(fb)[27] = kA5G3DTestVA + 0x3000;
+    reinterpret_cast<uint64_t *>(fb)[28] = kA5G3DTestVA + 0x4000;
+    reinterpret_cast<uint32_t *>(data + kA5G3DPolygonListOffset)[128] =
+        0xa0000000;
+    static const struct { uint16_t offset; uint32_t word; } fixture[] = {
+#include "A5XELTEGPUTextureFixture.inc"
+    };
+    for (const auto &entry : fixture)
+        *reinterpret_cast<uint32_t *>(data + entry.offset) = entry.word;
+    uint32_t *source = reinterpret_cast<uint32_t *>(data + 0xa00);
+    uint32_t *output = reinterpret_cast<uint32_t *>(
+        data + kA5G3DFragmentOutputOffset);
+    for (unsigned i = 0; i < kA5G3DFragmentPixels; ++i) {
+        source[i] = kA5G3DFragmentRed;
+        output[i] = 0x5a5a5a5a;
+    }
+    return true;
+}
+
