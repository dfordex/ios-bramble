+/* Check all existing destinations before the first create/write. Missing
+ * parents are allowed only after the complete typed directory table passed
+ * preflight; NAMEI_NOFOLLOW_ANY rejects both ancestor and leaf symlinks. */
+static int
+a5metal_install_existing(const char *path, bool directory, vfs_context_t ctx,
+    mount_t rootmount, vnode_t *result)
+{
+	struct nameidata nd;
+	*result = NULLVP;
+	NDINIT(&nd, LOOKUP, OP_LOOKUP, NOFOLLOW | NOCROSSMOUNT, UIO_SYSSPACE,
+	    CAST_USER_ADDR_T(path), ctx);
+	nd.ni_flag = NAMEI_NOFOLLOW_ANY;
+	int error = namei(&nd);
+	if (error) {
+		return error == ENOENT ? 0 : error;
+	}
+	vnode_t vp = nd.ni_vp;
+	if (vp == NULLVP || vnode_mount(vp) != rootmount ||
+	    (directory ? !vnode_isdir(vp) : !vnode_isreg(vp))) {
+		error = EXDEV;
+	} else if (!directory) {
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_WANTED(&va, va_nlink);
+		error = vnode_getattr(vp, &va, ctx);
+		if (!error && (!VATTR_IS_SUPPORTED(&va, va_nlink) || va.va_nlink != 1)) {
+			error = EMLINK;
+		}
+	}
+	nameidone(&nd);
+	if (nd.ni_dvp != NULLVP) {
+		vnode_put(nd.ni_dvp);
+	}
+	if (error && vp != NULLVP) {
+		vnode_put(vp);
+	} else {
+		*result = vp;
+	}
+	return error;
+}
+
+static int
+a5metal_install_destination_preflight(vfs_context_t ctx, mount_t rootmount)
+{
+	int error = vfs_update_vfsstat(rootmount, ctx, VFS_KERNEL_EVENT);
+	if (error) {
+		return error;
+	}
+	uint64_t bytes = 64U * 1024U * 1024U;
+#if defined(A5METAL_DIRECTORIES_PRESENT)
+	if (a5metal_install_apps_enabled) {
+		bytes += sizeof(a5metal_install_directories) /
+		    sizeof(a5metal_install_directories[0]) * UINT64_C(16384);
+		for (unsigned int i = 0; i < sizeof(a5metal_install_directories) /
+		    sizeof(a5metal_install_directories[0]); i++) {
+			vnode_t vp = NULLVP;
+			error = a5metal_install_existing(a5metal_install_directories[i].path,
+			    true, ctx, rootmount, &vp);
+			if (vp != NULLVP) {
+				vnode_put(vp);
+			}
+			if (error) {
+				return error;
+			}
+		}
+	}
+#endif
+	for (unsigned int i = 0; i < sizeof(a5metal_install_files) /
+	    sizeof(a5metal_install_files[0]); i++) {
+		const struct a5metal_install_file *file = &a5metal_install_files[i];
+		if (!a5metal_install_apps_enabled && a5metal_install_app_path(file->path, false)) {
+			continue;
+		}
+		bytes += file->size;
+		vnode_t vp = NULLVP;
+		error = a5metal_install_existing(file->path, false, ctx, rootmount, &vp);
+		if (vp != NULLVP) {
+			vnode_put(vp);
+		}
+		if (error) {
+			return error;
+		}
+	}
+	struct vfsstatfs *stats = vfs_statfs(rootmount);
+	if (!stats->f_bsize || stats->f_bavail > UINT64_MAX / stats->f_bsize ||
+	    stats->f_bavail * stats->f_bsize < bytes) {
+		return ENOSPC;
+	}
+	printf("A5XELTE Metal install: destination preflight free=%llu required=%llu error=0\n",
+	    stats->f_bavail * stats->f_bsize, bytes);
+	return 0;
+}
+
+#if defined(A5METAL_DIRECTORIES_PRESENT)
+static int
+a5metal_install_directory_metadata(const struct a5metal_install_directory *dir,
+    vfs_context_t ctx, mount_t rootmount)
+{
+	vnode_t vp = NULLVP;
+	int error = a5metal_install_existing(dir->path, true, ctx, rootmount, &vp);
+	if (error || vp == NULLVP) {
+		return error ? error : ENOENT;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, dir->mode);
+	VATTR_SET(&va, va_uid, dir->uid);
+	VATTR_SET(&va, va_gid, dir->gid);
+	error = vnode_setattr(vp, &va, ctx);
+	if (!error) {
+		error = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+	}
+	vnode_put(vp);
+	return error;
+}
+#endif
