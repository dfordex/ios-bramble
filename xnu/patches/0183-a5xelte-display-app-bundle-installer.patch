+static bool
+a5metal_install_app_path(const char *path, bool directory)
+{
+	static const char *const roots[] = {
+		"/Applications/PosterBoard.app", "/Applications/PaperBoard.app",
+		"/Applications/PreBoard.app", "/Applications/InputUI.app",
+		"/Applications/MediaRemoteUI.app", "/Applications/ClockAngel.app"
+	};
+	if (!path || path[0] != '/' || !path[1] || strnlen(path, MAXPATHLEN) == MAXPATHLEN) {
+		return false;
+	}
+	if (directory && !strcmp(path, "/Applications")) {
+		return true;
+	}
+	for (const char *component = path + 1; *component;) {
+		const char *end = strchr(component, '/');
+		size_t size = end ? (size_t)(end - component) : strlen(component);
+		if (!size || (size == 1 && component[0] == '.') ||
+		    (size == 2 && component[0] == '.' && component[1] == '.') ||
+		    (end && !end[1])) {
+			return false;
+		}
+		component += size;
+		if (*component == '/') {
+			component++;
+		}
+	}
+	for (unsigned int i = 0; i < sizeof(roots) / sizeof(roots[0]); i++) {
+		size_t size = strlen(roots[i]);
+		if (!strncmp(path, roots[i], size) &&
+		    ((directory && path[size] == 0) || path[size] == '/')) {
+			return true;
+		}
+	}
+	return false;
+}
