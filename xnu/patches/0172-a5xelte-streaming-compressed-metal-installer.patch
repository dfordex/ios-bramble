+#define A5METAL_INSTALL_CHUNK (64U * 1024U)
+#define A5METAL_INSTALL_FILE_MAX (32U * 1024U * 1024U)
+#define A5METAL_INSTALL_RAW_MAX (64U * 1024U * 1024U)
+#define A5METAL_INSTALL_PACKED_MAX (10U * 1024U * 1024U)
+#define A5METAL_INSTALL_ZALLOC_MAX (128U * 1024U)
+
+struct a5metal_zalloc_header {
+	size_t size;
+	size_t reserved;
+};
+
+static voidpf
+a5metal_install_zalloc(voidpf opaque __unused, uInt items, uInt size)
+{
+	struct a5metal_zalloc_header *header;
+	size_t bytes;
+	if (!items || !size || items > A5METAL_INSTALL_ZALLOC_MAX / size) {
+		return Z_NULL;
+	}
+	bytes = (size_t)items * size + sizeof(*header);
+	header = kheap_alloc(KHEAP_DEFAULT, bytes, Z_WAITOK | Z_ZERO);
+	if (header == NULL) {
+		return Z_NULL;
+	}
+	header->size = bytes;
+	return header + 1;
+}
+
+static void
+a5metal_install_zfree(voidpf opaque __unused, voidpf address)
+{
+	if (address != Z_NULL) {
+		struct a5metal_zalloc_header *header =
+		    (struct a5metal_zalloc_header *)address - 1;
+		size_t bytes = header->size;
+		kheap_free(KHEAP_DEFAULT, header, bytes);
+	}
+}
+
+struct a5metal_install_stream {
+	const struct a5metal_install_file *file;
+	z_stream z;
+	unsigned int offset;
+	bool initialized;
+	bool ended;
+};
+
+static int
+a5metal_install_stream_start(struct a5metal_install_stream *stream,
+    const struct a5metal_install_file *file)
+{
+	bzero(stream, sizeof(*stream));
+	stream->file = file;
+	if (file->compressed_size) {
+		stream->z.zalloc = a5metal_install_zalloc;
+		stream->z.zfree = a5metal_install_zfree;
+		int status = inflateInit(&stream->z);
+		if (status != Z_OK) {
+			return status == Z_MEM_ERROR ? ENOMEM : EIO;
+		}
+		stream->initialized = true;
+		stream->z.next_in = (Bytef *)(uintptr_t)file->data;
+		stream->z.avail_in = file->compressed_size;
+	}
+	return 0;
+}
+
+static void
+a5metal_install_stream_end(struct a5metal_install_stream *stream)
+{
+	if (stream->initialized) {
+		(void)inflateEnd(&stream->z);
+		stream->initialized = false;
+	}
+}
+
+static int
+a5metal_install_stream_rewind(struct a5metal_install_stream *stream)
+{
+	if (stream->initialized) {
+		if (inflateReset(&stream->z) != Z_OK) {
+			return EIO;
+		}
+		stream->z.next_in = (Bytef *)(uintptr_t)stream->file->data;
+		stream->z.avail_in = stream->file->compressed_size;
+	}
+	stream->offset = 0;
+	stream->ended = false;
+	return 0;
+}
+
+/* Every successful call returns a bounded chunk, or count=0 only after the
+ * complete raw input / exact single compressed stream has been consumed. */
+static int
+a5metal_install_stream_next(struct a5metal_install_stream *stream,
+    unsigned char *buffer, const unsigned char **data, unsigned int *count)
+{
+	const struct a5metal_install_file *file = stream->file;
+	*count = 0;
+	*data = NULL;
+	if (stream->ended) {
+		return 0;
+	}
+	if (!file->compressed_size) {
+		*count = MIN(A5METAL_INSTALL_CHUNK, file->size - stream->offset);
+		*data = file->data + stream->offset;
+		stream->offset += *count;
+		stream->ended = stream->offset == file->size;
+		return 0;
+	}
+	for (;;) {
+		unsigned int remaining = file->size - stream->offset;
+		/* With no raw bytes remaining, allow one output byte so that an
+		 * overlong stream is rejected while its trailer is still parsed. */
+		unsigned int capacity = remaining ?
+		    MIN(A5METAL_INSTALL_CHUNK, remaining) : 1U;
+		uLong before_in = stream->z.total_in;
+		uLong before_out = stream->z.total_out;
+		stream->z.next_out = buffer;
+		stream->z.avail_out = capacity;
+		int status = inflate(&stream->z, Z_NO_FLUSH);
+		unsigned int produced = capacity - stream->z.avail_out;
+		if (produced > remaining) {
+			return EIO;
+		}
+		stream->offset += produced;
+		if (status == Z_STREAM_END) {
+			if (stream->offset != file->size || stream->z.avail_in ||
+			    stream->z.total_in != file->compressed_size ||
+			    stream->z.total_out != file->size) {
+				return EIO;
+			}
+			stream->ended = true;
+		} else if (status != Z_OK) {
+			return status == Z_MEM_ERROR ? ENOMEM : EIO;
+		}
+		if (produced) {
+			*data = buffer;
+			*count = produced;
+			return 0;
+		}
+		if (stream->ended) {
+			return 0;
+		}
+		if (before_in == stream->z.total_in &&
+		    before_out == stream->z.total_out) {
+			return EIO;
+		}
+	}
+}
+
+static bool
+a5metal_install_path_allowed(const char *path)
+{
+	return path &&
+	    (!strcmp(path, "/System/Library/Extensions/A5MaliMetal.bundle/A5MaliMetal") ||
+	    !strcmp(path, "/System/Library/Extensions/A5MaliMetal.bundle/Info.plist") ||
+	    !strcmp(path, "/System/Library/Extensions/A5MaliMetal.bundle/_CodeSignature/CodeResources") ||
+	    !strcmp(path, "/usr/libexec/a5mali-metal-probe") ||
+	    !strcmp(path, "/System/Library/LaunchDaemons/com.orhunnx.a5mali-metal-probe.plist") ||
+	    !strcmp(path, "/System/Library/xpc/launchd.plist") ||
+	    !strcmp(path, "/usr/libexec/a5shader-compile") ||
+	    !strcmp(path, "/usr/libexec/a5shader/metal2vulkan") ||
+	    !strcmp(path, "/usr/libexec/a5shader/midgard-compile") ||
+	    !strcmp(path, "/usr/libexec/a5shader/spirv-val") ||
+	    !strcmp(path, "/usr/libexec/a5shader/profile.json") ||
+	    !strcmp(path, "/usr/libexec/a5shader/pairs.json") ||
+	    !strcmp(path, "/System/Library/LaunchDaemons/com.orhunnx.a5shader-compile.plist"));
+}
+
+/* Preflight every stream before creating directories or changing any file.
+ * Keep raw output, compiled-in payload and per-file bounds independent. */
+static int
+a5metal_install_preflight(unsigned char *buffer)
+{
+	unsigned int raw_total = 0, packed_total = 0;
+	for (unsigned int i = 0;
+	    i < sizeof(a5metal_install_files) / sizeof(a5metal_install_files[0]); i++) {
+		const struct a5metal_install_file *file = &a5metal_install_files[i];
+		unsigned int packed = file->compressed_size ? file->compressed_size : file->size;
+		if (!a5metal_install_path_allowed(file->path) || !file->data) {
+			return EINVAL;
+		}
+		if (!file->size || file->size > A5METAL_INSTALL_FILE_MAX ||
+		    file->size > A5METAL_INSTALL_RAW_MAX - raw_total ||
+		    packed > A5METAL_INSTALL_PACKED_MAX - packed_total) {
+			return EFBIG;
+		}
+		raw_total += file->size;
+		packed_total += packed;
+		if (file->compressed_size) {
+			struct a5metal_install_stream stream;
+			int error = a5metal_install_stream_start(&stream, file);
+			if (error) {
+				return error;
+			}
+			unsigned int count;
+			const unsigned char *data;
+			do {
+				error = a5metal_install_stream_next(&stream, buffer, &data, &count);
+			} while (!error && count);
+			a5metal_install_stream_end(&stream);
+			if (error) {
+				return error;
+			}
+		}
+	}
+	printf("A5XELTE Metal install: payload raw=%u packed=%u preflight=0\n",
+	    raw_total, packed_total);
+	return 0;
+}
