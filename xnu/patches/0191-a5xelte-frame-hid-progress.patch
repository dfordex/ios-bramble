@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: MIT
+ * Bounded, read-only BGRA pixel sampling. No pixel values or screen content
+ * are logged; statistics distinguish black output from failed presentation.
+ */
+#ifndef A5XELTE_FRAME_PIXELS_H
+#define A5XELTE_FRAME_PIXELS_H
+#include <stdint.h>
+
+struct A5FramePixels {
+    uint32_t samples, rgbNonzero, alphaNonzero, rgbMismatch, alphaMismatch;
+};
+
+static inline bool a5frame_pixel_span(uint64_t bytes, uint32_t width,
+    uint32_t height, uint32_t stride)
+{
+    return width && height && width <= 16384 && height <= 16384 &&
+        (uint64_t)width * 4 <= stride &&
+        (uint64_t)(height - 1) * stride + (uint64_t)width * 4 <= bytes;
+}
+
+static inline bool a5frame_pixels(const void *input, uint64_t bytes,
+    uint32_t width, uint32_t height, uint32_t stride, const void *comparison,
+    uint64_t comparisonBytes, uint32_t comparisonStride, A5FramePixels *out)
+{
+    if (!out) return false;
+    *out = {};
+    if (!input || !a5frame_pixel_span(bytes,width,height,stride) ||
+        (comparison && !a5frame_pixel_span(comparisonBytes,width,height,comparisonStride)))
+        return false;
+    const uint8_t *src = static_cast<const uint8_t *>(input);
+    const uint8_t *cmp = static_cast<const uint8_t *>(comparison);
+    const uint32_t nx = width < 64 ? width : 64;
+    const uint32_t ny = height < 64 ? height : 64;
+    for (uint32_t iy=0; iy<ny; ++iy) {
+        const uint32_t y = ny == 1 ? 0 : (uint64_t)iy * (height-1) / (ny-1);
+        for (uint32_t ix=0; ix<nx; ++ix) {
+            const uint32_t x = nx == 1 ? 0 : (uint64_t)ix * (width-1) / (nx-1);
+            uint32_t value=0, other=0;
+            __builtin_memcpy(&value,src+(uint64_t)y*stride+(uint64_t)x*4,4);
+            ++out->samples;
+            out->rgbNonzero += (value & 0x00ffffffu) != 0;
+            out->alphaNonzero += (value >> 24) != 0;
+            if (cmp) {
+                __builtin_memcpy(&other,cmp+(uint64_t)y*comparisonStride+(uint64_t)x*4,4);
+                out->rgbMismatch += ((value ^ other) & 0x00ffffffu) != 0;
+                out->alphaMismatch += ((value ^ other) >> 24) != 0;
+            }
+        }
+    }
+    return true;
+}
+#endif
