+/* Bit n of the result is key n's raw pin level. */
+static uint8_t
+a5_keys_sample(void)
+{
+	uint8_t sample = 0;
+	for (unsigned key = 0; key < 4; key++) {
+		if (a5_keys_read(a5_key_pins[key].dat) & (1u << a5_key_pins[key].pin)) {
+			sample |= (uint8_t)(1u << key);
+		}
+	}
+	return sample;
+}
