diff --git a/pexpert/pexpert/arm64/A5XELTE.h b/pexpert/pexpert/arm64/A5XELTE.h
index e6718d4..f470c20 100644
--- a/pexpert/pexpert/arm64/A5XELTE.h
+++ b/pexpert/pexpert/arm64/A5XELTE.h
@@ -24,6 +24,18 @@
 #define HAS_GIC_V3                    0
 #define A5XELTE_VTIMER_INTID         27
 
+/*
+ * Samsung Galaxy A7 (2017), SM-A720F (a7y17lte, Exynos 7880) build of this
+ * port. Same S-Boot handoff, GIC-400 (address from the ADT), 26 MHz timer,
+ * A53 MPIDR layout, DesignWare eMMC at 0x13540000, framebuffer at
+ * 0x67000000 and loader log page at 0x469ff000 as the A5. What differs:
+ * keys are on the ALIVE pin controller at 0x139f0000 (GPA0/GPA1/GPA2), and
+ * touch is a Melfas MMS449 on i2c@13890000, so the A5 ZT7538/S2MPU03 probe
+ * (whose 0x104e0000 block does not exist here) stays off by default.
+ */
+#define A720F                         1
+#define A5_TOUCH_DEFAULT              0
+
 #ifndef ASSEMBLER
 #define PLATFORM_PANIC_LOG_DISABLED
 #endif
