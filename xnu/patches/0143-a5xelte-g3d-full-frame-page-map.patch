diff --git a/iokit/Kernel/arm/A5XELTEGPUFrameMap.cpp b/iokit/Kernel/arm/A5XELTEGPUFrameMap.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/A5XELTEGPUFrameMap.cpp
@@ -0,0 +1,285 @@
+/* Bounded 1080x1920 BGRA resource mapping for the private Mali-T720 AS0.
+ * The existing 16-KiB descriptor fixture remains at 0x02000000. Four new
+ * L3 tables cover the source and four cover the panel, with no broad
+ * identity map and no user-provided GPU page-table entries.
+ */
+#include "A5XELTEGPUFrameMap.h"
+
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+#include "A5XELTEGPUQueue.h"
+#include "A5XELTEGPUResources.h"
+#include "SweetSurface.h"
+#include <IOKit/IOLib.h>
+
+static const uint32_t kA5G3DPageBytes = 4096;
+static const uint32_t kA5G3DSourcePages =
+    kA5G3DFrameSourceBytes / kA5G3DPageBytes;
+static const uint32_t kA5G3DPanelPages =
+    kA5G3DFramePanelBytes / kA5G3DPageBytes;
+static const uint32_t kA5G3DL3Entries = 512;
+static const uint32_t kA5G3DL3TablesPerFrame = 4;
+static const uint32_t kA5G3DSourceTablesOffset = 0x8000;
+static const uint32_t kA5G3DPanelTablesOffset = 0xc000;
+static const uint64_t kA5G3DPanelPhysical = 0x67000000ULL;
+static const uint64_t kA5G3DPageDescriptor = 0x2c1ULL;
+static const uint32_t kA5G3DBGRA = 0x42475241;
+static_assert(kA5G3DFrameSourceBytes % kA5G3DPageBytes == 0 &&
+    kA5G3DFramePanelBytes % kA5G3DPageBytes == 0,
+    "both frame regions must end at page boundaries");
+static_assert(kA5G3DSourcePages == 2040 &&
+    kA5G3DPanelPages == 2025 &&
+    kA5G3DSourcePages <= kA5G3DL3Entries * kA5G3DL3TablesPerFrame &&
+    kA5G3DPanelPages <= kA5G3DL3Entries * kA5G3DL3TablesPerFrame,
+    "four page tables must cover each bounded frame region");
+static_assert(kA5G3DPanelTablesOffset +
+    kA5G3DL3TablesPerFrame * kA5G3DPageBytes == 0x10000,
+    "L3 tables must fit the private pinned backing");
+
+/* Only one composite transaction may mutate AS0. If a TLB flush becomes
+ * ambiguous, both source descriptors remain retained and the queue is
+ * permanently poisoned for this boot.
+ */
+static SweetSurface *gA5G3DMappedSource = nullptr;
+static SweetSurface *gA5G3DUncertainSource = nullptr;
+static bool gA5G3DFrameMapValid = false;
+static uint64_t gA5G3DFrameMapCount = 0;
+
+static uint32_t
+a5g3d_mmio_read(vm_offset_t gpu, uint32_t offset)
+{
+    return *reinterpret_cast<volatile uint32_t *>(gpu + offset);
+}
+
+static void
+a5g3d_mmio_write(vm_offset_t gpu, uint32_t offset, uint32_t value)
+{
+    *reinterpret_cast<volatile uint32_t *>(gpu + offset) = value;
+}
+
+static bool
+a5g3d_mmu_wait_ready(vm_offset_t gpu)
+{
+    for (unsigned i = 0; i < 10000; ++i) {
+        if (!(a5g3d_mmio_read(gpu, 0x2428) & 1u))
+            return true;
+        IODelay(10);
+    }
+    return false;
+}
+
+static bool
+a5g3d_mmu_flush_frame_tables(vm_offset_t gpu)
+{
+    if (!a5g3d_mmu_wait_ready(gpu) ||
+        a5g3d_mmio_read(gpu, 0x2000) ||
+        a5g3d_mmio_read(gpu, 0x241c))
+        return false;
+    /* Panfrost lock_region: 0..128 MiB is one aligned block, width 26.
+     * It contains the original fixture and both fixed 8-MiB frame windows.
+     * The job queue is reserved and idle throughout this operation.
+     */
+    a5g3d_mmio_write(gpu, 0x2410, 26u);
+    a5g3d_mmio_write(gpu, 0x2414, 0u);
+    __sync_synchronize();
+    a5g3d_mmio_write(gpu, 0x2418, 2u); /* AS_COMMAND_LOCK */
+    if (!a5g3d_mmu_wait_ready(gpu))
+        return false;
+    a5g3d_mmio_write(gpu, 0x2418, 4u); /* AS_COMMAND_FLUSH_PT */
+    return a5g3d_mmu_wait_ready(gpu) &&
+        !a5g3d_mmio_read(gpu, 0x2000) &&
+        !a5g3d_mmio_read(gpu, 0x241c);
+}
+
+static bool
+a5g3d_frame_geometry_valid(const SweetSurface *surface)
+{
+    return surface && surface->memory &&
+        surface->pixelFormat == kA5G3DBGRA &&
+        surface->width == kA5G3DFrameWidth &&
+        surface->height == kA5G3DFrameHeight &&
+        surface->bytesPerRow == kA5G3DFrameSourceStride &&
+        surface->offset == 0 && surface->planeCount == 0 &&
+        surface->bytesPerElement == 4 &&
+        surface->elementWidth == 1 && surface->elementHeight == 1 &&
+        surface->allocSize >= kA5G3DFrameSourceBytes &&
+        surface->memory->getLength() >= kA5G3DFrameSourceBytes &&
+        OSDynamicCast(IOBufferMemoryDescriptor, surface->memory) != nullptr;
+}
+
+static bool
+a5g3d_frame_populate_tables(SweetSurface *source,
+    IOBufferMemoryDescriptor *backing, uint8_t *bytes, bool *changed)
+{
+    *changed = false;
+    IOByteCount backingSpan = 0;
+    const uint64_t backingPhysical = backing->getPhysicalSegment(0,
+        &backingSpan, kIOMemoryMapperNone);
+    if (!backingPhysical || (backingPhysical & 0xfff) ||
+        backingSpan < 0x10000 || backing->getLength() < 0x10000)
+        return false;
+
+    /* Validate every physical page before touching live page tables. The
+     * retained IOSurface's IOBuffer allocation pins these pages for DMA.
+     */
+    for (uint32_t page = 0; page < kA5G3DSourcePages; ++page) {
+        IOByteCount span = 0;
+        const uint64_t physical = source->memory->getPhysicalSegment(
+            page * kA5G3DPageBytes, &span, kIOMemoryMapperNone);
+        if (!physical || (physical & 0xfff) || span < kA5G3DPageBytes ||
+            physical > 0xffffefffULL ||
+            (physical >= kA5G3DPanelPhysical &&
+             physical < kA5G3DPanelPhysical + kA5G3DFramePanelBytes))
+            return false;
+    }
+    if (source->memory->performOperation(kIOMemoryIncoherentIOStore,
+        0, kA5G3DFrameSourceBytes) != kIOReturnSuccess)
+        return false;
+
+    uint64_t *l2 = reinterpret_cast<uint64_t *>(bytes + 0x2000);
+    uint64_t *sourceL3 = reinterpret_cast<uint64_t *>(bytes +
+        kA5G3DSourceTablesOffset);
+    uint64_t *panelL3 = reinterpret_cast<uint64_t *>(bytes +
+        kA5G3DPanelTablesOffset);
+    *changed = true;
+    bzero(sourceL3, kA5G3DL3TablesPerFrame * kA5G3DPageBytes);
+    bzero(panelL3, kA5G3DL3TablesPerFrame * kA5G3DPageBytes);
+    for (uint32_t page = 0; page < kA5G3DSourcePages; ++page) {
+        IOByteCount span = 0;
+        const uint64_t physical = source->memory->getPhysicalSegment(
+            page * kA5G3DPageBytes, &span, kIOMemoryMapperNone);
+        /* The source is a retained, pinned IOBuffer, so this validated
+         * page-to-physical mapping cannot change between the two passes.
+         */
+        sourceL3[page] = physical | kA5G3DPageDescriptor;
+    }
+    for (uint32_t page = 0; page < kA5G3DPanelPages; ++page)
+        panelL3[page] = (kA5G3DPanelPhysical +
+            page * kA5G3DPageBytes) | kA5G3DPageDescriptor;
+    for (uint32_t table = 0; table < kA5G3DL3TablesPerFrame; ++table) {
+        l2[(kA5G3DFrameSourceVA >> 21) + table] =
+            (backingPhysical + kA5G3DSourceTablesOffset +
+             table * kA5G3DPageBytes) | 3u;
+        l2[(kA5G3DFramePanelVA >> 21) + table] =
+            (backingPhysical + kA5G3DPanelTablesOffset +
+             table * kA5G3DPageBytes) | 3u;
+    }
+    if (backing->performOperation(kIOMemoryIncoherentIOStore, 0,
+        0x10000) != kIOReturnSuccess)
+        return false;
+    __sync_synchronize();
+    return true;
+}
+
+A5G3DFrameMapStatus
+a5g3d_frame_map_begin(SweetSurface *source, A5G3DFrameMapLease *lease)
+{
+    if (!lease)
+        return kA5G3DFrameMapUnsupported;
+    bzero(lease, sizeof(*lease));
+    if (!a5g3d_frame_geometry_valid(source))
+        return kA5G3DFrameMapUnsupported;
+    source->retain();
+    if (!a5g3d_resource_fixture_begin()) {
+        source->release();
+        return kA5G3DFrameMapBusy;
+    }
+    IOService *owner = nullptr;
+    IOBufferMemoryDescriptor *backing = nullptr;
+    vm_offset_t gpu = 0;
+    uint64_t token = 0;
+    if (!a5g3d_queue_acquire_runtime(&owner, &token, &backing, &gpu)) {
+        a5g3d_resource_fixture_end();
+        source->release();
+        return kA5G3DFrameMapBusy;
+    }
+    A5G3DFrameMapStatus result = kA5G3DFrameMapReady;
+    bool modified = false;
+    do {
+        if (!backing || !gpu || !backing->getBytesNoCopy()) {
+            result = kA5G3DFrameMapUnsupported;
+            break;
+        }
+        if (gA5G3DFrameMapValid && gA5G3DMappedSource == source) {
+            if (source->memory->performOperation(kIOMemoryIncoherentIOStore,
+                0, kA5G3DFrameSourceBytes) != kIOReturnSuccess)
+                result = kA5G3DFrameMapIOError;
+            break;
+        }
+        uint8_t *bytes = static_cast<uint8_t *>(backing->getBytesNoCopy());
+        /* populate_tables validates all source segments and coherency before
+         * modifying the AS0 PTEs. Once it returns, even an error might have
+         * left new entries, so treat any such failure as ambiguous.
+         */
+        const bool populated = a5g3d_frame_populate_tables(source, backing,
+            bytes, &modified);
+        if (!populated || !a5g3d_mmu_flush_frame_tables(gpu)) {
+            result = modified ? kA5G3DFrameMapPoisoned :
+                kA5G3DFrameMapIOError;
+            break;
+        }
+        SweetSurface *old = gA5G3DMappedSource;
+        gA5G3DMappedSource = source;
+        gA5G3DFrameMapValid = true;
+        if (old)
+            old->release();
+        if (++gA5G3DFrameMapCount == 1 ||
+            (gA5G3DFrameMapCount & 0x7f) == 0)
+            IOLog("A5XELTE G3D: frame map %llu source=%u pages=%u panel=%u\n",
+                gA5G3DFrameMapCount, source->id,
+                kA5G3DSourcePages, kA5G3DPanelPages);
+    } while (false);
+
+    if (result == kA5G3DFrameMapReady) {
+        /* gMappedSource holds the long-lived retain; drop the temporary
+         * retain only on the fast path when the source did not change.
+         */
+        if (!modified)
+            source->release();
+        lease->owner = owner;
+        lease->backing = backing;
+        lease->gpuMMIO = gpu;
+        lease->token = token;
+        return result;
+    }
+    if (result == kA5G3DFrameMapPoisoned) {
+        gA5G3DUncertainSource = source; /* pinned until reboot */
+        a5g3d_queue_poison(owner, token);
+    } else {
+        a5g3d_queue_release(owner, token);
+        source->release();
+    }
+    owner->release();
+    a5g3d_resource_fixture_end();
+    return result;
+}
+
+bool
+a5g3d_frame_map_reacquire(A5G3DFrameMapLease *lease)
+{
+    if (!lease || !lease->owner || !lease->backing || !lease->gpuMMIO)
+        return false;
+    IOBufferMemoryDescriptor *backing = nullptr;
+    vm_offset_t gpu = 0;
+    uint64_t token = 0;
+    if (!a5g3d_queue_acquire(lease->owner, &token, &backing, &gpu))
+        return false;
+    if (backing != lease->backing || gpu != lease->gpuMMIO) {
+        a5g3d_queue_release(lease->owner, token);
+        return false;
+    }
+    lease->token = token;
+    return true;
+}
+
+void
+a5g3d_frame_map_end(A5G3DFrameMapLease *lease)
+{
+    if (!lease || !lease->owner)
+        return;
+    if (lease->token)
+        a5g3d_queue_release(lease->owner, lease->token);
+    lease->owner->release();
+    bzero(lease, sizeof(*lease));
+    a5g3d_resource_fixture_end();
+}
+#endif /* ARM64_BOARD_CONFIG_A5XELTE */
diff --git a/iokit/Kernel/arm/A5XELTEGPUFrameMap.h b/iokit/Kernel/arm/A5XELTEGPUFrameMap.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/A5XELTEGPUFrameMap.h
@@ -0,0 +1,55 @@
+/* Fixed, kernel-private Mali AS0 mapping for one a5xelte BGRA frame.
+ * This is neither an IOGPU user client nor an iOS rendering implementation.
+ */
+#ifndef _A5XELTE_GPU_FRAME_MAP_H_
+#define _A5XELTE_GPU_FRAME_MAP_H_
+
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOService.h>
+
+class SweetSurface;
+
+static const uint32_t kA5G3DFrameWidth = 1080;
+static const uint32_t kA5G3DFrameHeight = 1920;
+static const uint32_t kA5G3DFrameSourceStride = 4352;
+static const uint32_t kA5G3DFrameSourceBytes =
+    kA5G3DFrameHeight * kA5G3DFrameSourceStride;
+static const uint32_t kA5G3DFramePanelStride = 4320;
+static const uint32_t kA5G3DFramePanelBytes =
+    kA5G3DFrameHeight * kA5G3DFramePanelStride;
+static const uint64_t kA5G3DFrameSourceVA = 0x04000000ULL;
+static const uint64_t kA5G3DFramePanelVA = 0x05000000ULL;
+
+enum A5G3DFrameMapStatus {
+    kA5G3DFrameMapReady = 0,
+    kA5G3DFrameMapBusy,
+    kA5G3DFrameMapUnsupported,
+    kA5G3DFrameMapIOError,
+    kA5G3DFrameMapPoisoned,
+};
+
+/* Begin holds the 0142 composite lock through all tiler/fragment fences.
+ * Caller owns a retained SweetSurface until this function returns. On
+ * success the mapper retains the source until a later safe remap or reboot.
+ * The caller must have a completed CPU/producer write fence and must keep
+ * source contents unchanged until its final GPU completion fence. The
+ * reservation token is consumed by queue_submit; call reacquire before a
+ * second job. End releases any unused reservation and the composite lock.
+ */
+struct A5G3DFrameMapLease {
+    IOService *owner;
+    IOBufferMemoryDescriptor *backing;
+    vm_offset_t gpuMMIO;
+    uint64_t token;
+};
+
+A5G3DFrameMapStatus a5g3d_frame_map_begin(SweetSurface *source,
+    A5G3DFrameMapLease *lease);
+bool a5g3d_frame_map_reacquire(A5G3DFrameMapLease *lease);
+void a5g3d_frame_map_end(A5G3DFrameMapLease *lease);
+
+#endif /* ARM64_BOARD_CONFIG_A5XELTE */
+#endif /* _A5XELTE_GPU_FRAME_MAP_H_ */
