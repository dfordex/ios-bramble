+/* A typed immutable stage cache, independent of the optional app gate. Only
+ * the root and immediate canonical identity directories are permitted. */
+#define A5METAL_COMPILED_ROOT "/private/var/tmp/a5mali-shader-compiled"
+static bool
+a5metal_install_compiled_path(const char *path, bool directory)
+{
+	const size_t root = sizeof(A5METAL_COMPILED_ROOT) - 1;
+	if (!path || strnlen(path, MAXPATHLEN) == MAXPATHLEN ||
+	    strncmp(path, A5METAL_COMPILED_ROOT, root)) {
+		return false;
+	}
+	if (!path[root]) {
+		return directory;
+	}
+	if (path[root] != '/') {
+		return false;
+	}
+	const char *identity = path + root + 1;
+	for (unsigned int i = 0; i < 64; i++) {
+		if (!((identity[i] >= '0' && identity[i] <= '9') ||
+		    (identity[i] >= 'a' && identity[i] <= 'f'))) {
+			return false;
+		}
+	}
+	if (directory) {
+		return !identity[64];
+	}
+	if (identity[64] != '/') {
+		return false;
+	}
+	const char *name = identity + 65;
+	return !strcmp(name, "receipt.json") || !strcmp(name, "reflection.json") ||
+	       !strcmp(name, "stage.midgard");
+}
+#if defined(A5METAL_COMPILED_DIRECTORIES_PRESENT)
+static bool
+a5metal_install_compiled_parent(const char *path)
+{
+	const char *slash = strrchr(path, '/');
+	if (!slash) {
+		return false;
+	}
+	size_t size = (size_t)(slash - path);
+	for (unsigned int i = 0; i < sizeof(a5metal_install_compiled_directories) /
+	    sizeof(a5metal_install_compiled_directories[0]); i++) {
+		const char *parent = a5metal_install_compiled_directories[i].path;
+		if (parent && strlen(parent) == size && !strncmp(parent, path, size)) {
+			return true;
+		}
+	}
+	return false;
+}
+#endif
