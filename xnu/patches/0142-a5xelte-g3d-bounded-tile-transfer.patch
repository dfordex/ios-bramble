- * Destination must remain live through the queue's completion fence. A
- * submission timeout keeps that backing pinned for the rest of this boot.
+ * The only accepted destinationOffset is 0x4a00, the validated texel slot
+ * in the private AS0 fixture. Destination must remain live through the
+ * queue's completion fence. A submission timeout keeps that backing pinned
+ * for the rest of this boot.
  * The imported surface itself can be released after this snapshot returns.
  */
 A5G3DResourceStatus a5g3d_resource_stage_bgra16(
     const A5G3DImportedSurface *resource, uint32_t x, uint32_t y,
     IOBufferMemoryDescriptor *backing, uint32_t destinationOffset);
 
+/*
+ * Serialize composite fixture operations across both tiler and fragment
+ * fences. Every caller that mutates the shared a5gpu=8 descriptor backing
+ * must hold this lock until its last GPU job has finished. Never sleep
+ * while holding it; the queue's finite hardware polls are permitted.
+ */
+bool a5g3d_resource_fixture_begin();
+void a5g3d_resource_fixture_end();
+
 /* One opt-in first-swap hardware diagnostic for a5gpu=8. */
 void a5g3d_resource_probe_swap(uint32_t surfaceID);
 
