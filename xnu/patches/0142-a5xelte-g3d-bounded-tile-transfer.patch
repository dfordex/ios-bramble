diff --git a/iokit/Kernel/arm/A5XELTEGPUTransfer.h b/iokit/Kernel/arm/A5XELTEGPUTransfer.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/A5XELTEGPUTransfer.h
@@ -0,0 +1,46 @@
+/* Private bounded transfer from a retained IOSurface to the Mali test queue.
+ * This is a kernel API, not an IOAccelerator/IOGPU user-client ABI.
+ */
+#ifndef _A5XELTE_GPU_TRANSFER_H_
+#define _A5XELTE_GPU_TRANSFER_H_
+
+#include "A5XELTEGPUResources.h"
+
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+
+enum { kA5G3DTransferTilePixels = 16 * 16 };
+
+enum A5G3DTransferStatus {
+    kA5G3DTransferCompleted,
+    kA5G3DTransferInvalid,
+    kA5G3DTransferUnsupported,
+    kA5G3DTransferBusy,
+    kA5G3DTransferIOError,
+    kA5G3DTransferTimeout,
+    kA5G3DTransferFault,
+    kA5G3DTransferMismatch,
+};
+
+struct A5G3DTransferResult {
+    uint64_t tilerFence;
+    uint64_t fragmentFence;
+    uint32_t matchingPixels;
+};
+
+/*
+ * Sample one exact 16x16 BGRA tile using the kernel-built Mali descriptor
+ * fixture. The source is copied to the queue's pinned AS0 window before
+ * either job. Output becomes valid only after both hardware fences, CPU
+ * cache invalidation, and an exact 256-pixel comparison against the source
+ * snapshot. The queue keeps its GPU-visible pages pinned after a timeout.
+ *
+ * This is a correctness primitive, not an accelerated whole-frame path.
+ * It performs a CPU copy into and out of the GPU-owned 16-KiB window.
+ */
+A5G3DTransferStatus a5g3d_transfer_sample_bgra16(
+    const A5G3DImportedSurface *source, uint32_t x, uint32_t y,
+    uint32_t output[kA5G3DTransferTilePixels],
+    A5G3DTransferResult *result);
+
+#endif /* ARM64_BOARD_CONFIG_A5XELTE */
+#endif /* _A5XELTE_GPU_TRANSFER_H_ */
diff --git a/iokit/Kernel/arm/A5XELTEGPUTransfer.cpp b/iokit/Kernel/arm/A5XELTEGPUTransfer.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/A5XELTEGPUTransfer.cpp
@@ -0,0 +1,182 @@
+/*
+ * One serialized, exact-size BGRA texture transfer through Mali-T720.
+ * The descriptors were built by the private a5gpu=8 startup fixture. A
+ * caller cannot choose a Mali virtual address, shader, job or page table.
+ */
+#include "A5XELTEGPUTransfer.h"
+
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+#include "A5XELTEGPUQueue.h"
+#include "SweetSurface.h"
+#include <IOKit/IOLib.h>
+
+static const uint32_t kA5G3DDataOffset = 0x4000;
+static const uint32_t kA5G3DTexelOffset = 0x0a00;
+static const uint32_t kA5G3DPolygonOffset = 0x1000;
+static const uint32_t kA5G3DOutputOffset = 0x2000;
+static const uint32_t kA5G3DGPUWindowBytes = 0x4000;
+static const uint32_t kA5G3DTileBytes =
+    kA5G3DTransferTilePixels * sizeof(uint32_t);
+
+static_assert(kA5G3DTexelOffset + kA5G3DTileBytes <=
+    kA5G3DPolygonOffset, "source tile must not overlap polygon list");
+static_assert(kA5G3DOutputOffset + kA5G3DTileBytes <=
+    kA5G3DGPUWindowBytes, "output tile must fit mapped AS0 window");
+
+static A5G3DTransferStatus
+a5g3d_stage_status(A5G3DResourceStatus status)
+{
+    switch (status) {
+    case kA5G3DResourceReady:
+        return kA5G3DTransferCompleted;
+    case kA5G3DResourceUnsupported:
+        return kA5G3DTransferUnsupported;
+    case kA5G3DResourceNoMemory:
+    case kA5G3DResourceIOError:
+        return kA5G3DTransferIOError;
+    default:
+        return kA5G3DTransferInvalid;
+    }
+}
+
+static A5G3DTransferStatus
+a5g3d_queue_status(A5G3DQueueStatus status)
+{
+    switch (status) {
+    case kA5G3DQueueCompleted:
+        return kA5G3DTransferCompleted;
+    case kA5G3DQueueBusy:
+        return kA5G3DTransferBusy;
+    case kA5G3DQueueInvalid:
+        return kA5G3DTransferInvalid;
+    case kA5G3DQueueTimeout:
+        return kA5G3DTransferTimeout;
+    default:
+        return kA5G3DTransferFault;
+    }
+}
+
+A5G3DTransferStatus
+a5g3d_transfer_sample_bgra16(const A5G3DImportedSurface *source,
+    uint32_t x, uint32_t y,
+    uint32_t output[kA5G3DTransferTilePixels],
+    A5G3DTransferResult *result)
+{
+    if (result)
+        bzero(result, sizeof(*result));
+    if (!source || !source->surface || !output)
+        return kA5G3DTransferInvalid;
+    if (!a5g3d_resource_fixture_begin())
+        return kA5G3DTransferBusy;
+
+    IOService *owner = nullptr;
+    IOBufferMemoryDescriptor *backing = nullptr;
+    vm_offset_t gpu = 0;
+    uint64_t token = 0;
+    if (!a5g3d_queue_acquire_runtime(&owner, &token, &backing, &gpu)) {
+        a5g3d_resource_fixture_end();
+        return kA5G3DTransferBusy;
+    }
+
+    bool reserved = true;
+    A5G3DTransferStatus status = kA5G3DTransferIOError;
+    do {
+        if (!backing || !backing->getBytesNoCopy() ||
+            backing->getLength() < kA5G3DDataOffset + kA5G3DGPUWindowBytes ||
+            !gpu) {
+            status = kA5G3DTransferInvalid;
+            break;
+        }
+        uint8_t *bytes = static_cast<uint8_t *>(backing->getBytesNoCopy());
+        status = a5g3d_stage_status(a5g3d_resource_stage_bgra16(
+            source, x, y, backing, kA5G3DDataOffset + kA5G3DTexelOffset));
+        if (status != kA5G3DTransferCompleted)
+            break;
+
+        /* One fixed descriptor set, one tile and one owner at a time. The
+         * source snapshot is immutable until the fragment fence completes.
+         * The polygon list is GPU-written by the tiler and CPU-invalidated
+         * before the fragment job can consume it.
+         */
+        uint32_t expected[kA5G3DTransferTilePixels];
+        memcpy(expected, bytes + kA5G3DDataOffset + kA5G3DTexelOffset,
+            sizeof(expected));
+        bzero(bytes + kA5G3DDataOffset + kA5G3DPolygonOffset, 4096);
+        reinterpret_cast<uint32_t *>(bytes + kA5G3DDataOffset +
+            kA5G3DPolygonOffset)[128] = 0xa0000000;
+        bzero(bytes + kA5G3DDataOffset + kA5G3DOutputOffset,
+            kA5G3DTileBytes);
+        bzero(bytes + kA5G3DDataOffset + 0x300, 16); /* tiler status */
+        bzero(bytes + kA5G3DDataOffset, 16);         /* fragment status */
+
+        const uint32_t shader =
+            *reinterpret_cast<volatile uint32_t *>(gpu + 0x140);
+        if (!shader) {
+            status = kA5G3DTransferFault;
+            break;
+        }
+        A5G3DQueueRequest tiler = {};
+        tiler.slot = 1;
+        tiler.jobOffset = 0x300;
+        tiler.shaderMask = shader;
+        tiler.reservationToken = token;
+        A5G3DQueueCompletion tilerDone = {};
+        reserved = false; /* submit consumes the reservation on acceptance */
+        status = a5g3d_queue_status(a5g3d_queue_submit(owner, gpu, backing,
+            bytes, tiler, &tilerDone));
+        if (status != kA5G3DTransferCompleted) {
+            a5g3d_queue_release(owner, token);
+            break;
+        }
+        if (result)
+            result->tilerFence = tilerDone.fence;
+        if (backing->performOperation(kIOMemoryIncoherentIOFlush,
+            kA5G3DDataOffset + kA5G3DPolygonOffset, 4096) !=
+            kIOReturnSuccess) {
+            status = kA5G3DTransferIOError;
+            break;
+        }
+        if (!a5g3d_queue_acquire(owner, &token, &backing, &gpu)) {
+            status = kA5G3DTransferBusy;
+            break;
+        }
+        reserved = true;
+        bytes = static_cast<uint8_t *>(backing->getBytesNoCopy());
+        A5G3DQueueRequest fragment = {};
+        fragment.slot = 0;
+        fragment.jobOffset = 0;
+        fragment.shaderMask = shader;
+        fragment.readbackOffset = kA5G3DOutputOffset;
+        fragment.readbackLength = kA5G3DTileBytes;
+        fragment.reservationToken = token;
+        A5G3DQueueCompletion fragmentDone = {};
+        reserved = false;
+        status = a5g3d_queue_status(a5g3d_queue_submit(owner, gpu, backing,
+            bytes, fragment, &fragmentDone));
+        if (status != kA5G3DTransferCompleted) {
+            a5g3d_queue_release(owner, token);
+            break;
+        }
+        if (result)
+            result->fragmentFence = fragmentDone.fence;
+        const uint32_t *pixels = reinterpret_cast<const uint32_t *>(
+            bytes + kA5G3DDataOffset + kA5G3DOutputOffset);
+        uint32_t matching = 0;
+        for (unsigned i = 0; i < kA5G3DTransferTilePixels; ++i)
+            matching += pixels[i] == expected[i];
+        if (result)
+            result->matchingPixels = matching;
+        if (matching != kA5G3DTransferTilePixels) {
+            status = kA5G3DTransferMismatch;
+            break;
+        }
+        memcpy(output, pixels, kA5G3DTileBytes);
+    } while (false);
+
+    if (reserved)
+        a5g3d_queue_release(owner, token);
+    owner->release();
+    a5g3d_resource_fixture_end();
+    return status;
+}
+#endif /* ARM64_BOARD_CONFIG_A5XELTE */
