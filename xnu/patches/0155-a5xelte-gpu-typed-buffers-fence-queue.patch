+static uint64_t *
+a5g3d_as1_buffer_pte(A5G3DAS1Context *ctx, uint32_t slot)
+{
+    uint8_t *tables = static_cast<uint8_t *>(ctx->tables->getBytesNoCopy());
+    return reinterpret_cast<uint64_t *>(tables +
+        (kAS1BufferTablePage + slot / 2) * kAS1Page) +
+        (slot % 2) * (kAS1BufferWindow / kAS1Page);
+}
+
+bool
+a5g3d_as1_map_buffer(A5G3DAS1Context *ctx, uint32_t slot,
+    IOBufferMemoryDescriptor *buffer, uint32_t bytes)
+{
+    if (!ctx || slot >= kAS1BufferSlots || !buffer || !bytes ||
+        (bytes & (kAS1Page - 1)) || bytes > kAS1BufferWindow ||
+        bytes > buffer->getLength() || !buffer->getBytesNoCopy())
+        return false;
+    for (uint32_t offset = 0; offset < bytes; offset += kAS1Page) {
+        IOByteCount span = 0;
+        const uint64_t physical = buffer->getPhysicalSegment(offset,
+            &span, kIOMemoryMapperNone);
+        if (!physical || (physical & (kAS1Page - 1)) ||
+            span < kAS1Page || physical > 0xffffefffULL ||
+            (physical >= 0x67000000ULL && physical < 0x67800000ULL))
+            return false;
+    }
+    IOLock *lock = a5g3d_as1_lock();
+    IOLockLock(lock);
+    if (gAS1Owner != ctx || ctx->poisoned || ctx->buffer[slot]) {
+        IOLockUnlock(lock);
+        return false;
+    }
+    buffer->retain();
+    uint64_t *pte = a5g3d_as1_buffer_pte(ctx, slot);
+    for (uint32_t offset = 0; offset < bytes; offset += kAS1Page) {
+        IOByteCount span = 0;
+        pte[offset / kAS1Page] = buffer->getPhysicalSegment(offset,
+            &span, kIOMemoryMapperNone) | kAS1PageDescriptor;
+    }
+    ctx->buffer[slot] = buffer;
+    ctx->bufferBytes[slot] = bytes;
+    const A5G3DAS1Update update = a5g3d_as1_update(ctx, false);
+    if (update == kAS1UpdateBusy) {
+        bzero(pte, kAS1BufferWindow / kAS1Page * sizeof(*pte));
+        ctx->buffer[slot] = nullptr;
+        ctx->bufferBytes[slot] = 0;
+        buffer->release();
+    } else if (update != kAS1UpdateApplied)
+        ctx->poisoned = true;
+    else
+        ctx->installed = true;
+    IOLockUnlock(lock);
+    return update == kAS1UpdateApplied;
+}
+
+bool
+a5g3d_as1_unmap_buffer(A5G3DAS1Context *ctx, uint32_t slot)
+{
+    if (!ctx || slot >= kAS1BufferSlots)
+        return false;
+    IOLock *lock = a5g3d_as1_lock();
+    IOLockLock(lock);
+    if (gAS1Owner != ctx || ctx->poisoned || !ctx->buffer[slot]) {
+        IOLockUnlock(lock);
+        return false;
+    }
+    uint64_t *pte = a5g3d_as1_buffer_pte(ctx, slot);
+    bzero(pte, kAS1BufferWindow / kAS1Page * sizeof(*pte));
+    const A5G3DAS1Update update = a5g3d_as1_update(ctx, false);
+    if (update == kAS1UpdateBusy) {
+        IOBufferMemoryDescriptor *buffer = ctx->buffer[slot];
+        for (uint32_t offset = 0; offset < ctx->bufferBytes[slot];
+            offset += kAS1Page) {
+            IOByteCount span = 0;
+            pte[offset / kAS1Page] = buffer->getPhysicalSegment(offset,
+                &span, kIOMemoryMapperNone) | kAS1PageDescriptor;
+        }
+    } else if (update != kAS1UpdateApplied)
+        ctx->poisoned = true;
+    else {
+        ctx->buffer[slot]->release();
+        ctx->buffer[slot] = nullptr;
+        ctx->bufferBytes[slot] = 0;
+    }
+    IOLockUnlock(lock);
+    return update == kAS1UpdateApplied;
+}
