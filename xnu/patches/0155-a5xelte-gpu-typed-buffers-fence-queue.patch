+static inline bool a5gpu_buffer_token_slot(uint64_t token,
+    uint32_t *slot)
+{
+    const uint32_t low = static_cast<uint32_t>(token);
+    if (!slot || !static_cast<uint32_t>(token >> 32) ||
+        low < kA5GPUClientBufferHandleBase ||
+        low >= kA5GPUClientBufferHandleBase + kA5GPUClientBufferSlots)
+        return false;
+    *slot = low - kA5GPUClientBufferHandleBase;
+    return true;
+}
+
+static inline bool a5gpu_buffer_access_valid(uint32_t offset,
+    uint32_t length, uint32_t allocated, uint32_t usage,
+    uint32_t requiredUsage)
+{
+    return length && length <= kA5GPUClientBufferTransferMax &&
+        (usage & requiredUsage) == requiredUsage &&
+        offset <= allocated && length <= allocated - offset;
+}
