+    result.flags = usage;
+    memcpy(args->structureOutput, &result, sizeof(result));
+    args->structureOutputSize = sizeof(result);
+    return kIOReturnSuccess;
+}
+
+IOReturn
+A5XELTEGPUUserClient::unmapBuffer(IOExternalMethodArguments *args)
+{
+    if (!a5gpu_valid_input(args, sizeof(A5GPUClientUnmapRequest)) ||
+        args->structureOutputSize != 0)
+        return kIOReturnBadArgument;
+    A5GPUClientUnmapRequest request = {};
+    memcpy(&request, args->structureInput, sizeof(request));
+    if (!a5gpu_valid_header(&request.header, sizeof(request)))
+        return kIOReturnUnsupported;
+    uint32_t slot = 0;
+    if (!a5gpu_buffer_token_slot(request.mappingToken, &slot))
+        return kIOReturnBadArgument;
+    IOLockLock(fLock);
+    BufferSlot &entry = fBuffers[slot];
+    if (fClosed || !entry.buffer || !entry.mapped || !fAS1 ||
+        entry.generation != static_cast<uint32_t>(request.mappingToken >> 32)) {
+        IOLockUnlock(fLock);
+        return kIOReturnNotFound;
+    }
+    const bool ok = a5g3d_as1_unmap_buffer(fAS1, slot);
+    if (ok)
+        entry.mapped = false;
+    IOLockUnlock(fLock);
+    return ok ? kIOReturnSuccess : kIOReturnError;
+}
+
+IOReturn
+A5XELTEGPUUserClient::submitAfter(IOExternalMethodArguments *args)
+{
+    if (!a5gpu_valid_input(args, sizeof(A5GPUClientSubmitAfterRequest)) ||
+        !args->structureOutput ||
+        args->structureOutputSize < sizeof(A5GPUClientSubmitResult))
+        return kIOReturnBadArgument;
+    A5GPUClientSubmitAfterRequest request = {};
+    memcpy(&request, args->structureInput, sizeof(request));
+    if (!a5gpu_valid_header(&request.header, sizeof(request)))
+        return kIOReturnUnsupported;
+    A5GPUClientBatchItemResult item = {};
+    IOLockLock(fLock);
+    if (request.dependencyFence && (!fAS1 ||
+        request.dependencyFence > a5g3d_as1_completed_fence(fAS1))) {
+        IOLockUnlock(fLock);
+        return kIOReturnNotReady;
+    }
+    const IOReturn ret = submitOneLocked(request.command, &item);
+    IOLockUnlock(fLock);
+    if (ret != kIOReturnSuccess)
+        return ret;
+    A5GPUClientSubmitResult result = {};
+    result.header.version = kA5GPUClientVersion;
+    result.header.size = sizeof(result);
+    result.status = item.status;
+    result.tilerFence = item.tilerFence;
+    result.fragmentFence = item.fragmentFence;
+    memcpy(args->structureOutput, &result, sizeof(result));
+    args->structureOutputSize = sizeof(result);
+    return kIOReturnSuccess;
+}
+
+IOReturn
+A5XELTEGPUUserClient::queryFence(IOExternalMethodArguments *args)
+{
+    if (!a5gpu_valid_input(args, sizeof(A5GPUClientHeader)) ||
+        !args->structureOutput ||
+        args->structureOutputSize < sizeof(A5GPUClientFenceResult))
+        return kIOReturnBadArgument;
+    A5GPUClientHeader request = {};
+    memcpy(&request, args->structureInput, sizeof(request));
+    if (!a5gpu_valid_header(&request, sizeof(request)))
+        return kIOReturnUnsupported;
+    A5GPUClientFenceResult result = {};
+    result.header.version = kA5GPUClientVersion;
+    result.header.size = sizeof(result);
+    IOLockLock(fLock);
+    result.completedFence = fClosed ? 0 : a5g3d_as1_completed_fence(fAS1);
+    IOLockUnlock(fLock);
+    memcpy(args->structureOutput, &result, sizeof(result));
+    args->structureOutputSize = sizeof(result);
+    return kIOReturnSuccess;
+}
+
+IOReturn
+A5XELTEGPUUserClient::transferBuffer(IOExternalMethodArguments *args,
+    bool write)
+{
+    if (!a5gpu_valid_input(args, sizeof(A5GPUClientBufferTransferRequest)) ||
+        (write && args->structureOutputSize != 0) ||
+        (!write && (!args->structureOutput ||
+        args->structureOutputSize < sizeof(A5GPUClientBufferReadResult))))
+        return kIOReturnBadArgument;
+    A5GPUClientBufferTransferRequest request = {};
+    memcpy(&request, args->structureInput, sizeof(request));
+    if (!a5gpu_valid_header(&request.header, sizeof(request)))
+        return kIOReturnUnsupported;
+    uint32_t slot = 0;
+    if (!a5gpu_buffer_token_slot(request.handle, &slot) ||
+        !request.length || request.length > kA5GPUClientBufferTransferMax)
+        return kIOReturnBadArgument;
+    A5GPUClientBufferReadResult result = {};
+    IOLockLock(fLock);
+    BufferSlot &entry = fBuffers[slot];
+    if (fClosed || !entry.buffer || entry.mapped ||
+        entry.generation != static_cast<uint32_t>(request.handle >> 32) ||
+        !a5gpu_buffer_access_valid(request.offset, request.length,
+            entry.bytes, entry.usage,
+            write ? kA5GPUClientWrite : kA5GPUClientRead)) {
+        IOLockUnlock(fLock);
+        return kIOReturnNotFound;
+    }
+    uint8_t *bytes = static_cast<uint8_t *>(entry.buffer->getBytesNoCopy());
+    if (!bytes) {
+        IOLockUnlock(fLock);
+        return kIOReturnError;
+    }
+    IOReturn status = kIOReturnSuccess;
+    if (write) {
+        memcpy(bytes + request.offset, request.bytes, request.length);
+        status = entry.buffer->performOperation(kIOMemoryIncoherentIOStore,
+            request.offset, request.length);
+    } else {
+        status = entry.buffer->performOperation(kIOMemoryIncoherentIOFlush,
+            request.offset, request.length);
+        if (status == kIOReturnSuccess)
+            memcpy(result.bytes, bytes + request.offset, request.length);
+    }
+    IOLockUnlock(fLock);
+    if (status != kIOReturnSuccess)
+        return status;
+    if (!write) {
+        result.header.version = kA5GPUClientVersion;
+        result.header.size = sizeof(result);
+        result.length = request.length;
+        memcpy(args->structureOutput, &result, sizeof(result));
+        args->structureOutputSize = sizeof(result);
+    }
+    return kIOReturnSuccess;
+}
