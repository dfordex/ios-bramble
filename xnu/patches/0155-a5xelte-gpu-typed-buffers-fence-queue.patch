+/* Distinct handle namespace from IOSurface textures. The kernel allocates
+ * and zeroes each pinned BO; neither its physical address nor AS1 VA is
+ * returned. Buffers are presently resources for future shader pipelines;
+ * the typed BGRA encoder cannot bind them to a draw. */
+struct A5GPUClientCreateBufferRequest {
+    A5GPUClientHeader header;
+    uint32_t bytes; /* page aligned, 4 KiB..1 MiB */
+    uint32_t usage; /* Read/Write; enforced by future typed operations */
+};
+struct A5GPUClientCreateBufferResult {
+    A5GPUClientHeader header;
+    uint64_t handle;
+    uint32_t bytes;
+    uint32_t usage;
+};
+/* Release uses A5GPUClientReleaseRequest. Map/unmap use existing map
+ * request/result structures and retain buffer pages through AS1 ownership. */
+struct A5GPUClientSubmitAfterRequest {
+    A5GPUClientHeader header;
+    A5GPUClientBatchCommand command;
+    uint64_t dependencyFence; /* zero or a fence completed on this AS1 */
+};
+struct A5GPUClientFenceResult {
+    A5GPUClientHeader header;
+    uint64_t completedFence;
+};
+enum { kA5GPUClientBufferTransferMax = 256 };
+struct A5GPUClientBufferTransferRequest {
+    A5GPUClientHeader header;
+    uint64_t handle;
+    uint32_t offset;
+    uint32_t length; /* 1..256; must fit allocated buffer */
+    uint8_t bytes[kA5GPUClientBufferTransferMax]; /* ignored for read */
+};
+struct A5GPUClientBufferReadResult {
+    A5GPUClientHeader header;
+    uint32_t length;
+    uint32_t reserved;
+    uint8_t bytes[kA5GPUClientBufferTransferMax];
+};
