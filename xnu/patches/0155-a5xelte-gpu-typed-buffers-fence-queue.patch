 IOReturn
+A5XELTEGPUUserClient::createBuffer(IOExternalMethodArguments *args)
+{
+    if (!a5gpu_valid_input(args, sizeof(A5GPUClientCreateBufferRequest)) ||
+        !args->structureOutput ||
+        args->structureOutputSize < sizeof(A5GPUClientCreateBufferResult))
+        return kIOReturnBadArgument;
+    A5GPUClientCreateBufferRequest request = {};
+    memcpy(&request, args->structureInput, sizeof(request));
+    if (!a5gpu_valid_header(&request.header, sizeof(request)))
+        return kIOReturnUnsupported;
+    if (request.bytes < 4096 || request.bytes > kA5GPUClientBufferMaxBytes ||
+        (request.bytes & 4095u) || !request.usage ||
+        (request.usage & ~(kA5GPUClientRead | kA5GPUClientWrite)))
+        return kIOReturnBadArgument;
+    IOBufferMemoryDescriptor *buffer = IOBufferMemoryDescriptor::withOptions(
+        kIODirectionInOut, request.bytes, 4096);
+    if (!buffer || !buffer->getBytesNoCopy()) {
+        if (buffer)
+            buffer->release();
+        return kIOReturnNoMemory;
+    }
+    bzero(buffer->getBytesNoCopy(), request.bytes);
+    if (buffer->performOperation(kIOMemoryIncoherentIOStore, 0,
+        request.bytes) != kIOReturnSuccess) {
+        buffer->release();
+        return kIOReturnError;
+    }
+    uint64_t handle = 0;
+    IOLockLock(fLock);
+    if (!fClosed) {
+        for (uint32_t i = 0; i < kA5GPUClientBufferSlots; ++i) {
+            if (!fBuffers[i].buffer) {
+                fBuffers[i].buffer = buffer;
+                fBuffers[i].bytes = request.bytes;
+                fBuffers[i].usage = request.usage;
+                fBuffers[i].mapped = false;
+                handle = (static_cast<uint64_t>(fBuffers[i].generation) << 32) |
+                    (kA5GPUClientBufferHandleBase + i);
+                break;
+            }
+        }
+    }
+    IOLockUnlock(fLock);
+    if (!handle) {
+        buffer->release();
+        return kIOReturnNoResources;
+    }
+    A5GPUClientCreateBufferResult result = {};
+    result.header.version = kA5GPUClientVersion;
+    result.header.size = sizeof(result);
+    result.handle = handle;
+    result.bytes = request.bytes;
+    result.usage = request.usage;
+    memcpy(args->structureOutput, &result, sizeof(result));
+    args->structureOutputSize = sizeof(result);
+    return kIOReturnSuccess;
+}
+
+IOReturn
+A5XELTEGPUUserClient::releaseBuffer(IOExternalMethodArguments *args)
+{
+    if (!a5gpu_valid_input(args, sizeof(A5GPUClientReleaseRequest)) ||
+        args->structureOutputSize != 0)
+        return kIOReturnBadArgument;
+    A5GPUClientReleaseRequest request = {};
+    memcpy(&request, args->structureInput, sizeof(request));
+    if (!a5gpu_valid_header(&request.header, sizeof(request)))
+        return kIOReturnUnsupported;
+    uint32_t slot = 0;
+    if (!a5gpu_buffer_token_slot(request.handle, &slot))
+        return kIOReturnBadArgument;
+    IOBufferMemoryDescriptor *buffer = nullptr;
+    IOLockLock(fLock);
+    BufferSlot &entry = fBuffers[slot];
+    if (!fClosed && entry.buffer &&
+        entry.generation == static_cast<uint32_t>(request.handle >> 32)) {
+        if (entry.mapped && (!fAS1 ||
+            !a5g3d_as1_unmap_buffer(fAS1, slot))) {
+            IOLockUnlock(fLock);
+            return kIOReturnError;
+        }
+        buffer = entry.buffer;
+        entry.buffer = nullptr;
+        entry.bytes = 0;
+        entry.usage = 0;
+        entry.mapped = false;
+        if (++entry.generation == 0)
+            entry.generation = 1;
+    }
+    IOLockUnlock(fLock);
+    if (!buffer)
+        return kIOReturnNotFound;
+    buffer->release();
+    return kIOReturnSuccess;
+}
