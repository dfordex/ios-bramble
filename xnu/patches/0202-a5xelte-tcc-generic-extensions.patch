--- /dev/null
+++ b/bsd/kern/a5xelte_sandbox_extensions.inc
@@ -0,0 +1,270 @@
+/* A5XELTE development Sandbox: bounded TCC generic extension transport.
+ * This supplies the token/handle contract to the already-permissive policy;
+ * it is not a production sandbox or a TCC authorization override.
+ * ABI verified against the device's 20H392 libsystem_sandbox.dylib.
+ */
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+#include <kern/locks.h>
+#include <stdint.h>
+#include <sys/random.h>
+#include <sys/time.h>
+
+#define A5_SB_SLOTS 1024
+#define A5_SB_ISSUER_LIMIT 256
+#define A5_SB_CONSUMER_LIMIT 128
+#define A5_SB_TOKEN_BYTES 72
+#define A5_SB_CLASS_BYTES 96
+#define A5_SB_PENDING_SECONDS 1800
+#define A5_SB_PUBLISHING 1
+#define A5_SB_ISSUED 2
+#define A5_SB_CONSUMING 3
+#define A5_SB_CONSUMED 4
+
+struct a5_sb_issue_args {
+    uint64_t extension_class, type, resource, flags, token, pid, pidversion;
+};
+struct a5_sb_consume_args { uint64_t token, length, handle; };
+struct a5_sb_release_args { uint64_t handle, reserved0, reserved1; };
+_Static_assert(sizeof(struct a5_sb_issue_args) == 56, "20H392 extension issue ABI");
+_Static_assert(sizeof(struct a5_sb_consume_args) == 24, "20H392 extension consume ABI");
+_Static_assert(sizeof(struct a5_sb_release_args) == 24, "20H392 extension release ABI");
+struct a5_sb_extension {
+    uint64_t issuer, consumer, generation, handle, created;
+    uint32_t pid, pidversion, refs, state;
+    char token[A5_SB_TOKEN_BYTES], extension_class[A5_SB_CLASS_BYTES];
+};
+static LCK_GRP_DECLARE(a5_sb_group, "a5-tcc-extensions");
+static LCK_MTX_DECLARE(a5_sb_lock, &a5_sb_group);
+static struct a5_sb_extension a5_sb_extensions[A5_SB_SLOTS];
+static uint64_t a5_sb_generation;
+static unsigned a5_sb_log_count;
+
+static uint64_t
+a5_sb_now(void)
+{
+    struct timeval tv;
+    microuptime(&tv);
+    return (uint64_t)tv.tv_sec;
+}
+
+static void
+a5_sb_log(const char *phase, const char *extension_class)
+{
+    bool emit;
+    lck_mtx_lock(&a5_sb_lock);
+    emit = a5_sb_log_count < 48;
+    if (emit) a5_sb_log_count++;
+    lck_mtx_unlock(&a5_sb_lock);
+    if (emit) printf("A5XELTE Sandbox extension: %s class=%s result=0\n",
+        phase, extension_class);
+}
+
+static bool
+a5_sb_class_valid(const char *s)
+{
+    const char prefix[] = "com.apple.tcc.kTCCService";
+    size_t n = sizeof(prefix) - 1;
+    if (strncmp(s, prefix, n) || !s[n]) return false;
+    for (; s[n]; n++) {
+        unsigned char c = (unsigned char)s[n];
+        if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+            (c >= '0' && c <= '9'))) return false;
+    }
+    return true;
+}
+
+static bool
+a5_sb_issuer_allowed(proc_t p)
+{
+    struct cs_blob *blob = csproc_get_blob(p);
+    const char *identity = blob ? csblob_get_identity(blob) : NULL;
+    if (!identity || strcmp(identity, "com.apple.tccd") ||
+        !csproc_get_platform_binary(p)) return false;
+    vnode_t vp = proc_getexecutablevnode(p);
+    if (!vp) return false;
+    char path[128]; int length = sizeof(path);
+    int error = vn_getpath(vp, path, &length);
+    vnode_put(vp);
+    return !error && !strcmp(path,
+        "/System/Library/PrivateFrameworks/TCC.framework/Support/tccd");
+}
+
+/* Called only while holding a5_sb_lock. Pending bearer tokens expire;
+ * consumed tokens remain valid until their last release or consumer exit. */
+static void
+a5_sb_expire(uint64_t now)
+{
+    for (unsigned i = 0; i < A5_SB_SLOTS; i++) {
+        struct a5_sb_extension *e = &a5_sb_extensions[i];
+        if (e->state == A5_SB_ISSUED && now >= e->created &&
+            now - e->created >= A5_SB_PENDING_SECONDS) bzero(e, sizeof(*e));
+    }
+}
+
+static int
+a5_sb_issue(proc_t p, user_addr_t address)
+{
+    struct a5_sb_issue_args a;
+    char extension_class[A5_SB_CLASS_BYTES], token[A5_SB_TOKEN_BYTES];
+    size_t copied = 0;
+    if (!address) return EFAULT;
+    int error = copyin(address, &a, sizeof(a));
+    if (error) return error;
+    if (a.type != 3 || a.resource || (a.flags & ~0x30010ULL) ||
+        (a.flags & 0x30000) == 0x20000) return ENOTSUP;
+    if (!a.extension_class || !a.token) return EFAULT;
+    error = copyinstr(a.extension_class, extension_class, sizeof(extension_class), &copied);
+    if (error) return error;
+    if (!a5_sb_class_valid(extension_class)) return ENOTSUP;
+    if (!a5_sb_issuer_allowed(p)) return EPERM;
+    uint32_t pid = 0, version = 0;
+    if (a.flags & 0x10000) {
+        if (!a.pid || a.pid > INT32_MAX || a.pidversion > UINT32_MAX) return EINVAL;
+        proc_t target = proc_find((int)a.pid);
+        if (!target) return ESRCH;
+        pid = (uint32_t)proc_pid(target);
+        version = (uint32_t)proc_pidversion(target);
+        proc_rele(target);
+        if ((a.flags & 0x20000) && version != (uint32_t)a.pidversion) return ESRCH;
+        if (!(a.flags & 0x20000) && a.pidversion) return EINVAL;
+    } else if (a.pid || a.pidversion) return EINVAL;
+    uint8_t random[32];
+    read_random(random, sizeof(random));
+    memcpy(token, "A5TCC1:", 7);
+    const char hex[] = "0123456789abcdef";
+    for (unsigned i = 0; i < sizeof(random); i++) {
+        token[7 + 2*i] = hex[random[i] >> 4];
+        token[8 + 2*i] = hex[random[i] & 15];
+    }
+    token[sizeof(token)-1] = 0;
+    bzero(random, sizeof(random));
+    uint64_t issuer = proc_uniqueid(p), now = a5_sb_now(), generation;
+    unsigned slot = A5_SB_SLOTS, issued = 0;
+    lck_mtx_lock(&a5_sb_lock);
+    a5_sb_expire(now);
+    for (unsigned i = 0; i < A5_SB_SLOTS; i++) {
+        if (!a5_sb_extensions[i].state && slot == A5_SB_SLOTS) slot = i;
+        if (a5_sb_extensions[i].state && a5_sb_extensions[i].issuer == issuer) issued++;
+    }
+    if (slot == A5_SB_SLOTS || issued >= A5_SB_ISSUER_LIMIT ||
+        a5_sb_generation == INT64_MAX) {
+        lck_mtx_unlock(&a5_sb_lock); return ENOSPC;
+    }
+    struct a5_sb_extension *e = &a5_sb_extensions[slot];
+    generation = ++a5_sb_generation;
+    e->issuer = issuer; e->generation = generation; e->created = now;
+    e->pid = pid; e->pidversion = version; e->state = A5_SB_PUBLISHING;
+    memcpy(e->token, token, sizeof(token));
+    memcpy(e->extension_class, extension_class, copied);
+    lck_mtx_unlock(&a5_sb_lock);
+    error = copyout(token, a.token, sizeof(token));
+    lck_mtx_lock(&a5_sb_lock);
+    if (e->generation != generation || e->state != A5_SB_PUBLISHING) {
+        if (!error) error = ESRCH;
+    } else if (error) bzero(e, sizeof(*e));
+    else e->state = A5_SB_ISSUED;
+    lck_mtx_unlock(&a5_sb_lock);
+    bzero(token, sizeof(token));
+    if (!error) a5_sb_log("issue", extension_class);
+    return error;
+}
+
+static int
+a5_sb_consume(proc_t p, user_addr_t address)
+{
+    struct a5_sb_consume_args a;
+    char token[A5_SB_TOKEN_BYTES], extension_class[A5_SB_CLASS_BYTES];
+    if (!address) return EFAULT;
+    int error = copyin(address, &a, sizeof(a));
+    if (error) return error;
+    if (a.length != sizeof(token)) return EINVAL;
+    if (!a.token || !a.handle) return EFAULT;
+    error = copyin(a.token, token, sizeof(token));
+    if (error) return error;
+    if (memcmp(token, "A5TCC1:", 7) || token[sizeof(token)-1]) return EINVAL;
+    for (unsigned i = 7; i < sizeof(token)-1; i++) {
+        if (!((token[i] >= '0' && token[i] <= '9') ||
+            (token[i] >= 'a' && token[i] <= 'f'))) return EINVAL;
+    }
+    uint64_t consumer = proc_uniqueid(p), now = a5_sb_now(), handle = 0, generation = 0;
+    unsigned slot = A5_SB_SLOTS, active = 0, oldrefs = 0;
+    lck_mtx_lock(&a5_sb_lock);
+    a5_sb_expire(now);
+    for (unsigned i = 0; i < A5_SB_SLOTS; i++) {
+        struct a5_sb_extension *e = &a5_sb_extensions[i];
+        if (e->state && e->consumer == consumer) active++;
+        if (e->state && !memcmp(token, e->token, sizeof(token))) slot = i;
+    }
+    bzero(token, sizeof(token));
+    if (slot == A5_SB_SLOTS) { error = ENOENT; goto out; }
+    struct a5_sb_extension *e = &a5_sb_extensions[slot];
+    if (e->state == A5_SB_PUBLISHING || e->state == A5_SB_CONSUMING) { error = EAGAIN; goto out; }
+    if ((e->pid && (e->pid != (uint32_t)proc_pid(p) ||
+        e->pidversion != (uint32_t)proc_pidversion(p))) ||
+        (e->consumer && e->consumer != consumer)) { error = EPERM; goto out; }
+    if ((!e->consumer && active >= A5_SB_CONSUMER_LIMIT) || e->refs == UINT32_MAX) {
+        error = ENOSPC; goto out;
+    }
+    oldrefs = e->refs; generation = e->generation;
+    handle = e->handle ? e->handle : e->generation;
+    e->consumer = consumer; e->handle = handle; e->state = A5_SB_CONSUMING;
+    memcpy(extension_class, e->extension_class, sizeof(extension_class));
+    lck_mtx_unlock(&a5_sb_lock);
+    error = copyout(&handle, a.handle, sizeof(handle));
+    lck_mtx_lock(&a5_sb_lock);
+    if (e->generation != generation || e->state != A5_SB_CONSUMING) {
+        if (!error) error = ESRCH;
+    } else if (error) {
+        e->state = oldrefs ? A5_SB_CONSUMED : A5_SB_ISSUED;
+        if (!oldrefs) { e->consumer = 0; e->handle = 0; }
+    } else { e->refs = oldrefs + 1; e->state = A5_SB_CONSUMED; }
+out:
+    lck_mtx_unlock(&a5_sb_lock);
+    if (!error) a5_sb_log("consume", extension_class);
+    return error;
+}
+
+static int
+a5_sb_release(proc_t p, user_addr_t address)
+{
+    struct a5_sb_release_args a;
+    char extension_class[A5_SB_CLASS_BYTES];
+    if (!address) return EFAULT;
+    int error = copyin(address, &a, sizeof(a));
+    if (error) return error;
+    if (!a.handle || a.reserved0 || a.reserved1) return EINVAL;
+    uint64_t consumer = proc_uniqueid(p);
+    error = ENOENT;
+    lck_mtx_lock(&a5_sb_lock);
+    for (unsigned i = 0; i < A5_SB_SLOTS; i++) {
+        struct a5_sb_extension *e = &a5_sb_extensions[i];
+        if (e->state && e->handle == a.handle) {
+            if (e->consumer != consumer) error = EPERM;
+            else if (e->state != A5_SB_CONSUMED) error = EAGAIN;
+            else {
+                memcpy(extension_class, e->extension_class, sizeof(extension_class));
+                if (!--e->refs) bzero(e, sizeof(*e));
+                error = 0;
+            }
+            break;
+        }
+    }
+    lck_mtx_unlock(&a5_sb_lock);
+    if (!error) a5_sb_log("release", extension_class);
+    return error;
+}
+
+static void
+a5_sb_proc_exit(proc_t p)
+{
+    uint64_t uniqueid = proc_uniqueid(p);
+    lck_mtx_lock(&a5_sb_lock);
+    for (unsigned i = 0; i < A5_SB_SLOTS; i++) {
+        struct a5_sb_extension *e = &a5_sb_extensions[i];
+        if ((e->consumer == uniqueid) || (e->state && !e->consumer && e->issuer == uniqueid) ||
+            (e->pid == (uint32_t)proc_pid(p) && e->pidversion == (uint32_t)proc_pidversion(p)))
+            bzero(e, sizeof(*e));
+    }
+    lck_mtx_unlock(&a5_sb_lock);
+}
+#endif /* A5XELTE */
