+bool
+a5g3d_queue_acquire_runtime_wait(IOService **owner, uint64_t *token,
+    IOBufferMemoryDescriptor **backing, vm_offset_t *gpuMMIO)
+{
+    uint64_t begin=mach_absolute_time(),deadline=0;
+    clock_interval_to_deadline(2000,kMillisecondScale,&deadline);
+    unsigned sleeps=0;
+    const char *status="acquired";
+    bool acquired=false;
+    for (;;) {
+        if (a5g3d_queue_acquire_runtime(owner,token,backing,gpuMMIO)) {
+            acquired=true;break;
+        }
+        const uint32_t state=__sync_fetch_and_add(&gA5G3DQueueState,0u);
+        if (state!=3u) {status=state==2u?"poisoned":"unavailable";break;}
+        if (mach_absolute_time()>=deadline) {status="deadline";break;}
+        /* No aperture access or START has occurred. The current reservation
+         * owner does not need the AS1/client lock held by these callers. */
+        IOSleep(1);++sleeps;
+    }
+    static unsigned reports=0;
+    if ((sleeps || !acquired) && (++reports<=16 || !acquired || !(reports&63))) {
+        uint64_t elapsed=0;absolutetime_to_nanoseconds(mach_absolute_time()-begin,&elapsed);
+        IOLog("A5XELTE G3D admission: status=%s sleeps=%u elapsed_us=%llu state=%u\n",
+            status,sleeps,elapsed/1000,__sync_fetch_and_add(&gA5G3DQueueState,0u));
+    }
+    return acquired;
 }
 
