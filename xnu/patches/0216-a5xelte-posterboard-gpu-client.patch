+bool
+A5XELTEGPUUserClient::posterAuthorized(task_t task)
+{
+    if(task==TASK_NULL)return false;
+    proc_t process=static_cast<proc_t>(get_bsdtask_info(task));
+    const char *identity=process?cs_identity_get(process):nullptr;
+    if(!identity || strcmp(identity,"com.apple.PosterBoard"))return false;
+    vnode_t executable=proc_getexecutablevnode(process);
+    if(!executable)return false;
+    char path[128]={};int length=sizeof(path);
+    bool pathOK=vn_getpath(executable,path,&length)==0 &&
+        !strcmp(path,"/Applications/PosterBoard.app/PosterBoard");
+    vnode_put(executable);
+    if(!pathOK)return false;
+    OSObject *value=copyClientEntitlement(task,"com.apple.QuartzCore.global-capture");
+    bool allowed=value==kOSBooleanTrue;
+    if(value)value->release();
+    return allowed;
 }
 
