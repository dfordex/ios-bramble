@@ -0,0 +1,51 @@
+#!/usr/bin/env python3
+"""Generate an ignored XNU include from the user's local read_surf fixture.
+
+The fixture is built from the user's staged IPSW by the host-only Mesa tool.
+No translated shader or descriptor bytes are distributed in the source patch.
+"""
+import hashlib
+import pathlib
+import struct
+import sys
+
+EXPECTED_SHA256 = "26885bced5b3d15fa00e38b8c41e8a0eb458d42852021873f7d420af48dd8e9a"
+EXPECTED_SIZE = 0x2000
+BASE = 0x12000000
+
+
+def u64(data: bytes, offset: int) -> int:
+    return struct.unpack_from("<Q", data, offset)[0]
+
+
+def main() -> int:
+    if len(sys.argv) != 3:
+        print("usage: gen_local_read_surf_fixture.py validated-template.bin XNU-include.inc", file=sys.stderr)
+        return 2
+    source = pathlib.Path(sys.argv[1])
+    target = pathlib.Path(sys.argv[2])
+    data = source.read_bytes()
+    if len(data) != EXPECTED_SIZE or hashlib.sha256(data).hexdigest() != EXPECTED_SHA256:
+        print("read_surf template size or SHA256 mismatch", file=sys.stderr)
+        return 1
+    pointers = {
+        0x350: 0x10800000, 0x380: 0x10800000, 0x620: 0x10000000,
+        0x660: BASE + 0x600,
+    }
+    for offset, expected in pointers.items():
+        if u64(data, offset) != expected:
+            print(f"read_surf pointer mismatch at 0x{offset:x}", file=sys.stderr)
+            return 1
+    words = struct.unpack("<2048I", data)
+    lines = ["/* Generated locally from validated private fixture; never commit. */",
+             "static const uint32_t kAS1ReadSurfFixture[2048] = {"]
+    for i in range(0, len(words), 8):
+        lines.append("    " + ", ".join(f"0x{w:08x}u" for w in words[i:i + 8]) + ",")
+    lines.append("};")
+    target.write_text("\n".join(lines) + "\n")
+    print(f"wrote {target} from SHA256 {EXPECTED_SHA256}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
--- /dev/null
+++ b/.gitignore
@@ -0,0 +1 @@
+/iokit/Kernel/arm/A5XELTEReadSurfFixture.inc
