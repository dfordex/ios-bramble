--- a/bsd/dev/mem.c
+++ b/bsd/dev/mem.c
@@ -172,6 +172,28 @@
 #if defined(ARM64_BOARD_CONFIG_A5XELTE)
 /* Separate budgets keep a failing daemon from hiding the one-shot probe. */
 static volatile UInt32 a5_null_chunks;
+/* Four daemon lifetimes, each at most1024 chunks. Never reset a global
+ * counter on restart: that would let a crash loop log without a boot bound. */
+static volatile UInt64 a5_backboardd_budgets[4];
+static bool
+a5_backboardd_tee(UInt32 pid)
+{
+	if (!pid) return false;
+	for (unsigned i = 0; i < 4; ++i) {
+		for (;;) {
+			UInt64 old = __atomic_load_n(&a5_backboardd_budgets[i], __ATOMIC_RELAXED);
+			if (!old) {
+				if (OSCompareAndSwap64(0, ((UInt64)pid << 32) | 1,
+				    &a5_backboardd_budgets[i])) return true;
+				continue;
+			}
+			if ((UInt32)(old >> 32) != pid) break;
+			if ((UInt32)old >= 1024) return false;
+			if (OSCompareAndSwap64(old, old + 1, &a5_backboardd_budgets[i])) return true;
+		}
+	}
+	return false;
+}
 static volatile UInt32 a5_probe_null_chunks;
 static volatile UInt32 a5_compiler_null_chunks;
 static volatile UInt32 a5_springboard_null_chunks;
@@ -212,7 +234,7 @@
 			UInt32 limit = 256, old;
 			/* Preserve the first real frame and callback/wait evidence past
 			 * routine startup output; keep the producer budget bounded. */
-			if (!strcmp(name, "backboardd")) limit = 1024;
+			if (!strcmp(name, "backboardd")) return a5_backboardd_tee((UInt32)proc_selfpid());
 			if (a5_ui_diag && !strcmp(name, "SpringBoard")) {
 				chunks = &a5_springboard_null_chunks; limit = 1024;
 			}
