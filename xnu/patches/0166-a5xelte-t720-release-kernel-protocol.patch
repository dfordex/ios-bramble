+/* A faulted slot can remain active. Read MMIO before acknowledgements and
+ * never inspect or recycle a DMA target until a terminal idle fence. */
+static void
+a5g3d_as1_fault_snapshot(vm_offset_t gpu, uint32_t slot, const char *reason)
+{
+    const uint32_t slotBase = 0x1800 + slot * 0x80;
+    const uint64_t address = static_cast<uint64_t>(
+        a5g3d_as1_read(gpu, 0x2464)) << 32 | a5g3d_as1_read(gpu, 0x2460);
+    const uint64_t head = static_cast<uint64_t>(
+        a5g3d_as1_read(gpu, slotBase + 4)) << 32 |
+        a5g3d_as1_read(gpu, slotBase);
+    const uint64_t gpuAddress = static_cast<uint64_t>(
+        a5g3d_as1_read(gpu, 0x44)) << 32 | a5g3d_as1_read(gpu, 0x40);
+    IOLog("A5XELTE G3D: AS1 fault snapshot reason=%s slot=%u irq=%08x mmu_raw=%08x gpu_irq=%08x as_status=%08x fault_status=%08x fault_va=%016llx js_status=%08x js_head=%016llx gpu_fault=%08x gpu_va=%016llx\n",
+        reason, slot, a5g3d_as1_read(gpu, 0x1000),
+        a5g3d_as1_read(gpu, 0x2000), a5g3d_as1_read(gpu, 0x20),
+        a5g3d_as1_read(gpu, 0x2468), a5g3d_as1_read(gpu, 0x245c),
+        address, a5g3d_as1_read(gpu, slotBase + 0x24), head,
+        a5g3d_as1_read(gpu, 0x3c), gpuAddress);
+}
+
+static bool
+a5g3d_as1_mmu_clean(vm_offset_t gpu)
+{
+    return a5g3d_as1_wait(gpu) && !a5g3d_as1_read(gpu, 0x245c) &&
+        !(a5g3d_as1_read(gpu, 0x2000) & 0x00020002u);
+}
+
+/* Released Panfrost drains all translated accesses before changing or
+ * disabling an AS root. LOCKADDR=63 is the full-address-space region
+ * encoding used by lock_region(0, ~0ULL), not a fixed surface-window lock. */
+static bool
+a5g3d_as1_drain(vm_offset_t gpu)
+{
+    if (!a5g3d_as1_mmu_clean(gpu))
+        return false;
+    a5g3d_as1_write(gpu, 0x2450, 63u);
+    a5g3d_as1_write(gpu, 0x2454, 0u);
+    __sync_synchronize();
+    a5g3d_as1_write(gpu, 0x2458, 2u); /* LOCK */
+    if (!a5g3d_as1_mmu_clean(gpu))
+        return false;
+    a5g3d_as1_write(gpu, 0x2458, 5u); /* FLUSH_MEM */
+    return a5g3d_as1_mmu_clean(gpu);
+}
