+static a5_midgard_image
+a5g3d_as1_image(const A5G3DAS1Context *ctx, uint32_t slot)
+{
+    SweetSurface *surface = ctx->surface[slot];
+    a5_midgard_image image = {};
+    image.gpu_va = kAS1Base + static_cast<uint64_t>(slot) * kAS1Window;
+    image.mapped_bytes = ctx->mappedBytes[slot];
+    image.width = surface->width;
+    image.height = surface->height;
+    image.row_bytes = surface->bytesPerRow;
+    return image;
+}
+
+static a5_midgard_rect
+a5g3d_as1_rect(const A5G3DAS1Rect &rect)
+{
+    a5_midgard_rect encoded = {};
+    encoded.x = rect.x;
+    encoded.y = rect.y;
+    encoded.width = rect.width;
+    encoded.height = rect.height;
+    return encoded;
+}
+
+/* The caller holds the AS1 lease lock and the global GPU staging token.
+ * Neither the descriptor BO nor an imported surface may be freed after START
+ * until this function proves a terminal fence and an idle job slot.
+ */
+static A5G3DAS1SubmitStatus
+a5g3d_as1_run_job(A5G3DAS1Context *ctx, vm_offset_t gpu,
+    uint32_t slot, uint32_t jobOffset, A5G3DAS1Completion *completion,
+    uint64_t *fence, bool *started)
+{
+    const uint32_t slotBase = 0x1800 + slot * 0x80;
+    const uint32_t slotMask = (1u << slot) | (1u << (slot + 16));
+    const uint32_t shader = a5g3d_as1_read(gpu, 0x140);
+    if (!shader || !(a5g3d_as1_read(gpu, 0x018) & 2u) ||
+        !(a5g3d_as1_read(gpu, 0x01c) & (1u << slot)) ||
+        !ctx->installed || ctx->poisoned)
+        return kAS1SubmitBusy;
+    /* Clearing JOB_IRQ refreshes sampled JS_STATE on Mali-T720. */
+    a5g3d_as1_write(gpu, 0x1004, slotMask);
+    if ((a5g3d_as1_read(gpu, 0x1010) & slotMask) ||
+        a5g3d_as1_read(gpu, slotBase + 0x24) ||
+        a5g3d_as1_read(gpu, slotBase + 0x60) ||
+        a5g3d_as1_read(gpu, 0x245c) ||
+        (a5g3d_as1_read(gpu, 0x200c) & 0x00020002u))
+        return kAS1SubmitFault;
+    if (ctx->jobs->performOperation(kIOMemoryIncoherentIOStore,
+        0, kAS1JobBytes) != kIOReturnSuccess)
+        return kAS1SubmitIOError;
+    __sync_synchronize();
+    *fence = ++ctx->nextFence;
+    a5g3d_as1_write(gpu, slotBase + 0x40, kAS1JobVA + jobOffset);
+    a5g3d_as1_write(gpu, slotBase + 0x44, 0);
+    a5g3d_as1_write(gpu, slotBase + 0x50, shader);
+    a5g3d_as1_write(gpu, slotBase + 0x54, 0);
+    /* Low config bits choose AS1; no userspace-controlled register fields. */
+    a5g3d_as1_write(gpu, slotBase + 0x58,
+        (8u << 16) | (3u << 8) | (3u << 12) | 1u);
+    __sync_synchronize();
+    *started = true;
+    a5g3d_as1_write(gpu, slotBase + 0x60, 1u);
+    uint32_t jobIRQ = 0, mmuIRQ = 0, gpuIRQ = 0;
+    for (unsigned i = 0; i < 20000; ++i) {
+        jobIRQ = a5g3d_as1_read(gpu, 0x1000);
+        mmuIRQ = a5g3d_as1_read(gpu, 0x2000);
+        gpuIRQ = a5g3d_as1_read(gpu, 0x20);
+        if ((jobIRQ & slotMask) || mmuIRQ || (gpuIRQ & 0x81u))
+            break;
+        IODelay(10);
+    }
+    if (completion) {
+        completion->jobIRQ = jobIRQ;
+        completion->mmuIRQ = mmuIRQ;
+        completion->gpuIRQ = gpuIRQ;
+    }
+    if (!((jobIRQ & slotMask) || mmuIRQ || (gpuIRQ & 0x81u)))
+        return kAS1SubmitTimeout;
+    bool idle = false;
+    for (unsigned i = 0; i < 1000; ++i) {
+        if (!a5g3d_as1_read(gpu, slotBase + 0x24) &&
+            !a5g3d_as1_read(gpu, slotBase + 0x60)) {
+            idle = true;
+            break;
+        }
+        IODelay(10);
+    }
+    if (!idle)
+        return kAS1SubmitFault;
+    if (ctx->jobs->performOperation(kIOMemoryIncoherentIOFlush,
+        jobOffset, 16) != kIOReturnSuccess)
+        return kAS1SubmitIOError;
+    __sync_synchronize();
+    const uint32_t header = *reinterpret_cast<const uint32_t *>(
+        static_cast<const uint8_t *>(ctx->jobs->getBytesNoCopy()) + jobOffset);
+    if (completion)
+        completion->headerStatus = header;
+    if (jobIRQ)
+        a5g3d_as1_write(gpu, 0x1004, jobIRQ);
+    if (mmuIRQ)
+        a5g3d_as1_write(gpu, 0x2004, mmuIRQ);
+    if (!(jobIRQ & (1u << slot)) ||
+        (jobIRQ & (1u << (slot + 16))) || mmuIRQ || (gpuIRQ & 0x81u) ||
+        (header & 0xffu) != 1u ||
+        (a5g3d_as1_read(gpu, 0x1010) & slotMask))
+        return kAS1SubmitFault;
+    *started = false;
+    return kAS1SubmitCompleted;
+}
+
+A5G3DAS1SubmitStatus
+a5g3d_as1_submit(A5G3DAS1Context *ctx,
+    const A5G3DAS1Request &request, A5G3DAS1Completion *completion)
+{
+    if (completion)
+        bzero(completion, sizeof(*completion));
+    if (!ctx || request.destinationSlot >= kAS1Slots ||
+        (request.operation != kAS1ClearBGRA &&
+         request.operation != kAS1CopyBGRA) ||
+        (request.operation == kAS1CopyBGRA &&
+         (request.sourceSlot >= kAS1Slots ||
+          request.sourceSlot == request.destinationSlot)))
+        return kAS1SubmitInvalid;
+    IOLock *lock = a5g3d_as1_lock();
+    IOLockLock(lock);
+    if (gAS1Owner != ctx || ctx->poisoned || !ctx->installed ||
+        !ctx->surface[request.destinationSlot] ||
+        (request.operation == kAS1CopyBGRA &&
+         !ctx->surface[request.sourceSlot])) {
+        IOLockUnlock(lock);
+        return kAS1SubmitInvalid;
+    }
+    a5_midgard_image destination = a5g3d_as1_image(ctx,
+        request.destinationSlot);
+    a5_midgard_rect destinationRect = a5g3d_as1_rect(request.destination);
+    a5_midgard_status encoded = A5_MIDGARD_INVALID;
+    if (request.operation == kAS1ClearBGRA) {
+        encoded = a5_midgard_encode_clear(ctx->jobs->getBytesNoCopy(),
+            kAS1JobBytes, kAS1JobVA, &destination, &destinationRect,
+            request.clearColor);
+    } else {
+        a5_midgard_image source = a5g3d_as1_image(ctx, request.sourceSlot);
+        a5_midgard_rect sourceRect = a5g3d_as1_rect(request.source);
+        encoded = a5_midgard_encode_copy(ctx->jobs->getBytesNoCopy(),
+            kAS1JobBytes, kAS1JobVA, &source, &sourceRect,
+            &destination, &destinationRect);
+    }
+    if (encoded != A5_MIDGARD_OK) {
+        IOLockUnlock(lock);
+        return kAS1SubmitInvalid;
+    }
+    /* Store every CPU dirty page before the GPU reads or overwrites it. */
+    if ((request.operation == kAS1CopyBGRA &&
+         ctx->surface[request.sourceSlot]->memory->performOperation(
+             kIOMemoryIncoherentIOStore, 0,
+             ctx->mappedBytes[request.sourceSlot]) != kIOReturnSuccess) ||
+        ctx->surface[request.destinationSlot]->memory->performOperation(
+            kIOMemoryIncoherentIOStore, 0,
+            ctx->mappedBytes[request.destinationSlot]) != kIOReturnSuccess) {
+        IOLockUnlock(lock);
+        return kAS1SubmitIOError;
+    }
+    IOService *owner = nullptr;
+    IOBufferMemoryDescriptor *as0 = nullptr;
+    vm_offset_t gpu = 0;
+    uint64_t token = 0;
+    if (!a5g3d_queue_acquire_runtime(&owner, &token, &as0, &gpu)) {
+        IOLockUnlock(lock);
+        return kAS1SubmitBusy;
+    }
+    bool started = false;
+    A5G3DAS1SubmitStatus status = kAS1SubmitCompleted;
+    if (request.operation == kAS1CopyBGRA) {
+        uint64_t tilerFence = 0;
+        status = a5g3d_as1_run_job(ctx, gpu, 1,
+            A5_MIDGARD_TILER_OFFSET, completion, &tilerFence, &started);
+        if (completion)
+            completion->tilerFence = tilerFence;
+        if (status == kAS1SubmitCompleted &&
+            ctx->jobs->performOperation(kIOMemoryIncoherentIOFlush,
+                0x1000, 0x1000) != kIOReturnSuccess)
+            status = kAS1SubmitIOError;
+    }
+    if (status == kAS1SubmitCompleted) {
+        uint64_t fragmentFence = 0;
+        status = a5g3d_as1_run_job(ctx, gpu, 0,
+            A5_MIDGARD_FRAGMENT_OFFSET, completion, &fragmentFence,
+            &started);
+        if (completion)
+            completion->fragmentFence = fragmentFence;
+    }
+    if (status == kAS1SubmitCompleted &&
+        ctx->surface[request.destinationSlot]->memory->performOperation(
+            kIOMemoryIncoherentIOFlush, 0,
+            ctx->mappedBytes[request.destinationSlot]) != kIOReturnSuccess)
+        status = kAS1SubmitIOError;
+    if (started || status == kAS1SubmitFault ||
+        status == kAS1SubmitTimeout) {
+        ctx->poisoned = true;
+        a5g3d_queue_poison(owner, token); /* retain AS0 and AS1 pages */
+        IOLog("A5XELTE G3D: AS1 job uncertain; both queues pinned until reboot\n");
+    } else if (!a5g3d_queue_release(owner, token)) {
+        ctx->poisoned = true;
+        status = kAS1SubmitFault;
+    }
+    owner->release();
+    IOLockUnlock(lock);
+    return status;
+}
+
 void
 a5g3d_as1_destroy(A5G3DAS1Context *ctx)
 {
@@ -326,8 +561,8 @@ a5g3d_as1_destroy(A5G3DAS1Context *ctx)
         IOLockUnlock(lock);
         return;
     }
-    /* No selector can submit AS1 work. A future renderer must add fence
-     * retirement before this path may release any retained resource.
+    /* Submit holds this lock through a terminal fence. A failed or ambiguous
+     * job poisons the context, so teardown never releases pages still in use.
      */
     if (!ctx->poisoned && ctx->installed) {
         if (a5g3d_as1_update(ctx, true) != kAS1UpdateApplied)
@@ -343,6 +578,7 @@ a5g3d_as1_destroy(A5G3DAS1Context *ctx)
         if (ctx->surface[i])
             ctx->surface[i]->release();
     ctx->tables->release();
+    ctx->jobs->release();
     IODelete(ctx, A5G3DAS1Context, 1);
     IOLockUnlock(lock);
 }
