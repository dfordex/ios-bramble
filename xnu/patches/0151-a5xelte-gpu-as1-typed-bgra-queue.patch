+IOReturn
+A5XELTEGPUUserClient::submitTyped(IOExternalMethodArguments *args)
+{
+    if (!a5gpu_valid_input(args, sizeof(A5GPUClientSubmitRequest)) ||
+        !args->structureOutput ||
+        args->structureOutputSize < sizeof(A5GPUClientSubmitResult))
+        return kIOReturnBadArgument;
+    A5GPUClientSubmitRequest request = {};
+    memcpy(&request, args->structureInput, sizeof(request));
+    if (!a5gpu_valid_header(&request.header, sizeof(request)))
+        return kIOReturnUnsupported;
+    const uint32_t dst = static_cast<uint32_t>(request.destinationToken);
+    const uint32_t dstGeneration =
+        static_cast<uint32_t>(request.destinationToken >> 32);
+    const uint32_t src = static_cast<uint32_t>(request.sourceToken);
+    const uint32_t srcGeneration =
+        static_cast<uint32_t>(request.sourceToken >> 32);
+    if (!dst || dst > 4 || !dstGeneration ||
+        (request.operation != kA5GPUClientClearBGRA &&
+         request.operation != kA5GPUClientCopyBGRA) ||
+        (request.operation == kA5GPUClientClearBGRA &&
+         (request.sourceToken || request.sourceRect.x ||
+          request.sourceRect.y || request.sourceRect.width ||
+          request.sourceRect.height)) ||
+        (request.operation == kA5GPUClientCopyBGRA &&
+         (!src || src > 4 || !srcGeneration || src == dst ||
+          request.clearColor)))
+        return kIOReturnBadArgument;
+    A5GPUClientSubmitResult result = {};
+    result.header.version = kA5GPUClientVersion;
+    result.header.size = sizeof(result);
+    IOLockLock(fLock);
+    const ResourceSlot &target = fSlots[dst - 1];
+    const bool sourceReady = request.operation != kA5GPUClientCopyBGRA ||
+        (fSlots[src - 1].mapped &&
+         fSlots[src - 1].generation == srcGeneration &&
+         (fSlots[src - 1].usage & kA5GPUClientRead));
+    if (fClosed || !fAS1 || !target.mapped ||
+        target.generation != dstGeneration ||
+        !(target.usage & kA5GPUClientWrite) || !sourceReady) {
+        IOLockUnlock(fLock);
+        return kIOReturnNotFound;
+    }
+    A5G3DAS1Request work = {};
+    work.operation = request.operation == kA5GPUClientCopyBGRA ?
+        kAS1CopyBGRA : kAS1ClearBGRA;
+    work.sourceSlot = src ? src - 1 : 0;
+    work.destinationSlot = dst - 1;
+    work.source = {request.sourceRect.x, request.sourceRect.y,
+        request.sourceRect.width, request.sourceRect.height};
+    work.destination = {request.destinationRect.x, request.destinationRect.y,
+        request.destinationRect.width, request.destinationRect.height};
+    work.clearColor = request.clearColor;
+    A5G3DAS1Completion completed = {};
+    result.status = a5g3d_as1_submit(fAS1, work, &completed);
+    IOLockUnlock(fLock);
+    result.tilerFence = completed.tilerFence;
+    result.fragmentFence = completed.fragmentFence;
+    memcpy(args->structureOutput, &result, sizeof(result));
+    args->structureOutputSize = sizeof(result);
+    return kIOReturnSuccess;
+}
+
 IOReturn
 A5XELTEGPUUserClient::externalMethod(uint32_t selector,
     IOExternalMethodArguments *args, __unused IOExternalMethodDispatch *dispatch,
@@ -429,6 +502,8 @@ A5XELTEGPUUserClient::externalMethod(uint32_t selector,
         return mapSurface(args);
     case kA5GPUClientUnmapSurface:
         return unmapSurface(args);
+    case kA5GPUClientSubmitTyped:
+        return submitTyped(args);
     default:
         return kIOReturnUnsupported;
     }
