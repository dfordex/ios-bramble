+/* Synchronous bounded batch. Commands execute in array order under one client
+ * resource lock. Each successful item has a terminal GPU fence before the next
+ * command starts. On first failure, later items are NotRun; no rollback of
+ * completed earlier commands is implied. No user-supplied job or GPU VA. */
+struct A5GPUClientBatchCommand {
+    uint32_t operation; /* ClearBGRA, CopyBGRA, DrawTexturedQuadBGRA */
+    uint32_t clearColor;
+    uint64_t sourceToken;
+    uint64_t destinationToken;
+    A5GPUClientRect sourceRect;
+    A5GPUClientRect destinationRect;
+};
+struct A5GPUClientBatchRequest {
+    A5GPUClientHeader header;
+    uint32_t count; /* 1..kA5GPUClientBatchMax */
+    uint32_t reserved;
+    A5GPUClientBatchCommand commands[kA5GPUClientBatchMax];
+};
+struct A5GPUClientBatchItemResult {
+    uint32_t status; /* 0..5 AS1 status, 6 = NotRun */
+    uint32_t reserved;
+    uint64_t tilerFence;
+    uint64_t fragmentFence;
+};
+struct A5GPUClientBatchResult {
+    A5GPUClientHeader header;
+    uint32_t count;
+    uint32_t completedCount;
+    uint32_t failedIndex; /* UINT32_MAX on complete success */
+    uint32_t reserved;
+    A5GPUClientBatchItemResult items[kA5GPUClientBatchMax];
+};
+
 #endif /* A5XELTE_GPU_USER_CLIENT_H */
diff --git a/next/iokit/Kernel/arm/A5XELTEGPUUserClientBatch.h b/iokit/Kernel/arm/A5XELTEGPUUserClientBatch.h
new file mode 100644
index 0000000..94c662b
--- /dev/null
+++ b/iokit/Kernel/arm/A5XELTEGPUUserClientBatch.h
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: MIT
+ * Pure ordered batch state machine; host-tested without GPU hardware.
+ * Caller pins resources and serialises map/unmap for the entire call.
+ */
+#ifndef A5XELTE_GPU_USER_CLIENT_BATCH_H
+#define A5XELTE_GPU_USER_CLIENT_BATCH_H
+#include "A5XELTEGPUUserClient.h"
+
+typedef bool (*A5GPUBatchRunOne)(void *, const A5GPUClientBatchCommand *,
+    A5GPUClientBatchItemResult *);
+
+/* Pure shape/ownership checks shared by selector 6 and batch selector 7. */
+static inline bool a5gpu_valid_batch_command(
+    const A5GPUClientBatchCommand &request)
+{
+    const uint32_t dst = static_cast<uint32_t>(request.destinationToken);
+    const uint32_t src = static_cast<uint32_t>(request.sourceToken);
+    const bool samples = request.operation == kA5GPUClientCopyBGRA ||
+        request.operation == kA5GPUClientDrawTexturedQuadBGRA;
+    return dst && dst <= 4 && (request.destinationToken >> 32) &&
+        (request.operation == kA5GPUClientClearBGRA || samples) &&
+        (request.operation != kA5GPUClientClearBGRA ||
+         (!request.sourceToken && !request.sourceRect.x &&
+          !request.sourceRect.y && !request.sourceRect.width &&
+          !request.sourceRect.height)) &&
+        (!samples ||
+         (src && src <= 4 && (request.sourceToken >> 32) &&
+          src != dst && !request.clearColor)) &&
+        (request.operation != kA5GPUClientCopyBGRA ||
+         (request.sourceRect.width == request.destinationRect.width &&
+          request.sourceRect.height == request.destinationRect.height));
+}
+
+static inline bool a5gpu_mapped_token_matches(uint64_t token,
+    uint32_t slotOneBased, uint32_t currentGeneration, bool mapped,
+    uint32_t usage, uint32_t requiredUsage)
+{
+    return mapped && static_cast<uint32_t>(token) == slotOneBased &&
+        static_cast<uint32_t>(token >> 32) == currentGeneration &&
+        (usage & requiredUsage) == requiredUsage;
+}
+
+static inline void a5gpu_run_batch(const A5GPUClientBatchRequest &request,
+    A5GPUClientBatchResult *result, void *context, A5GPUBatchRunOne runOne)
+{
+    result->count = request.count;
+    result->failedIndex = UINT32_MAX;
+    for (uint32_t i = 0; i < kA5GPUClientBatchMax; ++i)
+        result->items[i].status = kA5GPUClientBatchNotRun;
+    if (!request.count || request.count > kA5GPUClientBatchMax) {
+        result->failedIndex = 0;
+        return;
+    }
+    for (uint32_t i = 0; i < request.count; ++i) {
+        if (!runOne(context, &request.commands[i], &result->items[i]))
+            result->items[i].status = kA5GPUClientBatchInvalid;
+        if (result->items[i].status != kA5GPUClientBatchCompleted) {
+            result->failedIndex = i;
+            break;
+        }
+        ++result->completedCount;
+    }
+}
+#endif
diff --git a/next/iokit/Kernel/arm/tests/test_a5xelte_gpu_batch.cpp b/iokit/Kernel/arm/tests/test_a5xelte_gpu_batch.cpp
new file mode 100644
index 0000000..c624e04
--- /dev/null
+++ b/iokit/Kernel/arm/tests/test_a5xelte_gpu_batch.cpp
@@ -0,0 +1,70 @@
+/* Host test: clang++ -std=c++17 -I iokit/Kernel/arm
+ * iokit/Kernel/arm/tests/test_a5xelte_gpu_batch.cpp -o /tmp/test-batch
+ */
+#include "A5XELTEGPUUserClientBatch.h"
+#include <assert.h>
+#include <stdio.h>
+
+struct Fake {
+    unsigned calls;
+    unsigned failAt;
+};
+static bool run(void *context, const A5GPUClientBatchCommand *command,
+    A5GPUClientBatchItemResult *item)
+{
+    Fake *fake = static_cast<Fake *>(context);
+    assert(command->clearColor == fake->calls + 1); /* preserves order */
+    const unsigned index = fake->calls++;
+    item->status = index == fake->failAt ? 4 : 0;
+    if (item->status == 0)
+        item->fragmentFence = index + 1;
+    return true;
+}
+int main()
+{
+    static_assert(sizeof(A5GPUClientBatchRequest) == 472, "request ABI");
+    static_assert(sizeof(A5GPUClientBatchResult) == 224, "result ABI");
+    A5GPUClientBatchCommand command = {};
+    command.operation = kA5GPUClientCopyBGRA;
+    command.sourceToken = (static_cast<uint64_t>(7) << 32) | 1;
+    command.destinationToken = (static_cast<uint64_t>(9) << 32) | 2;
+    command.sourceRect = {0, 0, 8, 8};
+    command.destinationRect = {0, 0, 8, 8};
+    assert(a5gpu_valid_batch_command(command));
+    assert(a5gpu_mapped_token_matches(command.sourceToken, 1, 7,
+        true, kA5GPUClientRead, kA5GPUClientRead));
+    assert(!a5gpu_mapped_token_matches(command.sourceToken, 1, 8,
+        true, kA5GPUClientRead, kA5GPUClientRead)); /* stale generation */
+    assert(!a5gpu_mapped_token_matches(command.sourceToken, 1, 7,
+        true, kA5GPUClientWrite, kA5GPUClientRead));
+    command.destinationToken = (static_cast<uint64_t>(9) << 32) | 1;
+    assert(!a5gpu_valid_batch_command(command)); /* source/destination alias */
+    command.destinationToken = (static_cast<uint64_t>(9) << 32) | 2;
+    command.destinationRect.width = 16;
+    assert(!a5gpu_valid_batch_command(command)); /* old copy is unscaled */
+    command.operation = kA5GPUClientDrawTexturedQuadBGRA;
+    assert(a5gpu_valid_batch_command(command));
+    A5GPUClientBatchRequest request = {};
+    request.count = 3;
+    for (unsigned i = 0; i < request.count; ++i)
+        request.commands[i].clearColor = i + 1;
+    A5GPUClientBatchResult result = {};
+    Fake fake = {0, 1};
+    a5gpu_run_batch(request, &result, &fake, run);
+    assert(fake.calls == 2 && result.completedCount == 1);
+    assert(result.failedIndex == 1 && result.items[0].fragmentFence == 1);
+    assert(result.items[1].status == 4);
+    assert(result.items[2].status == kA5GPUClientBatchNotRun);
+    result = {};
+    fake = {0, 99};
+    a5gpu_run_batch(request, &result, &fake, run);
+    assert(fake.calls == 3 && result.completedCount == 3);
+    assert(result.failedIndex == UINT32_MAX);
+    assert(result.items[2].fragmentFence == 3);
+    request.count = kA5GPUClientBatchMax + 1;
+    result = {};
+    fake = {0, 99};
+    a5gpu_run_batch(request, &result, &fake, run);
+    assert(fake.calls == 0 && result.failedIndex == 0);
+    puts("ordered GPU batch state machine: PASS");
+}
