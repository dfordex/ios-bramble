diff --git a/next/iokit/Kernel/arm/tests/test_a5xelte_midgard_scaled.cpp b/iokit/Kernel/arm/tests/test_a5xelte_midgard_scaled.cpp
new file mode 100644
index 0000000..3cf2f59
--- /dev/null
+++ b/iokit/Kernel/arm/tests/test_a5xelte_midgard_scaled.cpp
@@ -0,0 +1,54 @@
+/* Host descriptor test. From the XNU source root:
+ * clang++ -std=c++17 -I iokit/Kernel/arm \
+ *   iokit/Kernel/arm/tests/test_a5xelte_midgard_scaled.cpp \
+ *   iokit/Kernel/arm/A5XELTEMidgardEncode.cpp -o /tmp/test-scaled && \
+ *   /tmp/test-scaled
+ */
+#include "midgard_encode.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static float coordinate(const unsigned char *buffer, unsigned offset)
+{
+    float value;
+    memcpy(&value, buffer + offset, sizeof(value));
+    return value;
+}
+
+static unsigned word(const unsigned char *buffer, unsigned offset)
+{
+    unsigned value;
+    memcpy(&value, buffer + offset, sizeof(value));
+    return value;
+}
+
+int main()
+{
+    alignas(16) unsigned char descriptor[A5_MIDGARD_DESCRIPTOR_BYTES + 8];
+    const a5_midgard_image source = {0x10000000, 4096, 16, 16, 64};
+    const a5_midgard_image destination = {0x10800000, 16384, 64, 64, 256};
+    const a5_midgard_rect from = {2, 3, 8, 8};
+    const a5_midgard_rect to = {4, 5, 32, 32};
+    memset(descriptor, 0xa5, sizeof(descriptor));
+    assert(a5_midgard_encode_copy(descriptor, A5_MIDGARD_DESCRIPTOR_BYTES,
+        0x12000000, &source, &from, &destination, &to) == A5_MIDGARD_OK);
+    assert(coordinate(descriptor, 0x880) == 4.0f);
+    assert(coordinate(descriptor, 0x884) == 5.0f);
+    assert(coordinate(descriptor, 0x890) == 36.0f);
+    assert(coordinate(descriptor, 0x8c0) == 2.0f);
+    assert(coordinate(descriptor, 0x8c4) == 3.0f);
+    assert(coordinate(descriptor, 0x8d0) == 10.0f);
+    /* Mesa v4 fixture sampler from gen-t720-texture-fixture.c: unnormalised,
+     * minify/magnify nearest. This checks packed words, not phone pixels. */
+    assert(word(descriptor, 0x780) == 0x00000003u);
+    assert(word(descriptor, 0x788) == 0x00000999u);
+    for (unsigned i = A5_MIDGARD_DESCRIPTOR_BYTES;
+         i < sizeof(descriptor); ++i)
+        assert(descriptor[i] == 0xa5);
+    const a5_midgard_rect outside = {32, 32, 33, 33};
+    assert(a5_midgard_encode_copy(descriptor, A5_MIDGARD_DESCRIPTOR_BYTES,
+        0x12000000, &source, &from, &destination, &outside) ==
+        A5_MIDGARD_INVALID);
+    puts("scaled textured quad descriptor: PASS");
+}
