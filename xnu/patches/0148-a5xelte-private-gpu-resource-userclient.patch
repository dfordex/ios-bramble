diff --git a/iokit/Kernel/arm/A5XELTEGPUUserClient.h b/iokit/Kernel/arm/A5XELTEGPUUserClient.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/A5XELTEGPUUserClient.h
@@ -0,0 +1,55 @@
+/* Private A5XELTE Mali resource protocol, version 1.
+ * This is deliberately not IOGPU, IOAccelerator, AGX or Metal. No selector
+ * accepts a GPU command, physical address, GPU virtual address or shader.
+ */
+#ifndef A5XELTE_GPU_USER_CLIENT_H
+#define A5XELTE_GPU_USER_CLIENT_H
+
+#include <stdint.h>
+
+enum {
+    kA5GPUClientVersion = 1,
+    kA5GPUClientMaxResources = 32,
+    kA5GPUClientRead = 1,
+    kA5GPUClientQuery = 0,
+    kA5GPUClientImportSurface = 1,
+    kA5GPUClientReleaseSurface = 2,
+};
+
+struct A5GPUClientHeader {
+    uint32_t version;
+    uint32_t size;
+    uint32_t reserved0;
+    uint32_t reserved1;
+};
+
+struct A5GPUClientQueryResult {
+    A5GPUClientHeader header;
+    uint32_t maxResources;
+    uint32_t supportedOperations; /* bit 0: import, bit 1: release */
+    uint32_t gpuCommandsSupported; /* always zero in version 1 */
+    uint32_t reserved;
+};
+
+struct A5GPUClientImportRequest {
+    A5GPUClientHeader header;
+    uint32_t surfacePort; /* Mach send right in the opening task */
+    uint32_t usage;       /* kA5GPUClientRead only */
+    uint64_t reserved;
+};
+
+struct A5GPUClientImportResult {
+    A5GPUClientHeader header;
+    uint64_t handle;      /* generation in high 32 bits, slot+1 in low */
+    uint32_t width;
+    uint32_t height;
+    uint32_t bytesPerRow;
+    uint32_t pixelFormat;
+};
+
+struct A5GPUClientReleaseRequest {
+    A5GPUClientHeader header;
+    uint64_t handle;
+};
+
+#endif /* A5XELTE_GPU_USER_CLIENT_H */
diff --git a/iokit/Kernel/arm/A5XELTEGPUUserClient.cpp b/iokit/Kernel/arm/A5XELTEGPUUserClient.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/A5XELTEGPUUserClient.cpp
@@ -0,0 +1,260 @@
+/*
+ * Opt-in, private resource bookkeeping for a future Mali-compatible iOS
+ * backend. This client has no job submission or GPU address-space access.
+ * AGXMetalA11 and the stock iOS Metal stack cannot use this protocol.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+#include "A5XELTEGPUUserClient.h"
+#include "A5XELTEGPUResources.h"
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <libkern/c++/OSBoolean.h>
+
+static_assert(sizeof(A5GPUClientHeader) == 16 &&
+    sizeof(A5GPUClientImportRequest) == 32 &&
+    sizeof(A5GPUClientImportResult) == 40 &&
+    sizeof(A5GPUClientReleaseRequest) == 24,
+    "A5XELTE GPU resource protocol layout changed");
+
+class A5XELTEGPUUserClient : public IOUserClient {
+    OSDeclareDefaultStructors(A5XELTEGPUUserClient);
+
+    struct ResourceSlot {
+        A5G3DImportedSurface surface;
+        uint32_t generation;
+    };
+
+    task_t fTask = TASK_NULL;
+    IOLock *fLock = nullptr;
+    ResourceSlot fSlots[kA5GPUClientMaxResources] = {};
+    bool fClosed = false;
+
+    void releaseAll();
+    IOReturn query(IOExternalMethodArguments *args);
+    IOReturn importSurface(IOExternalMethodArguments *args);
+    IOReturn releaseSurface(IOExternalMethodArguments *args);
+
+public:
+    bool initWithTask(task_t owningTask, void *securityID, UInt32 type)
+        APPLE_KEXT_OVERRIDE;
+    void free() APPLE_KEXT_OVERRIDE;
+    IOReturn clientClose() APPLE_KEXT_OVERRIDE;
+    IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+        IOExternalMethodDispatch *dispatch, OSObject *target,
+        void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(A5XELTEGPUUserClient, IOUserClient);
+
+static bool
+a5gpu_valid_header(const A5GPUClientHeader *header, uint32_t size)
+{
+    return header && header->version == kA5GPUClientVersion &&
+        header->size == size && header->reserved0 == 0 &&
+        header->reserved1 == 0;
+}
+
+static bool
+a5gpu_valid_input(IOExternalMethodArguments *args, uint32_t size)
+{
+    return args && args->scalarInputCount == 0 &&
+        args->scalarOutputCount == 0 &&
+        args->structureInputDescriptor == nullptr &&
+        args->structureOutputDescriptor == nullptr &&
+        args->structureInput != nullptr &&
+        args->structureInputSize == size;
+}
+
+bool
+A5XELTEGPUUserClient::initWithTask(task_t owningTask, void *securityID,
+    UInt32 type)
+{
+    if (type != 0 || owningTask == TASK_NULL ||
+        !IOUserClient::initWithTask(owningTask, securityID, type))
+        return false;
+
+    /* Even an opt-in service should not allow arbitrary processes to pin
+     * IOSurface resources. A future backend needs this explicit entitlement.
+     */
+    OSObject *entitlement = copyClientEntitlement(owningTask,
+        "com.orhunnx.a5xelte.gpu-resource-client");
+    const bool allowed = entitlement == kOSBooleanTrue;
+    if (entitlement)
+        entitlement->release();
+    if (!allowed)
+        return false;
+
+    fTask = owningTask;
+    fLock = IOLockAlloc();
+    if (!fLock)
+        return false;
+    for (uint32_t i = 0; i < kA5GPUClientMaxResources; ++i)
+        fSlots[i].generation = 1;
+    return true;
+}
+
+void
+A5XELTEGPUUserClient::releaseAll()
+{
+    if (!fLock)
+        return;
+    A5G3DImportedSurface retained[kA5GPUClientMaxResources] = {};
+    IOLockLock(fLock);
+    fClosed = true;
+    for (uint32_t i = 0; i < kA5GPUClientMaxResources; ++i) {
+        retained[i] = fSlots[i].surface;
+        bzero(&fSlots[i].surface, sizeof(fSlots[i].surface));
+        if (++fSlots[i].generation == 0)
+            fSlots[i].generation = 1;
+    }
+    IOLockUnlock(fLock);
+    for (uint32_t i = 0; i < kA5GPUClientMaxResources; ++i)
+        a5g3d_resource_release(&retained[i]);
+}
+
+void
+A5XELTEGPUUserClient::free()
+{
+    releaseAll();
+    if (fLock) {
+        IOLockFree(fLock);
+        fLock = nullptr;
+    }
+    IOUserClient::free();
+}
+
+IOReturn
+A5XELTEGPUUserClient::clientClose()
+{
+    releaseAll();
+    terminate();
+    return kIOReturnSuccess;
+}
+
+IOReturn
+A5XELTEGPUUserClient::query(IOExternalMethodArguments *args)
+{
+    if (!a5gpu_valid_input(args, sizeof(A5GPUClientHeader)) ||
+        args->structureOutput == nullptr ||
+        args->structureOutputSize < sizeof(A5GPUClientQueryResult))
+        return kIOReturnBadArgument;
+    A5GPUClientHeader input = {};
+    memcpy(&input, args->structureInput, sizeof(input));
+    if (!a5gpu_valid_header(&input, sizeof(input)))
+        return kIOReturnUnsupported;
+    A5GPUClientQueryResult result = {};
+    result.header.version = kA5GPUClientVersion;
+    result.header.size = sizeof(result);
+    result.maxResources = kA5GPUClientMaxResources;
+    result.supportedOperations = 3; /* import and release */
+    result.gpuCommandsSupported = 0;
+    memcpy(args->structureOutput, &result, sizeof(result));
+    args->structureOutputSize = sizeof(result);
+    return kIOReturnSuccess;
+}
+
+IOReturn
+A5XELTEGPUUserClient::importSurface(IOExternalMethodArguments *args)
+{
+    if (!a5gpu_valid_input(args, sizeof(A5GPUClientImportRequest)) ||
+        args->structureOutput == nullptr ||
+        args->structureOutputSize < sizeof(A5GPUClientImportResult))
+        return kIOReturnBadArgument;
+    A5GPUClientImportRequest request = {};
+    memcpy(&request, args->structureInput, sizeof(request));
+    if (!a5gpu_valid_header(&request.header, sizeof(request)))
+        return kIOReturnUnsupported;
+    if (request.surfacePort == 0 || request.usage != kA5GPUClientRead ||
+        request.reserved != 0)
+        return kIOReturnBadArgument;
+
+    A5G3DImportedSurface imported = {};
+    if (a5g3d_resource_import_port(fTask, request.surfacePort, &imported) !=
+        kA5G3DResourceReady)
+        return kIOReturnBadArgument;
+
+    uint64_t handle = 0;
+    IOLockLock(fLock);
+    if (!fClosed) {
+        for (uint32_t i = 0; i < kA5GPUClientMaxResources; ++i) {
+            if (fSlots[i].surface.surface == nullptr) {
+                fSlots[i].surface = imported;
+                handle = (static_cast<uint64_t>(fSlots[i].generation) << 32) |
+                    (i + 1);
+                break;
+            }
+        }
+    }
+    IOLockUnlock(fLock);
+    if (!handle) {
+        a5g3d_resource_release(&imported);
+        return kIOReturnNoResources;
+    }
+
+    A5GPUClientImportResult result = {};
+    result.header.version = kA5GPUClientVersion;
+    result.header.size = sizeof(result);
+    result.handle = handle;
+    result.width = imported.width;
+    result.height = imported.height;
+    result.bytesPerRow = imported.bytesPerRow;
+    result.pixelFormat = 0x42475241; /* BGRA */
+    memcpy(args->structureOutput, &result, sizeof(result));
+    args->structureOutputSize = sizeof(result);
+    return kIOReturnSuccess;
+}
+
+IOReturn
+A5XELTEGPUUserClient::releaseSurface(IOExternalMethodArguments *args)
+{
+    if (!a5gpu_valid_input(args, sizeof(A5GPUClientReleaseRequest)) ||
+        args->structureOutputSize != 0)
+        return kIOReturnBadArgument;
+    A5GPUClientReleaseRequest request = {};
+    memcpy(&request, args->structureInput, sizeof(request));
+    if (!a5gpu_valid_header(&request.header, sizeof(request)))
+        return kIOReturnUnsupported;
+    const uint32_t slot = static_cast<uint32_t>(request.handle);
+    const uint32_t generation = static_cast<uint32_t>(request.handle >> 32);
+    if (slot == 0 || slot > kA5GPUClientMaxResources || generation == 0)
+        return kIOReturnBadArgument;
+
+    A5G3DImportedSurface retained = {};
+    IOLockLock(fLock);
+    ResourceSlot &entry = fSlots[slot - 1];
+    if (!fClosed && entry.generation == generation &&
+        entry.surface.surface != nullptr) {
+        retained = entry.surface;
+        bzero(&entry.surface, sizeof(entry.surface));
+        if (++entry.generation == 0)
+            entry.generation = 1;
+    }
+    IOLockUnlock(fLock);
+    if (!retained.surface)
+        return kIOReturnNotFound;
+    a5g3d_resource_release(&retained);
+    return kIOReturnSuccess;
+}
+
+IOReturn
+A5XELTEGPUUserClient::externalMethod(uint32_t selector,
+    IOExternalMethodArguments *args, __unused IOExternalMethodDispatch *dispatch,
+    __unused OSObject *target, __unused void *reference)
+{
+    if (!fLock)
+        return kIOReturnNotReady;
+    switch (selector) {
+    case kA5GPUClientQuery:
+        return query(args);
+    case kA5GPUClientImportSurface:
+        return importSurface(args);
+    case kA5GPUClientReleaseSurface:
+        return releaseSurface(args);
+    default:
+        return kIOReturnUnsupported;
+    }
+}
+#endif /* ARM64_BOARD_CONFIG_A5XELTE */
