diff --git a/iokit/Kernel/arm/A5XELTEGPUAS1.cpp b/iokit/Kernel/arm/A5XELTEGPUAS1.cpp
new file mode 100644
index 0000000..bc8f059
--- /dev/null
+++ b/iokit/Kernel/arm/A5XELTEGPUAS1.cpp
@@ -0,0 +1,349 @@
+/*
+ * Opt-in Mali-T720 AS1 mapper. This is a prerequisite for a typed renderer,
+ * not a GPU command interface. Userland never supplies page tables, physical
+ * addresses, descriptors or GPU virtual addresses.
+ */
+#include "A5XELTEGPUAS1.h"
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+#include "A5XELTEGPUQueue.h"
+#include "SweetSurface.h"
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+
+enum {
+    kAS1Page = 4096,
+    kAS1Slots = 4,
+    kAS1PagesPerSlot = 2048,
+    kAS1TablesPerSlot = 4,
+    kAS1TablePages = 3 + kAS1Slots * kAS1TablesPerSlot,
+    kAS1TableBytes = kAS1TablePages * kAS1Page,
+    kAS1Base = 0x10000000,
+    kAS1Window = 0x800000,
+    kAS1BGRA = 0x42475241,
+};
+static const uint64_t kAS1PageDescriptor = 0x2c1ULL;
+static_assert(kAS1TableBytes == 0x13000 &&
+    kAS1Slots * kAS1Window == 0x2000000, "AS1 bounds");
+
+struct A5G3DAS1Context {
+    IOBufferMemoryDescriptor *tables;
+    SweetSurface *surface[kAS1Slots];
+    uint32_t mappedBytes[kAS1Slots];
+    bool installed;
+    bool poisoned;
+};
+
+/* AS1 is a single hardware slot; only one client can hold it. Keep a poisoned
+ * context as the owner until reboot, including all pages the GPU may access.
+ */
+static IOLock *gAS1Lock = nullptr;
+static A5G3DAS1Context *gAS1Owner = nullptr;
+
+static IOLock *
+a5g3d_as1_lock()
+{
+    IOLock *lock = gAS1Lock;
+    if (lock)
+        return lock;
+    IOLock *fresh = IOLockAlloc();
+    if (!fresh)
+        return nullptr;
+    if (!__sync_bool_compare_and_swap(&gAS1Lock, nullptr, fresh))
+        IOLockFree(fresh);
+    return gAS1Lock;
+}
+
+static uint32_t
+a5g3d_as1_read(vm_offset_t gpu, uint32_t reg)
+{
+    return *reinterpret_cast<volatile uint32_t *>(gpu + reg);
+}
+
+static void
+a5g3d_as1_write(vm_offset_t gpu, uint32_t reg, uint32_t value)
+{
+    *reinterpret_cast<volatile uint32_t *>(gpu + reg) = value;
+}
+
+static bool
+a5g3d_as1_wait(vm_offset_t gpu)
+{
+    for (unsigned i = 0; i < 10000; ++i) {
+        if (!(a5g3d_as1_read(gpu, 0x2468) & 1u))
+            return true;
+        IODelay(10);
+    }
+    return false;
+}
+
+static bool
+a5g3d_as1_surface_valid(SweetSurface *surface, uint32_t *bytes)
+{
+    if (!surface || !bytes || !surface->memory ||
+        surface->pixelFormat != kAS1BGRA || surface->offset != 0 ||
+        surface->planeCount != 0 || surface->bytesPerElement != 4 ||
+        surface->elementWidth != 1 || surface->elementHeight != 1 ||
+        !surface->width || !surface->height ||
+        surface->width > 2048 || surface->height > 2048 ||
+        surface->bytesPerRow < static_cast<uint64_t>(surface->width) * 4 ||
+        surface->bytesPerRow > 8192 ||
+        OSDynamicCast(IOBufferMemoryDescriptor, surface->memory) == nullptr)
+        return false;
+    const uint64_t length = static_cast<uint64_t>(surface->bytesPerRow) *
+        surface->height;
+    if (!length || length > kAS1Window)
+        return false;
+    *bytes = static_cast<uint32_t>((length + 4095) & ~4095ULL);
+    return *bytes && *bytes <= kAS1Window &&
+        *bytes <= surface->allocSize &&
+        *bytes <= surface->memory->getLength();
+}
+
+static bool
+a5g3d_as1_pages_valid(SweetSurface *surface, uint32_t length)
+{
+    /* The retained IOBuffer pins all pages. Validate before changing PTEs. */
+    for (uint32_t offset = 0; offset < length; offset += kAS1Page) {
+        IOByteCount span = 0;
+        const uint64_t physical = surface->memory->getPhysicalSegment(
+            offset, &span, kIOMemoryMapperNone);
+        if (!physical || (physical & 4095) || span < kAS1Page ||
+            physical > 0xffffefffULL ||
+            (physical >= 0x67000000ULL && physical < 0x67800000ULL))
+            return false;
+    }
+    return true;
+}
+
+static bool
+a5g3d_as1_tables_init(A5G3DAS1Context *ctx)
+{
+    uint8_t *bytes = static_cast<uint8_t *>(ctx->tables->getBytesNoCopy());
+    IOByteCount span = 0;
+    const uint64_t physical = ctx->tables->getPhysicalSegment(0, &span,
+        kIOMemoryMapperNone);
+    if (!bytes || !physical || (physical & 4095) ||
+        span < kAS1TableBytes || physical > 0xfffecfffULL)
+        return false;
+    bzero(bytes, kAS1TableBytes);
+    uint64_t *l0 = reinterpret_cast<uint64_t *>(bytes);
+    uint64_t *l1 = reinterpret_cast<uint64_t *>(bytes + kAS1Page);
+    uint64_t *l2 = reinterpret_cast<uint64_t *>(bytes + 2 * kAS1Page);
+    l0[0] = (physical + kAS1Page) | 3u;
+    l1[0] = (physical + 2 * kAS1Page) | 3u;
+    for (uint32_t slot = 0; slot < kAS1Slots; ++slot) {
+        for (uint32_t table = 0; table < kAS1TablesPerSlot; ++table) {
+            const uint32_t index = (kAS1Base >> 21) +
+                slot * kAS1TablesPerSlot + table;
+            l2[index] = (physical + (3 + slot * kAS1TablesPerSlot +
+                table) * kAS1Page) | 3u;
+        }
+    }
+    return ctx->tables->performOperation(kIOMemoryIncoherentIOStore,
+        0, kAS1TableBytes) == kIOReturnSuccess;
+}
+
+enum A5G3DAS1Update {
+    kAS1UpdateApplied,
+    kAS1UpdateBusy,
+    kAS1UpdateUncertain,
+};
+
+static A5G3DAS1Update
+a5g3d_as1_update(A5G3DAS1Context *ctx, bool disable)
+{
+    IOService *owner = nullptr;
+    IOBufferMemoryDescriptor *as0 = nullptr;
+    vm_offset_t gpu = 0;
+    uint64_t token = 0;
+    if (!a5g3d_queue_acquire_runtime(&owner, &token, &as0, &gpu))
+        return kAS1UpdateBusy; /* no MMIO or live PTE flush attempted */
+    bool ok = false;
+    do {
+        if (!(a5g3d_as1_read(gpu, 0x018) & 2u) ||
+            !a5g3d_as1_wait(gpu) ||
+            a5g3d_as1_read(gpu, 0x245c) ||
+            (a5g3d_as1_read(gpu, 0x200c) & 0x00020002u))
+            break;
+        IOByteCount span = 0;
+        const uint64_t physical = ctx->tables->getPhysicalSegment(0,
+            &span, kIOMemoryMapperNone);
+        if (!physical || (physical & 4095) || span < kAS1TableBytes)
+            break;
+        if (ctx->tables->performOperation(kIOMemoryIncoherentIOStore,
+            0, kAS1TableBytes) != kIOReturnSuccess)
+            break;
+        __sync_synchronize();
+        const uint64_t transtab = disable ? 0 : (physical | 7u);
+        a5g3d_as1_write(gpu, 0x2440, static_cast<uint32_t>(transtab));
+        a5g3d_as1_write(gpu, 0x2444, static_cast<uint32_t>(transtab >> 32));
+        a5g3d_as1_write(gpu, 0x2448, disable ? 0 : 0x888d88);
+        a5g3d_as1_write(gpu, 0x244c, 0);
+        a5g3d_as1_write(gpu, 0x2458, 1u); /* AS1 UPDATE */
+        if (!a5g3d_as1_wait(gpu))
+            break;
+        if (!disable) {
+            /* Panfrost lock_region: 0x10000000..0x11ffffff, 32 MiB. */
+            a5g3d_as1_write(gpu, 0x2450, kAS1Base | 24u);
+            a5g3d_as1_write(gpu, 0x2454, 0);
+            a5g3d_as1_write(gpu, 0x2458, 2u); /* LOCK */
+            if (!a5g3d_as1_wait(gpu))
+                break;
+            a5g3d_as1_write(gpu, 0x2458, 4u); /* FLUSH_PT */
+            if (!a5g3d_as1_wait(gpu))
+                break;
+        }
+        ok = !a5g3d_as1_read(gpu, 0x245c) &&
+            !(a5g3d_as1_read(gpu, 0x200c) & 0x00020002u);
+    } while (false);
+    /* A failed MMU update may leave AS1 reading the old or new page table.
+     * A5XELTEGPU.cpp still owns AS0; never poison that independent queue.
+     */
+    a5g3d_queue_release(owner, token);
+    owner->release();
+    return ok ? kAS1UpdateApplied : kAS1UpdateUncertain;
+}
+
+A5G3DAS1Context *
+a5g3d_as1_create()
+{
+    IOLock *lock = a5g3d_as1_lock();
+    if (!lock)
+        return nullptr;
+    A5G3DAS1Context *ctx = IONewZero(A5G3DAS1Context, 1);
+    if (!ctx)
+        return nullptr;
+    ctx->tables = IOBufferMemoryDescriptor::withOptions(
+        kIODirectionInOut | kIOMemoryPhysicallyContiguous,
+        kAS1TableBytes, kAS1Page);
+    if (!ctx->tables || !a5g3d_as1_tables_init(ctx)) {
+        if (ctx->tables)
+            ctx->tables->release();
+        IODelete(ctx, A5G3DAS1Context, 1);
+        return nullptr;
+    }
+    IOLockLock(lock);
+    if (gAS1Owner) {
+        IOLockUnlock(lock);
+        ctx->tables->release();
+        IODelete(ctx, A5G3DAS1Context, 1);
+        return nullptr;
+    }
+    gAS1Owner = ctx;
+    IOLockUnlock(lock);
+    return ctx;
+}
+
+bool
+a5g3d_as1_map(A5G3DAS1Context *ctx, uint32_t slot, SweetSurface *surface,
+    uint32_t *mappedBytes)
+{
+    if (!ctx || slot >= kAS1Slots || !mappedBytes)
+        return false;
+    uint32_t length = 0;
+    if (!a5g3d_as1_surface_valid(surface, &length) ||
+        !a5g3d_as1_pages_valid(surface, length))
+        return false;
+    IOLock *lock = a5g3d_as1_lock();
+    IOLockLock(lock);
+    if (gAS1Owner != ctx || ctx->poisoned || ctx->surface[slot]) {
+        IOLockUnlock(lock);
+        return false;
+    }
+    surface->retain();
+    uint64_t *l3 = reinterpret_cast<uint64_t *>(
+        static_cast<uint8_t *>(ctx->tables->getBytesNoCopy()) +
+        (3 + slot * kAS1TablesPerSlot) * kAS1Page);
+    for (uint32_t page = 0; page < length / kAS1Page; ++page) {
+        IOByteCount span = 0;
+        const uint64_t physical = surface->memory->getPhysicalSegment(
+            page * kAS1Page, &span, kIOMemoryMapperNone);
+        l3[page] = physical | kAS1PageDescriptor;
+    }
+    ctx->surface[slot] = surface;
+    ctx->mappedBytes[slot] = length;
+    const A5G3DAS1Update update = a5g3d_as1_update(ctx, false);
+    if (update == kAS1UpdateBusy) {
+        bzero(l3, kAS1TablesPerSlot * kAS1Page);
+        ctx->surface[slot] = nullptr;
+        ctx->mappedBytes[slot] = 0;
+        surface->release();
+    } else if (update != kAS1UpdateApplied)
+        ctx->poisoned = true; /* retain backing and source until reboot */
+    else {
+        ctx->installed = true;
+        *mappedBytes = length;
+    }
+    IOLockUnlock(lock);
+    return update == kAS1UpdateApplied;
+}
+
+bool
+a5g3d_as1_unmap(A5G3DAS1Context *ctx, uint32_t slot)
+{
+    if (!ctx || slot >= kAS1Slots)
+        return false;
+    IOLock *lock = a5g3d_as1_lock();
+    IOLockLock(lock);
+    if (gAS1Owner != ctx || ctx->poisoned || !ctx->surface[slot]) {
+        IOLockUnlock(lock);
+        return false;
+    }
+    uint8_t *l3 = static_cast<uint8_t *>(ctx->tables->getBytesNoCopy()) +
+        (3 + slot * kAS1TablesPerSlot) * kAS1Page;
+    bzero(l3, kAS1TablesPerSlot * kAS1Page);
+    const A5G3DAS1Update update = a5g3d_as1_update(ctx, false);
+    if (update == kAS1UpdateBusy) {
+        SweetSurface *surface = ctx->surface[slot];
+        const uint32_t pages = ctx->mappedBytes[slot] / kAS1Page;
+        uint64_t *restore = reinterpret_cast<uint64_t *>(l3);
+        for (uint32_t page = 0; page < pages; ++page) {
+            IOByteCount span = 0;
+            restore[page] = surface->memory->getPhysicalSegment(
+                page * kAS1Page, &span, kIOMemoryMapperNone) |
+                kAS1PageDescriptor;
+        }
+    } else if (update != kAS1UpdateApplied)
+        ctx->poisoned = true;
+    else {
+        ctx->surface[slot]->release();
+        ctx->surface[slot] = nullptr;
+        ctx->mappedBytes[slot] = 0;
+    }
+    IOLockUnlock(lock);
+    return update == kAS1UpdateApplied;
+}
+
+void
+a5g3d_as1_destroy(A5G3DAS1Context *ctx)
+{
+    if (!ctx)
+        return;
+    IOLock *lock = a5g3d_as1_lock();
+    IOLockLock(lock);
+    if (gAS1Owner != ctx) {
+        IOLockUnlock(lock);
+        return;
+    }
+    /* No selector can submit AS1 work. A future renderer must add fence
+     * retirement before this path may release any retained resource.
+     */
+    if (!ctx->poisoned && ctx->installed) {
+        if (a5g3d_as1_update(ctx, true) != kAS1UpdateApplied)
+            ctx->poisoned = true;
+    }
+    if (ctx->poisoned) {
+        IOLockUnlock(lock);
+        IOLog("A5XELTE G3D: AS1 update uncertain; resources pinned until reboot\n");
+        return;
+    }
+    gAS1Owner = nullptr;
+    for (uint32_t i = 0; i < kAS1Slots; ++i)
+        if (ctx->surface[i])
+            ctx->surface[i]->release();
+    ctx->tables->release();
+    IODelete(ctx, A5G3DAS1Context, 1);
+    IOLockUnlock(lock);
+}
+#endif
diff --git a/iokit/Kernel/arm/A5XELTEGPUAS1.h b/iokit/Kernel/arm/A5XELTEGPUAS1.h
new file mode 100644
index 0000000..7980a11
--- /dev/null
+++ b/iokit/Kernel/arm/A5XELTEGPUAS1.h
@@ -0,0 +1,19 @@
+/* Private per-client Mali AS1 resource mappings. No job submission. */
+#ifndef A5XELTE_GPU_AS1_H
+#define A5XELTE_GPU_AS1_H
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+#include <stdint.h>
+class SweetSurface;
+struct A5G3DAS1Context;
+
+/* Only one user client can own hardware AS1 at a time. Returned mappings
+ * are private to that client and have fixed, kernel-selected GPU VAs. */
+A5G3DAS1Context *a5g3d_as1_create();
+bool a5g3d_as1_map(A5G3DAS1Context *, uint32_t slot, SweetSurface *,
+    uint32_t *mappedBytes);
+bool a5g3d_as1_unmap(A5G3DAS1Context *, uint32_t slot);
+/* On an ambiguous MMU update, keep the context and all surfaces pinned. */
+void a5g3d_as1_destroy(A5G3DAS1Context *);
+#endif
+#endif
