 IOReturn
 A5XELTEGPUUserClient::sampleTile(IOExternalMethodArguments *args)
 {
@@ -333,6 +425,10 @@ A5XELTEGPUUserClient::externalMethod(uint32_t selector,
         return releaseSurface(args);
     case kA5GPUClientSampleTile:
         return sampleTile(args);
+    case kA5GPUClientMapSurface:
+        return mapSurface(args);
+    case kA5GPUClientUnmapSurface:
