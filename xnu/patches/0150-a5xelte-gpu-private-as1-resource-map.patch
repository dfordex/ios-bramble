+IOReturn
+A5XELTEGPUUserClient::mapSurface(IOExternalMethodArguments *args)
+{
+    if (!a5gpu_valid_input(args, sizeof(A5GPUClientMapRequest)) ||
+        !args->structureOutput ||
+        args->structureOutputSize < sizeof(A5GPUClientMapResult))
+        return kIOReturnBadArgument;
+    A5GPUClientMapRequest request = {};
+    memcpy(&request, args->structureInput, sizeof(request));
+    if (!a5gpu_valid_header(&request.header, sizeof(request)))
+        return kIOReturnUnsupported;
+    const uint32_t slot = static_cast<uint32_t>(request.handle);
+    const uint32_t generation = static_cast<uint32_t>(request.handle >> 32);
+    /* AS1 deliberately has four fixed 8-MiB windows. No caller-selected VA. */
+    if (!slot || slot > 4 || !generation)
+        return kIOReturnBadArgument;
+    uint32_t mappedBytes = 0;
+    IOLockLock(fLock);
+    ResourceSlot &entry = fSlots[slot - 1];
+    if (fClosed || entry.generation != generation ||
+        !entry.surface.surface || entry.mapped) {
+        IOLockUnlock(fLock);
+        return kIOReturnNotFound;
+    }
+    if (!fAS1)
+        fAS1 = a5g3d_as1_create();
+    const bool ok = fAS1 && a5g3d_as1_map(fAS1, slot - 1,
+        entry.surface.surface, &mappedBytes);
+    if (ok)
+        entry.mapped = true;
+    IOLockUnlock(fLock);
+    if (!ok)
+        return kIOReturnNoResources;
+    A5GPUClientMapResult result = {};
+    result.header.version = kA5GPUClientVersion;
+    result.header.size = sizeof(result);
+    result.mappingToken = request.handle;
+    result.mappedBytes = mappedBytes;
+    result.flags = 1; /* BGRA8 read resource, no submit yet */
+    memcpy(args->structureOutput, &result, sizeof(result));
+    args->structureOutputSize = sizeof(result);
+    return kIOReturnSuccess;
+}
+
+IOReturn
+A5XELTEGPUUserClient::unmapSurface(IOExternalMethodArguments *args)
+{
+    if (!a5gpu_valid_input(args, sizeof(A5GPUClientUnmapRequest)) ||
+        args->structureOutputSize != 0)
+        return kIOReturnBadArgument;
+    A5GPUClientUnmapRequest request = {};
+    memcpy(&request, args->structureInput, sizeof(request));
+    if (!a5gpu_valid_header(&request.header, sizeof(request)))
+        return kIOReturnUnsupported;
+    const uint32_t slot = static_cast<uint32_t>(request.mappingToken);
+    const uint32_t generation =
+        static_cast<uint32_t>(request.mappingToken >> 32);
+    if (!slot || slot > 4 || !generation)
+        return kIOReturnBadArgument;
+    IOLockLock(fLock);
+    ResourceSlot &entry = fSlots[slot - 1];
+    if (fClosed || entry.generation != generation || !entry.mapped ||
+        !fAS1) {
+        IOLockUnlock(fLock);
+        return kIOReturnNotFound;
+    }
+    const bool ok = a5g3d_as1_unmap(fAS1, slot - 1);
+    if (ok)
+        entry.mapped = false;
+    IOLockUnlock(fLock);
+    return ok ? kIOReturnSuccess : kIOReturnError;
+}
