 IOReturn
+A5XELTEGPUUserClient::sampleTile(IOExternalMethodArguments *args)
+{
+    if (!a5gpu_valid_input(args, sizeof(A5GPUClientSampleRequest)) ||
+        args->structureOutput == nullptr ||
+        args->structureOutputSize < sizeof(A5GPUClientSampleResult))
+        return kIOReturnBadArgument;
+    A5GPUClientSampleRequest request = {};
+    memcpy(&request, args->structureInput, sizeof(request));
+    if (!a5gpu_valid_header(&request.header, sizeof(request)))
+        return kIOReturnUnsupported;
+    const uint32_t slot = static_cast<uint32_t>(request.handle);
+    const uint32_t generation = static_cast<uint32_t>(request.handle >> 32);
+    if (slot == 0 || slot > kA5GPUClientMaxResources || generation == 0)
+        return kIOReturnBadArgument;
+
+    /* Retain the imported source while the finite synchronous GPU fixture
+     * runs. Do not hold the user-client lock over queue polling. A release or
+     * close may happen concurrently without freeing this source underneath
+     * the submission. The transfer snapshots pixels before either job.
+     */
+    A5G3DImportedSurface source = {};
+    IOLockLock(fLock);
+    ResourceSlot &entry = fSlots[slot - 1];
+    if (!fClosed && entry.generation == generation &&
+        entry.surface.surface != nullptr) {
+        source = entry.surface;
+        source.surface->retain();
+    }
+    IOLockUnlock(fLock);
+    if (!source.surface)
+        return kIOReturnNotFound;
+
+    A5GPUClientSampleResult result = {};
+    result.header.version = kA5GPUClientVersion;
+    result.header.size = sizeof(result);
+    A5G3DTransferResult completed = {};
+    const A5G3DTransferStatus status = a5g3d_transfer_sample_bgra16(
+        &source, request.x, request.y, result.pixels, &completed);
+    a5g3d_resource_release(&source);
+    result.status = a5gpu_sample_status(status);
+    result.tilerFence = completed.tilerFence;
+    result.fragmentFence = completed.fragmentFence;
+    if (status == kA5G3DTransferCompleted) {
+        result.matchingPixels = completed.matchingPixels;
+    } else {
+        /* A partial or mismatched output must never look like valid pixels.
+         * Fence fields still report jobs known to have completed.
+         */
+        bzero(result.pixels, sizeof(result.pixels));
+    }
+    memcpy(args->structureOutput, &result, sizeof(result));
+    args->structureOutputSize = sizeof(result);
+    return kIOReturnSuccess;
+}
