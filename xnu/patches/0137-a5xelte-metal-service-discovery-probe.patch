+#if defined(SWEET)
+static bool
+a5metal_contains(const char *name, const char *needle)
+{
+	const size_t length = strlen(needle);
+	for (const char *at = name; *at != '\0'; at++) {
+		if (strncmp(at, needle, length) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static const char *
+a5metal_match_name(OSDictionary *matching)
+{
+	const OSSymbol *keys[] = { gIONameMatchKey, gIOProviderClassKey, gIOClassKey };
+	for (unsigned i = 0; i < sizeof(keys) / sizeof(keys[0]); i++) {
+		const OSString *value = OSDynamicCast(OSString, matching->getObject(keys[i]));
+		if (value == NULL) {
+			continue;
+		}
+		const char *name = value->getCStringNoCopy();
+		if (name != NULL && (a5metal_contains(name, "IOGPU") ||
+		    a5metal_contains(name, "IOAccelerator") ||
+		    a5metal_contains(name, "AGX"))) {
+			return name;
+		}
+	}
+	return NULL;
+}
+#endif
