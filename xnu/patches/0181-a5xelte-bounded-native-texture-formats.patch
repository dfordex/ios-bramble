+/* Exact linear element identities. R16U/B5A1 are explicit private codes;
+ * never reinterpret integer R16 as CV's L016 normalized16 format. This only
+ * permits resource import/mapping, not a new shader/typed-render operation. */
+static inline uint32_t a5g3d_resource_format_bytes(uint32_t code)
+{
+    switch (code) {
+    case 0x42475241: return 4; /* BGRA8Unorm */
+    case 0x52476841: return 8; /* RGBA16Float */
+    case 0x4c303038: return 1; /* R8Unorm */
+    case 0x32433038: return 2; /* RG8Unorm */
+    case 0x4c303066: return 4; /* R32Float */
+    case 0x52313655: return 2; /* R16Uint, private R16U */
+    case 0x4c303068: return 2; /* R16Float, CV L00h */
+    case 0x42354131: return 2; /* BGR5A1Unorm, private B5A1 */
+    case 0x32433066: return 8; /* RG32Float, CV 2C0f */
+    default: return 0;
+    }
+}
+static inline bool a5g3d_resource_linear_layout(uint32_t code,uint32_t bpe,
+    uint32_t width,uint32_t height,uint32_t row,uint32_t offset,uint64_t alloc)
+{
+    const uint32_t expected=a5g3d_resource_format_bytes(code);
+    if (!expected || expected!=bpe || !width || !height || width>4096 ||
+        height>4096 || row>32768 || row<uint64_t(width)*bpe ||
+        !alloc || alloc>0x2000000ULL) return false;
+    const uint64_t end=uint64_t(offset)+uint64_t(row)*height;
+    return end<=alloc && end<=0x2000000ULL;
+}
