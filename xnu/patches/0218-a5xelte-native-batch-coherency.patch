+/* Same immutable resource bindings for at most four snapshots. Host aliases
+ * are cleaned once, GPU jobs run in order, and CPU aliases reconcile at end. */
+void a5g3d_as1_submit_native_batch(A5G3DAS1Context*ctx,const uint8_t*items,
+ const A5NativePhysicalUse*uses,unsigned count,uint32_t reads,uint32_t writes,uint32_t buffers,A5NativeBatchResult*out){
+ IOLock*lock=a5g3d_as1_lock();IOLockLock(lock);
+ out->count=count;out->completedCount=0;out->status=kAS1SubmitInvalid;
+ if(!ctx||gAS1Owner!=ctx||ctx->poisoned||!ctx->installed||!count||count>A5NativeBatchMax){IOLockUnlock(lock);return;}
+ uint32_t doneWrites=0;
+ for(unsigned i=0;i<count;i++){
+  A5NativeSubmitRequest r;memcpy(&r,items+i*(sizeof(r)+A5NativeJobBytes),sizeof(r));
+  const uint32_t itemReads=uses[i].reads,itemWrites=uses[i].writes,itemBuffers=uses[i].buffers;
+  A5G3DAS1Completion completion={};
+  A5G3DAS1SubmitStatus status=a5g3d_as1_submit_native_locked(ctx,r,
+   items+i*(sizeof(r)+A5NativeJobBytes)+sizeof(r),itemReads,itemWrites,itemBuffers,&completion,
+   i?0:(reads|writes),i?0:buffers,false);
+  out->items[i].header={1,sizeof(A5NativeSubmitResult),0,0};out->items[i].status=status;
+  out->items[i].tilerFence=completion.tilerFence;out->items[i].fragmentFence=completion.fragmentFence;
+  out->status=status;if(status!=kAS1SubmitCompleted)break;
+  doneWrites|=itemWrites;++out->completedCount;
+ }
+ if(out->status==kAS1SubmitCompleted||out->status==kAS1SubmitInvalid||out->status==kAS1SubmitBusy){
+  for(unsigned i=0;i<4;i++)if(doneWrites&(1u<<i)){
+   if(ctx->surface[i]->memory->performOperation(kIOMemoryIncoherentIOFlush,0,ctx->mappedBytes[i])!=kIOReturnSuccess){
+    ctx->poisoned=true;out->status=kAS1SubmitIOError;
+    /* Last completed fence remains real, but the batch cannot be advertised CPU coherent. */
+    if(out->completedCount==count)--out->completedCount;
+   }
+  }
+ }
+ static unsigned reports=0;if(++reports<=8||!(reports&63)||out->status)IOLog(
+  "A5XELTE G3D batch: groups=%u count=%u completed=%u status=%u coherency_scope=batch\n",
+  reports,count,out->completedCount,out->status);
+ IOLockUnlock(lock);
+}
