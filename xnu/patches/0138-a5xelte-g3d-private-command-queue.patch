diff --git a/iokit/Kernel/arm/A5XELTEGPUQueue.h b/iokit/Kernel/arm/A5XELTEGPUQueue.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/A5XELTEGPUQueue.h
@@ -0,0 +1,57 @@
+#ifndef A5XELTE_GPU_QUEUE_H
+#define A5XELTE_GPU_QUEUE_H
+
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOService.h>
+
+/* Kernel-private, one-job queue. GPU-visible descriptors and pixels must
+ * reside in the driver's pinned 64-KiB backing, within its 16-KiB AS0 window.
+ * This is not the iOS IOGPU/AGX user-client ABI.
+ */
+enum A5G3DQueueStatus {
+    kA5G3DQueueCompleted,
+    kA5G3DQueueBusy,
+    kA5G3DQueueInvalid,
+    kA5G3DQueueTimeout,
+    kA5G3DQueueFault,
+};
+
+struct A5G3DQueueRequest {
+    uint32_t slot;           /* JS0 fragment or JS1 tiler/compute */
+    uint32_t jobOffset;      /* relative to private GPU-visible window */
+    uint32_t shaderMask;
+    uint32_t readbackOffset; /* 0/0 when no CPU readback is needed */
+    uint32_t readbackLength;
+    uint32_t expectedWord;   /* only used with verifyWords */
+    bool verifyWords;
+    uint64_t reservationToken; /* zero only for boot self-tests */
+};
+
+struct A5G3DQueueCompletion {
+    uint64_t fence;
+    uint32_t jobIRQ;
+    uint32_t mmuIRQ;
+    uint32_t gpuIRQ;
+    uint32_t jsState;
+    uint32_t headerStatus;
+    uint32_t matchingWords;
+};
+
+/* Bind only after the caller programs AS0 with this backing's page table.
+ * Do not unbind or free it after a timeout or fault.
+ */
+bool a5g3d_queue_bind(IOService *owner, vm_offset_t gpuMMIO,
+    IOBufferMemoryDescriptor *backing);
+bool a5g3d_queue_unbind(IOService *owner);
+bool a5g3d_queue_acquire(IOService *owner, uint64_t *token,
+    IOBufferMemoryDescriptor **backing, vm_offset_t *gpuMMIO);
+/* For the framebuffer path: returns a retained service owner on success. */
+bool a5g3d_queue_acquire_runtime(IOService **owner, uint64_t *token,
+    IOBufferMemoryDescriptor **backing, vm_offset_t *gpuMMIO);
+bool a5g3d_queue_release(IOService *owner, uint64_t token);
+
+A5G3DQueueStatus a5g3d_queue_submit(IOService *owner, vm_offset_t gpuMMIO,
+    IOBufferMemoryDescriptor *backing, uint8_t *cpuBytes,
+    const A5G3DQueueRequest &request, A5G3DQueueCompletion *completion);
+
+#endif
